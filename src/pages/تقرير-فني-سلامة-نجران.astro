    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?ixlib=rb-4.0.3&auto=format&fit=crop&w=2194&q=80',
      alt: 'مخططات هندسية معتمدة للسلامة في نجران',
    }}
  >
    <Fragment slot="content">نضمن أن تواجدك النظامي في نجران يمثلك ويمثل أمان منشأتك بشكل حقيقي.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'تفاعل وتجاوب سريع مع النظام',
        description:
          'نواكب كافة التحديثات في منصات التراخيص في نجران لتفادي أي تأخير، مما يضمن بقاء منشأتك آمنة وقانونية دائماً.',
      },
      {
        title: 'تطوير وتحديث مستمر',
        description:
          'نتابع التعديلات الدورية في اشتراطات المديرية العامة للدفاع المدني في منطقة نجران لنقدم لك استشارات محدثة دائمًا.',
      },
      {
        title: 'كفاءة عالية في الوقت والموارد',
        description:
          'وفر على نفسك عناء البدء من الصفر أو مراجعة المعاملات المرفوضة في نجران؛ اطلب التقرير من توب سيفتي برو وانطلق فوراً.',
      },
      {
        title: 'دعم هندسي متكامل للعملاء',
        description: `انضم إلى مئات المنشآت في نجران التي وثقت بـ توب سيفتي برو، واستفد من الدعم الفني المتواصل طوال رحلة استخراج رخصتك.`,
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1611462985358-60d3498e0364?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'مهندسو سلامة يتابعون المشاريع في نجران',
    }}
  >
    <Fragment slot="content">مصمم خصيصاً لدعم نمو واستقرار أعمالك التجارية في نجران.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Steps
    title="احصل على تقريرك الفني المعتمد في نجران وافتح منشأتك في أسرع وقت."
    items={[
      {
        title: 'الخطوة 1: <span class="font-medium">إرسال البيانات</span>',
        description:
          'ابدأ فوراً بتزويدنا بنوع النشاط وصور وسائل السلامة المتوفرة لديك في نجران عبر الواتساب أو المنصة. فريقنا جاهز لاستلام طلبك في أي وقت.',
        icon: 'tabler:package',
      },
      {
        title: 'الخطوة 2: <span class="font-medium">التدقيق والمعاينة</span>',
        description:
          'يقوم مهندسونا في نجران بمراجعة البيانات والتأكد من مطابقتها لاشتراطات البلدية والدفاع المدني بدقة متناهية لضمان خلوها من الأخطاء.',
