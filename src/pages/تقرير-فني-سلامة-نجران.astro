    }}
  />

  <Features2
    title="خدمات السلامة في نجران"
    subtitle="نقدم كافة المكونات والتقارير الهندسية اللازمة لتأمين المنشآت في نجران وفق اشتراطات كود الحريق السعودي"
    tagline="خدماتنا في نجران"
    items={[
      {
        title: 'تقرير فني سلامة فوري',
        description: 'إصدار تقرير فني فوري للأنشطة الصغيرة في نجران عبر بوابة سلامة في نفس اليوم.',
        icon: 'flat-color-icons:template',
      },
      {
        title: 'تقرير فني سلامة غير فوري',
        description: 'إصدار تقرير فني غير فوري يتطلب فحصاً ميدانياً وعقد صيانة للمنشآت المتوسطة والكبيرة في نجران.',
        icon: 'flat-color-icons:gallery',
      },
      {
        title: 'شهادة تركيب أدوات الوقاية',
        description: 'إصدار شهادة تركيب أدوات الوقاية والحماية من الحريق في نجران بعد التأكد من جاهزية جميع الأنظمة.',
        icon: 'flat-color-icons:approval',
      },
      {
        title: 'عقود صيانة أنظمة السلامة',
        description: 'توفير عقود صيانة معتمدة لأنظمة السلامة في نجران مع مكتب هندسي معتمد من الدفاع المدني.',
        icon: 'flat-color-icons:document',
      },
      {
        title: 'تجديد رخصة البلدية في نجران',
        description: 'خدمة متكاملة لتجديد رخصة البلدية في نجران مع تجهيز جميع المستندات ومتابعة الطلب حتى الإصدار.',
        icon: 'flat-color-icons:advertising',
      },
      {
        title: 'تجديد ترخيص الدفاع المدني في نجران',
        description: 'تجديد ترخيص الدفاع المدني في نجران بسرعة واحترافية مع فحص جميع معدات السلامة.',
        icon: 'flat-color-icons:currency-exchange',
      },
      {
        title: 'شهادة استيفاء كاميرات المراقبة',
        description: 'إصدار شهادة استيفاء كاميرات المراقبة في نجران حسب متطلبات البلدية للمنشآت التجارية.',
        icon: 'flat-color-icons:voice-presentation',
      },
      {
        title: 'استشارات هندسية وقائية',
        description: 'تقديم استشارات هندسية وقائية للمنشآت في نجران لضمان الامتثال الكامل لاشتراطات السلامة.',
        icon: 'flat-color-icons:business-contact',
      },
      {
        title: 'دعم على مدار الساعة',
        description: 'فريقنا متاح على مدار الساعة لخدمتك في نجران والإجابة على جميع استفساراتك.',
        icon: 'flat-color-icons:database',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
