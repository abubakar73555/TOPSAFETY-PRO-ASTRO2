    stats={[
      { title: 'تقرير فني صادر في نجران', amount: '+650' },
      { title: 'منشأة في نجران تم تأمينها', amount: '+500' },
      { title: 'تقييمات إيجابية في نجران', amount: '100%' },
      { title: 'أحياء نجران المخدومة', amount: '10+' },
    ]}
  />

  <CallToAction
    id="contact"
    actions={[
      {
        variant: 'primary',
        text: 'تواصل معنا عبر الواتساب فوراً في نجران',
        href: 'https://wa.me/966572140531',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
    ]}
  >
    <Fragment slot="title"> احصل على تقريرك الفني في نجران الآن </Fragment>

    <Fragment slot="subtitle">
      لا تؤجل الحصول على تقريرك الفني المعتمد في نجران. <br class="hidden md:inline" />تواصل معنا الآن وسنصدر تقريرك
      الفني بسرعة واحترافية في نجران!
