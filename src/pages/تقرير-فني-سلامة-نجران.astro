    title="فلسفتنا:"
    description="السرعة الفائقة، الالتزام بالمعايير، وتسهيل الإجراءات النظامية لعملائنا في نجران"
  />

  <Features
    id="features"
    tagline="المميزات والخدمات في نجران"
    title="ما ستحصل عليه مع توب سيفتي برو في نجران"
    subtitle="واحدة من أفضل الخدمات الهندسية المتكاملة في نجران لإصدار شهادات وتراخيص السلامة بامتثال كامل لكود البناء."
    items={[
      {
        title: 'خبرة واسعة في سوق نجران',
        description:
          'لدينا خبرة واسعة في سوق نجران ومنطقة نجران، ونفهم تماماً متطلبات البلديات والدفاع المدني في المنطقة.',
        icon: 'tabler:brand-tailwind',
      },
      {
        title: 'تقارير جاهزة للاستخدام',
        description:
          'نماذج وتقارير هندسية معتمدة ومختومة تناسب كافة الأنشطة التجارية في نجران؛ من المحلات البسيطة إلى المجمعات الضخمة.',
        icon: 'tabler:components',
      },
      {
        title: 'معتمدون من الدفاع المدني',
        description: 'نحن مكتب هندسي معتمد من الدفاع المدني، مما يضمن قبول تقاريرك بشكل رسمي وسريع في جميع الجهات.',
        icon: 'tabler:list-check',
      },
      {
        title: 'سرعة في الإنجاز',
        description:
          'نضمن لك إصدار التقرير الفني في نجران في نفس اليوم للتقارير الفورية، وفي أيام معدودة للتقارير غير الفورية.',
        icon: 'tabler:rocket',
      },
      {
        title: 'أسعار تنافسية',
        description: 'نقدم أفضل الأسعار في سوق نجران مع الحفاظ على أعلى مستويات الجودة والاحترافية في إعداد التقارير.',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'تغطية جميع أحياء نجران',
        description: 'نخدم جميع أحياء ومناطق نجران بدون استثناء، بما فيها حي الفيصلية، الخزامى، النزهة، وغيرها.',
        icon: 'tabler:bulb',
      },
    ]}
  />

  <Content
    isReversed
    tagline="داخل الخدمة في نجران"
    title="خدمات السلامة المعتمدة في نجران: دقة الفحص تلتقي مع معايير الدفاع المدني!"
