    isReversed
    tagline="داخل الخدمة في مكة المكرمة"
    title="خطوات إصدار شهادة استيفاء الكاميرات في مكة المكرمة"
    items={[
      {
        title: 'فحص أنظمة المراقبة',
        description:
          'نتحقق من تركيب الكاميرات وعددها وزوايا التصوير ومدة التسجيل حسب اشتراطات الشرطة السعودية في مكة المكرمة.',
      },
      {
        title: 'تجهيز المستندات المطلوبة',
        description: 'نجهز التقارير الفنية وقوائم الكاميرات وعقود الصيانة اللازمة لتقديم طلب الشهادة.',
      },
      {
        title: 'إصدار الشهادة المعتمدة',
        description: 'نقوم بإصدار شهادة استيفاء تركيب الكاميرات المعتمدة رسمياً من الشرطة السعودية في مكة المكرمة.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1558001373-7b93ee48ffaa?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'فني يراجع كاميرات المراقبة في مكة المكرمة',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">لماذا تختارنا في مكة المكرمة؟</h3>
      خبرة في اشتراطات الكاميرات بمكة المكرمة، سرعة في الإنجاز، شهادة معتمدة، أسعار تنافسية، تغطية شاملة، دعم على مدار الساعة.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isAfterContent
    items={[
      {
        title: 'المحلات التجارية والمطاعم',
        description: `إصدار شهادة استيفاء الكاميرات لجميع المحلات والمطاعم في مكة المكرمة لاستكمال التراخيص.`,
      },
      {
        title: 'المستودعات والمصانع',
        description: 'نوفر الشهادة للمستودعات والمصانع في مكة المكرمة مع مراعاة تغطية جميع الزوايا الأمنية.',
      },
      {
        title: 'المكاتب والشركات',
        description: 'نساعد الشركات والمكاتب في مكة المكرمة على استيفاء متطلبات الكاميرات الأمنية.',
      },
      {
        title: 'الصالونات والمشاغل',
        description: 'نغطي الصالونات والمشاغل في مكة المكرمة ونضمن إصدار الشهادة دون تأخير.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1581092160562-40aa08e78837?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'تركيب كاميرات مراقبة في منشأة بمكة المكرمة',
    }}
  >
    <Fragment slot="content">نضمن شهادة كاميرات شاملة لجميع الأنشطة التجارية في مكة المكرمة.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'الالتزام بالأنظمة الأمنية',
        description: 'تثبت شهادة استيفاء الكاميرات التزامك باشتراطات الشرطة السعودية وتجنبك المخالفات في مكة المكرمة.',
      },
      {
        title: 'تسهيل إجراءات التراخيص',
        description: 'الشهادة مطلب أساسي لاستخراج وتجديد الرخص البلدية والتجارية في مكة المكرمة دون تأخير.',
      },
      {
        title: 'حماية المنشأة والموظفين',
        description: 'نظام المراقبة المعتمد يقلل من مخاطر السرقات والحوادث ويوفر بيئة آمنة للجميع في مكة المكرمة.',
      },
      {
        title: 'دعم التحقيقات الأمنية',
        description: 'تسجيلات الكاميرات تساعد الجهات الأمنية عند الحاجة، مما يعزز الأمان العام في مكة المكرمة.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1557804506-669a67965ba0?ixlib=rb-4.0.3&auto=format&fit=crop&w=2074&q=80',
      alt: 'غرفة مراقبة كاميرات أمنية في مكة المكرمة',
    }}
  >
    <Fragment slot="content">مصمم خصيصاً لدعم أمان واستقرار أعمالك التجارية في مكة المكرمة.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Steps
    title="احصل على شهادة استيفاء كاميرات المراقبة المعتمدة في مكة المكرمة وافتح منشأتك بأمان."
    items={[
      {
        title: 'الخطوة 1: <span class="font-medium">فحص أنظمة المراقبة</span>',
        description:
          'نتحقق من تركيب الكاميرات وعددها وزوايا التصوير ومدة التسجيل حسب اشتراطات الشرطة السعودية في مكة المكرمة.',
        icon: 'tabler:package',
      },
      {
        title: 'الخطوة 2: <span class="font-medium">تجهيز المستندات</span>',
        description: 'نجهز التقارير الفنية وقوائم الكاميرات وعقود الصيانة المطلوبة لتقديم طلب الشهادة.',
        icon: 'tabler:letter-case',
      },
      {
        title: 'الخطوة 3: <span class="font-medium">إصدار الشهادة</span>',
        description: 'نقوم بإصدار شهادة استيفاء تركيب الكاميرات المعتمدة رسمياً من الشرطة السعودية.',
        icon: 'tabler:paint',
      },
      {
        title: 'الخطوة 4: <span class="font-medium">استلام الشهادة</span>',
        description: 'نسلمك الشهادة المعتمدة لتقديمها للجهات المختصة واستكمال إجراءات التراخيص بكل يسر في مكة المكرمة.',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1558618666-fcd25c85f82e?ixlib=rb-4.0.3&auto=format&fit=crop&w=987&q=80',
      alt: 'كاميرا مراقبة أمنية في مكة المكرمة',
    }}
  />

  <Features2
    title="متطلبات شهادة استيفاء كاميرات المراقبة في مكة المكرمة"
    subtitle="نضمن لك استيفاء جميع المتطلبات والشروط اللازمة لإصدار شهادة استيفاء كاميرات المراقبة في مكة المكرمة بنجاح وبدون أي ملاحظات"
    tagline="المتطلبات الأساسية"
    items={[
      {
        title: 'الالتزام باشتراطات الشرطة',
        description:
          'التأكد من التزام المنشأة بكافة اشتراطات أنظمة المراقبة حسب تعليمات الشرطة السعودية في مكة المكرمة.',
        icon: 'flat-color-icons:template',
      },
      {
        title: 'توفر كاميرات مراقبة كافية',
        description: 'تركيب عدد كافٍ من الكاميرات لتغطية المداخل والمخارج والمناطق الحيوية في المنشأة.',
        icon: 'flat-color-icons:gallery',
      },
      {
        title: 'جميع المستندات المطلوبة',
        description: 'تجهيز كافة المستندات مثل قائمة الكاميرات وتقارير الفحص الفني وعقود الصيانة.',
        icon: 'flat-color-icons:approval',
      },
      {
        title: 'دفع الرسوم المقررة',
        description: 'التأكد من سداد جميع الرسوم المقررة لإصدار الشهادة في مكة المكرمة.',
        icon: 'flat-color-icons:document',
      },
      {
        title: 'عقد صيانة ساري المفعول',
        description: 'توفير عقد صيانة لأنظمة المراقبة مع شركة معتمدة لضمان استمرارية العمل.',
        icon: 'flat-color-icons:advertising',
      },
      {
        title: 'تقرير فني معتمد',
        description: 'توفير تقارير الفحص الفني المعتمدة التي تثبت استيفاء المنشأة للاشتراطات في مكة المكرمة.',
        icon: 'flat-color-icons:currency-exchange',
      },
      {
        title: 'شهادة الكاميرات الأمنية',
        description: 'شهادة تثبت تركيب الكاميرات وفق المواصفات المطلوبة من الجهات المختصة في مكة المكرمة.',
        icon: 'flat-color-icons:voice-presentation',
      },
      {
        title: 'تغطية زوايا التصوير',
        description: 'التأكد من زوايا التصوير المناسبة وعدم وجود نقاط عمياء في نطاق المراقبة.',
        icon: 'flat-color-icons:business-contact',
      },
      {
        title: 'مدة تسجيل لا تقل عن 30 يوم',
        description: 'توفر أجهزة تسجيل تحفظ اللقطات لمدة 30 يوماً على الأقل حسب الاشتراطات في مكة المكرمة.',
        icon: 'flat-color-icons:database',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <BlogLatestPosts
    title="تصفح آخر مستجدات أنظمة كاميرات المراقبة في مكة المكرمة بالمدونة"
    information={`نشاركك دورياً شروحات مفصلة حول اشتراطات كاميرات المراقبة وأحدث تعليمات الشرطة السعودية في مكة المكرمة.
                  كل مقال جديد نطرحه يمثل خطوة هامة تمكنك من حماية منشأتك وتفادي تأخير التراخيص لتصبح خبيراً في إدارة أنظمة الأمان.
                  الالتزام بالأنظمة الأمنية هو استثمارك الذكي. شكراً لثقتكم.
                `}
  />

  <FAQs
    title="الأسئلة الشائعة"
    subtitle="تعمق في الإجابات التالية للحصول على فهم شامل حول شهادة استيفاء كاميرات المراقبة في مكة المكرمة وكيف يمكن لمنصتنا تسريع أعمالك."
    tagline="الأسئلة الشائعة في مكة المكرمة"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'هل تقدمون الخدمة في جميع أحياء مكة المكرمة؟',
        description:
          'نعم، نغطي جميع أحياء ومناطق مكة المكرمة بدون استثناء، بما فيها العزيزية، الرصيفة، الشوقية، العوالي، وجميع أحياء منطقة مكة المكرمة.',
      },
      {
        title: 'ما هي شهادة استيفاء كاميرات المراقبة؟',
        description: 'وثيقة رسمية تثبت التزام المنشأة بتركيب كاميرات مراقبة مطابقة لاشتراطات الشرطة السعودية.',
      },
      {
        title: 'كم يستغرق إنجاز الخدمة في مكة المكرمة؟',
        description:
          'نسعى لإنجاز الخدمة في أسرع وقت ممكن بعد التأكد من تركيب الكاميرات. تواصل معنا للاستفسار عن الوقت المتوقع.',
      },
      {
        title: 'هل شهادة الكاميرات مطلوبة لجميع الأنشطة؟',
        description: 'تختلف حسب نوع النشاط، لكن معظم الأنشطة التجارية في مكة المكرمة تتطلبها لاستخراج وتجديد الرخص.',
      },
      {
        title: 'ما الأنشطة التي تحتاج شهادة الكاميرات في مكة المكرمة؟',
        description: 'المحلات التجارية، المطاعم، المستودعات، الصالونات، المكاتب، والشقق المفروشة.',
      },
      {
        title: 'كيف أتواصل معكم في مكة المكرمة؟',
        description: 'يمكنك التواصل معنا عبر واتساب أو الاتصال على 0572140531 في أي وقت، وفريقنا جاهز للرد عليك.',
      },
    ]}
  />

  <Stats
    stats={[
      { title: 'شهادة كاميرات تم إصدارها في مكة المكرمة', amount: '+1.8K' },
      { title: 'منشأة مخدومة في مكة المكرمة', amount: '+1.5K' },
      { title: 'نسبة القبول في مكة المكرمة', amount: '99%' },
