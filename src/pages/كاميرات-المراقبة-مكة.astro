---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'شهادة استيفاء كاميرات المراقبة في مكة المكرمة - 0572140531',
  description: 'إصدار شهادة استيفاء كاميرات المراقبة الأمنية في مكة المكرمة بمعايير معتمدة، مع الفحص والتركيب المتوافق مع اللوائح والاشتراطات الرسمية بكل دقة.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'طلب شهادة الكاميرات في مكة المكرمة فوراً',
        href: '#contact',
        icon: 'tabler:camera',
      },
      { text: 'اكتشف خدماتنا', href: '#features' },
    ]}
    image={{
      src: '~/assets/images/hero-image.png',
      alt: 'توب سيفتي برو لشهادة استيفاء كاميرات المراقبة في مكة المكرمة',
    }}
  >
    <Fragment slot="title">
      شهادة استيفاء <span class="hidden xl:inline">كاميرات المراقبة</span>
      <span class="text-accent dark:text-white">في مكة المكرمة</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">منصة توب سيفتي برو</span> تقدم لك خدمة إصدار شهادة استيفاء تركيب كاميرات المراقبة في مكة
        المكرمة (المنطقة الغربية) لجميع المنشآت التجارية، معتمدة من الشرطة السعودية.</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600"
        >توب سيفتي برو: شهادة كاميرات معتمدة في مكة المكرمة.</span
      >
      نخدم جميع أحياء مكة المكرمة: حي العزيزية، حي الرصيفة، حي الشوقية، حي العوالي، وجميع أحياء منطقة مكة المكرمة.
    </Fragment>
  </Hero>

  <Note
    title="فلسفتنا:"
    description="السرعة الفائقة، الالتزام بالمعايير الأمنية، وتسهيل إجراءات إصدار شهادة استيفاء كاميرات المراقبة لعملائنا في مكة المكرمة"
  />

  <Features
    id="features"
    tagline="المميزات والخدمات في مكة المكرمة"
    title="ما نقدمه في شهادة كاميرات المراقبة بمكة المكرمة"
    subtitle="خدمات متكاملة لتسهيل حصولك على شهادة استيفاء كاميرات المراقبة المعتمدة من الشرطة السعودية في مكة المكرمة."
    items={[
      {
        title: 'خبرة في اشتراطات مكة المكرمة',
        description: 'فهم دقيق لمتطلبات الشرطة السعودية وأمانة العاصمة المقدسة لأنظمة المراقبة والأمن.',
        icon: 'tabler:camera',
      },
      {
        title: 'شهادة معتمدة رسمياً',
        description: 'نصدر شهادة استيفاء تركيب الكاميرات المعتمدة والمطلوبة للرخص البلدية والتجارية في مكة المكرمة.',
        icon: 'tabler:certificate',
      },
      {
        title: 'فحص أنظمة المراقبة',
        description: 'نتأكد من توافق كاميراتك مع الاشتراطات الأمنية من حيث العدد والزوايا ومدة التسجيل في مكة المكرمة.',
        icon: 'tabler:search',
      },
      {
        title: 'سرعة في الإنجاز',
        description: 'نضمن إصدار الشهادة في أيام معدودة لتجنب أي تأخير في تجديد تراخيصك في مكة المكرمة.',
        icon: 'tabler:rocket',
      },
      {
        title: 'أسعار تنافسية',
        description: 'نقدم أفضل الأسعار في مكة المكرمة مع الحفاظ على أعلى مستويات الجودة والاحترافية.',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'تغطية جميع أحياء مكة المكرمة',
        description: 'نخدم جميع أحياء مكة المكرمة بدون استثناء، بما فيها العزيزية، الرصيفة، الشوقية، العوالي، وغيرها.',
        icon: 'tabler:map-pin',
      },
    ]}
  />

