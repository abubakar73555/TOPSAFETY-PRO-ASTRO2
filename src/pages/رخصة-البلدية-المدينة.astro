---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'تجديد رخصة البلدية في المدينة المنورة - 0572140531',
  description: 'خدمة سريعة ومعتمدة لتجديد رخصة البلدية في المدينة المنورة، مع استيفاء كافة اشتراطات ومتطلبات السلامة البلدية وإصدار التقارير الفنية بكل احترافية.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'طلب تجديد الرخصة في المدينة المنورة فوراً',
        href: '#contact',
        icon: 'tabler:file-text',
      },
      { text: 'اكتشف خدماتنا', href: '#features' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'توب سيفتي برو لتجديد رخصة البلدية في المدينة المنورة' }}
  >
    <Fragment slot="title">
      تجديد رخصة <span class="hidden xl:inline">البلدية</span>
      <span class="text-accent dark:text-white">في المدينة المنورة</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">منصة توب سيفتي برو</span> تقدم لك خدمة تجديد رخصة البلدية في المدينة المنورة (المنطقة
        الغربية) بسرعة واحترافية، مع تجهيز جميع المستندات المطلوبة ومتابعة الطلب حتى الإصدار.</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">توب سيفتي برو: اعتماد فوري في المدينة المنورة.</span>
      نخدم جميع أحياء المدينة المنورة: حي النخيل، حي العريض، حي أحد، حي قباء، وجميع أحياء المنطقة الغربية.
    </Fragment>
  </Hero>

  <Note
    title="فلسفتنا:"
    description="السرعة الفائقة، الالتزام بالمعايير، وتسهيل إجراءات تجديد الرخصة البلدية لعملائنا في المدينة المنورة"
  />

  <Features
    id="features"
    tagline="المميزات والخدمات في المدينة المنورة"
    title="ما ستحصل عليه مع توب سيفتي برو في المدينة المنورة"
    subtitle="واحدة من أفضل الخدمات المتكاملة في المدينة المنورة لتجديد رخص البلدية بامتثال كامل للأنظمة واللوائح البلدية."
    items={[
      {
        title: 'خبرة واسعة في المدينة المنورة',
        description:
          'لدينا خبرة واسعة في سوق المدينة المنورة والمنطقة الغربية، ونفهم تماماً متطلبات البلديات في المنطقة.',
        icon: 'tabler:brand-tailwind',
      },
      {
        title: 'تجهيز كامل للمستندات',
        description:
          'نقوم بتجهيز جميع الأوراق المطلوبة مثل بيانات المنشأة والشهادات الصحية وعقود الإيجار بشكل احترافي ومنظم.',
        icon: 'tabler:components',
      },
      {
        title: 'فحص الموقع والالتزام بالمعايير',
        description:
          'نضمن مراجعة منشأتك في المدينة المنورة للتأكد من التزامها بمعايير النظافة والصحة العامة ومتطلبات البلدية قبل تقديم الطلب.',
        icon: 'tabler:list-check',
      },
      {
        title: 'سرعة في الإنجاز',
        description: 'نضمن لك إنجاز المعاملة وإصدار الرخصة في المدينة المنورة في أيام معدودة لتفادي أي غرامات.',
        icon: 'tabler:rocket',
      },
      {
        title: 'أسعار تنافسية',
        description: 'نقدم أفضل الأسعار في سوق المدينة المنورة مع الحفاظ على أعلى مستويات الجودة والاحترافية.',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'تغطية جميع أحياء المدينة المنورة',
        description:
          'نخدم جميع أحياء ومناطق المدينة المنورة بدون استثناء، بما فيها حي النخيل، العريض، أحد، قباء، وغيرها.',
        icon: 'tabler:bulb',
      },
    ]}
  />

  <Content
    isReversed
    tagline="داخل الخدمة في المدينة المنورة"
    title="خطوات تجديد رخصة البلدية في المدينة المنورة"
    items={[
      {
        title: 'فحص الموقع',
        description:
          'يتم فحص المنشأة في المدينة المنورة للتأكد من الالتزام بمعايير النظافة والصحة العامة ومتطلبات البلدية بدقة متناهية لضمان قبول الطلب.',
      },
      {
        title: 'تجهيز المستندات',
        description:
          'نقوم بتجهيز جميع الأوراق المطلوبة مثل بيانات المنشأة والشهادات الصحية وعقود الإيجار بشكل احترافي ومنظم.',
      },
      {
        title: 'تقديم الطلب عبر منصة بلدي',
        description:
          'نقوم بتقديم الطلب عبر منصة بلدي الرسمية ومتابعته بدقة حتى صدور رخصة البلدية الجديدة في المدينة المنورة.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'فريق عمل يتابع معاملات البلدية في المدينة المنورة',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        لماذا تختارنا في المدينة المنورة؟
      </h3>
      خبرة واسعة في المدينة المنورة، سرعة في الإنجاز، معتمدون من الدفاع المدني، أسعار تنافسية، تغطية جميع أحياء المدينة المنورة،
      دعم على مدار الساعة.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isAfterContent
    items={[
      {
        title: 'مرونة وتخصيص لا محدود',
        description: `نقوم بتطويع عملية التجديد لتتتناسب تماماً مع متطلبات وهوية نشاطك التجاري في المدينة المنورة، مما يحميك ويختصر وقتك وجهدك.`,
      },
      {
        title: 'تغطية شاملة لجميع الأنشطة',
        description:
          'نغطي كافة أنواع الأنشطة التجارية في المدينة المنورة من المحلات البسيطة إلى المصانع الكبرى لنجد الحل الأنسب الذي يسهل مراجعة ملفك.',
      },
      {
        title: 'متابعة دقيقة للطلب',
        description: 'نتابع طلبك بدقة متناهية عبر منصة بلدي حتى صدور الرخصة الجديدة وإبلاغك فوراً في المدينة المنورة.',
      },
      {
        title: 'دعم متكامل للعملاء',
        description:
          'انضم إلى مئات المنشآت في المدينة المنورة التي وثقت بـ توب سيفتي برو، واستفد من الدعم المتواصل طوال رحلة استخراج رخصتك.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1450101499163-c8848c66ca85?ixlib=rb-4.0.3&auto=format&fit=crop&w=2194&q=80',
      alt: 'مستندات ومعاملات بلدية في المدينة المنورة',
    }}
  >
    <Fragment slot="content"
      >نضمن أن تواجدك النظامي في المدينة المنورة يمثلك ويمثل التزام منشأتك بالقوانين بشكل حقيقي.</Fragment
    >

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'تفاعل وتجاوب سريع مع النظام',
        description:
          'نواكب كافة التحديثات في منصات التراخيص البلدية في المدينة المنورة لتفادي أي تأخير، مما يضمن بقاء منشأتك قانونية دائماً.',
      },
      {
        title: 'تطوير وتحديث مستمر',
        description:
          'نتابع التعديلات الدورية في اشتراطات البلديات في المنطقة الغربية لنقدم لك استشارات محدثة دائماً ومتوافقة مع أحدث الأنظمة.',
      },
      {
        title: 'كفاءة عالية في الوقت والموارد',
        description:
          'وفر على نفسك عناء البدء من الصفر أو مراجعة المعاملات المرفوضة في المدينة المنورة؛ اطلب التجديد من توب سيفتي برو وانطلق فوراً.',
      },
      {
        title: 'حلول مبتكرة للمشاكل المعقدة',
        description: `إذا كانت منشأتك في المدينة المنورة تفتقر لبعض المتطلبات، نقدم لك حلولاً ذكية للتوافق مع النظام دون تكاليف باهظة أو تأخير.`,
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1552664730-d307ca884978?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'فريق عمل يتابع المشاريع في المدينة المنورة',
    }}
  >
    <Fragment slot="content">مصمم خصيصاً لدعم نمو واستقرار أعمالك التجارية في المدينة المنورة.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Steps
    title="احصل على رخصتك البلدية المعتمدة في المدينة المنورة وافتح منشأتك في أسرع وقت."
    items={[
      {
        title: 'الخطوة 1: <span class="font-medium">فحص الموقع</span>',
        description:
          'يتم فحص المنشأة في المدينة المنورة للتأكد من الالتزام بمعايير النظافة والصحة العامة ومتطلبات البلدية بدقة متناهية لضمان قبول الطلب.',
        icon: 'tabler:package',
      },
      {
        title: 'الخطوة 2: <span class="font-medium">تجهيز المستندات</span>',
        description:
          'نقوم بتجهيز جميع الأوراق المطلوبة مثل بيانات المنشأة والشهادات الصحية وعقود الإيجار بشكل احترافي ومنظم في المدينة المنورة.',
        icon: 'tabler:letter-case',
      },
      {
        title: 'الخطوة 3: <span class="font-medium">تقديم الطلب</span>',
        description:
          'نقوم بتقديم الطلب عبر منصة بلدي الرسمية في المدينة المنورة ومتابعته بدقة حتى صدور رخصة البلدية الجديدة.',
        icon: 'tabler:paint',
      },
      {
        title: 'الخطوة 4: <span class="font-medium">استلام الرخصة</span>',
        description:
          'نسلمك الرخصة الجديدة بعد إصدارها رسمياً عبر منصة بلدي في المدينة المنورة لتتمكن من مزاولة نشاطك التجاري بكل سهولة.',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1450101499163-c8848c66ca85?ixlib=rb-4.0.3&auto=format&fit=crop&w=987&q=80',
      alt: 'إصدار الرخصة البلدية بنجاح تام في المدينة المنورة',
    }}
  />

  <Features2
    title="متطلبات تجديد رخصة البلدية في المدينة المنورة"
    subtitle="نضمن لك استيفاء جميع المتطلبات والشروط اللازمة لتجديد رخصة البلدية في المدينة المنورة بنجاح وبدون أي ملاحظات"
    tagline="المتطلبات الأساسية"
    items={[
      {
        title: 'التزام بمعايير النظافة',
        description:
          'التأكد من التزام المنشأة في المدينة المنورة بكافة معايير النظافة العامة والصحة البيئية حسب اشتراطات البلدية.',
        icon: 'flat-color-icons:template',
      },
      {
        title: 'تراخيص سابقة صالحة',
        description:
          'مراجعة التراخيص السابقة والتأكد من صلاحيتها وعدم وجود مخالفات أو غرامات مستحقة على المنشأة في المدينة المنورة.',
        icon: 'flat-color-icons:gallery',
      },
      {
        title: 'جميع المستندات المطلوبة',
        description:
          'تجهيز كافة المستندات المطلوبة مثل السجل التجاري، الهوية الوطنية، والعقود الرسمية بشكل كامل في المدينة المنورة.',
        icon: 'flat-color-icons:approval',
      },
      {
        title: 'دفع الرسوم المقررة',
        description:
          'التأكد من سداد جميع الرسوم البلدية المقررة وتجديد الاشتراكات اللازمة قبل تقديم طلب التجديد في المدينة المنورة.',
        icon: 'flat-color-icons:document',
      },
      {
        title: 'عقد إيجار ساري المفعول',
        description:
          'التحقق من وجود عقد إيجار ساري المفعول ومطابق للشروط البلدية المعتمدة للمنشأة التجارية في المدينة المنورة.',
        icon: 'flat-color-icons:advertising',
      },
      {
        title: 'شهادات صحية (حسب النشاط)',
        description:
          'توفير الشهادات الصحية المطلوبة حسب نوع النشاط التجاري في المدينة المنورة مثل المطاعم والمحلات الغذائية.',
        icon: 'flat-color-icons:currency-exchange',
      },
      {
        title: 'تقرير الدفاع المدني',
        description:
          'توفير تقرير فني معتمد من الدفاع المدني يثبت استيفاء المنشأة في المدينة المنورة لاشتراطات السلامة المطلوبة.',
        icon: 'flat-color-icons:voice-presentation',
      },
      {
        title: 'شهادة الكاميرات الأمنية',
        description:
          'توفير شهادة استيفاء كاميرات المراقبة حسب متطلبات البلدية في المدينة المنورة للمنشآت التجارية المحددة.',
        icon: 'flat-color-icons:business-contact',
      },
      {
        title: 'عقد صيانة لأنظمة السلامة',
        description: 'توفير عقد صيانة ساري المفعول لأنظمة السلامة والحريق مع مكتب هندسي معتمد في المدينة المنورة.',
        icon: 'flat-color-icons:database',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <BlogLatestPosts
    title="تصفح آخر مستجدات الأنظمة البلدية في المدينة المنورة بالمدونة"
    information={`نشاركك دورياً شروحات مفصلة حول الأنظمة البلدية واشتراطات منصة بلدي في المدينة المنورة والمنطقة الغربية.
                  كل مقال جديد نطرحه يمثل خطوة هامة تمكنك من حماية منشأتك وتفادي تأخير التراخيص لتصبح خبيراً في إدارة شؤون منشأتك.
                  الالتزام هو استثمارك الذكي. شكراً لثقتكم.
                `}
  />

  <FAQs
    title="الأسئلة الشائعة"
    subtitle="تعمق في الإجابات التالية للحصول على فهم شامل حول تجديد رخصة البلدية في المدينة المنورة وكيف يمكن لمنصتنا تسريع أعمالك التجارية."
    tagline="الأسئلة الشائعة في المدينة المنورة"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'هل تقدمون الخدمة في جميع أحياء المدينة المنورة؟',
        description:
          'نعم، نغطي جميع أحياء ومناطق المدينة المنورة بدون استثناء، بما فيها حي النخيل، حي العريض، حي أحد، حي قباء، وجميع أحياء المنطقة الغربية.',
      },
      {
        title: 'كم يستغرق إنجاز الخدمة في المدينة المنورة؟',
        description:
          'نسعى لإنجاز الخدمة في أسرع وقت ممكن، عادةً عدة أيام بعد استكمال المستندات المطلوبة. تواصل معنا للاستفسار عن الوقت المتوقع.',
      },
      {
        title: 'كيف أتواصل معكم في المدينة المنورة؟',
        description:
          'يمكنك التواصل معنا عبر واتساب أو الاتصال على 0572140531 في أي وقت، وفريقنا جاهز للرد عليك ومتابعة معاملتك في المدينة المنورة.',
      },
      {
        title: 'ما هي رخصة البلدية ولماذا هي مهمة؟',
        description:
          'رخصة البلدية تصريح قانوني يضمن التزام المنشآت في المدينة المنورة بالقوانين البلدية المتعلقة بالنظافة والصحة العامة. وهي إلزامية لمزاولة أي نشاط تجاري بشكل قانوني وتجنب المخالفات والغرامات.',
      },
      {
        title: 'ما هي مدة صلاحية رخصة البلدية؟',
        description:
          'عادة تكون صلاحية رخصة البلدية سنة واحدة، ويجب تجديدها قبل انتهاء المدة لتجنب المخالفات والغرامات المالية التي قد تصل إلى إيقاف النشاط التجاري في المدينة المنورة.',
      },
      {
        title: 'ماذا يحدث إذا انتهت صلاحية الرخصة؟',
        description:
          'قد تتعرض المنشأة في المدينة المنورة للغرامات المالية أو منعها من مزاولة النشاط حتى تجديد الرخصة. لذلك ننصح دائماً بالتجديد قبل انتهاء المدة بوقت كافٍ.',
      },
    ]}
  />

  <Stats
    stats={[
      { title: 'رخصة بلدية تم تجديدها في المدينة المنورة', amount: '+1.8K' },
      { title: 'منشأة في المدينة المنورة', amount: '+1.5K' },
      { title: 'نسبة القبول في المدينة المنورة', amount: '99%' },
      { title: 'أحياء المدينة المنورة المخدومة', amount: '25+' },
    ]}
  />

  <CallToAction
    id="contact"
    actions={[
      {
        variant: 'primary',
        text: 'تواصل معنا عبر الواتساب فوراً في المدينة المنورة',
        href: 'https://wa.me/966572140531',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
    ]}
  >
    <Fragment slot="title"> جدد رخصة البلدية في المدينة المنورة الآن </Fragment>

    <Fragment slot="subtitle">
      لا تدع انتهاء الرخصة يعطل أعمالك التجارية في المدينة المنورة ويعرضك للغرامات. <br class="hidden md:inline" />تواصل
      معنا الآن وسنتولى جميع إجراءات التجديد بسرعة واحترافية في المدينة المنورة!
    </Fragment>
  </CallToAction>
</Layout>
