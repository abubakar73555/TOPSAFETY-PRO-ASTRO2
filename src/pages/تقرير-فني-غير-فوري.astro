---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'تقرير فني غير فوري لتجديد رخصة البلدية',
  description: 'احصل على تقرير فني غير فوري معتمد لتجديد رخصة البلدية بكل سهولة وسرعة، مع استيفاء كافة الاشتراطات والمتطلبات الرسمية للمنشآت.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'احصل على تقريرك الفني غير الفوري الآن',
        href: '#contact',
        icon: 'tabler:file-text',
      },
      { text: 'إكتشف خدماتنا', href: '#features' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'توب سيفتي برو لإصدار التقارير الفنية غير الفورية' }}
  >
    <Fragment slot="title">
      تقرير فني <span class="hidden xl:inline">غير فوري</span>
      <span class="text-accent dark:text-white">لتجديد رخصة البلدية</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">منصة توب سيفتي برو</span> تقدم لك إصدار التقارير الفنية غير الفورية عبر بوابة سلامة لضمان
        الجاهزية والحماية المتكاملة للمنشآت التجارية والصناعية.</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">توب سيفتي برو: اعتماد فوري.</span>
      مكتب هندسي معتمد من الدفاع المدني، نخدم جميع مدن المملكة العربية السعودية: جدة، الرياض، مكة، الدمام، المدينة، الطائف،
      الخبر، القصيم.
    </Fragment>
  </Hero>

  <Note
    title="فلسفتنا:"
    description="السرعة الفائقة، الالتزام بالمعايير، وتسهيل الإجراءات النظامية لعملائنا عبر بوابة سلامة"
  />

  <Features
    id="features"
    tagline="المميزات والخدمات"
    title="ما ستحصل عليه مع توب سيفتي برو"
    subtitle="واحدة من أفضل الخدمات الهندسية المتكاملة في السوق السعودي لإصدار التقارير الفنية غير الفورية بامتثال كامل لكود البناء واشتراطات الدفاع المدني."
    items={[
      {
        title: 'مكتب هندسي معتمد من الدفاع المدني',
        description:
          'نحن مكتب هندسي متخصص بمجال السلامة من الحريق معتمد من قبل إدارة الدفاع المدني، مما يضمن قبول تقاريرك رسمياً.',
        icon: 'tabler:brand-tailwind',
      },
      {
        title: 'فحص ميداني شامل',
        description:
          'يقوم فريقنا الهندسي بزيارة منشأتك وفحص جميع أنظمة السلامة والتأكد من مطابقتها لاشتراطات الدفاع المدني.',
        icon: 'tabler:components',
      },
      {
        title: 'ربط مباشر مع بوابة سلامة',
        description: 'نصدر تقاريرك الفنية مباشرة عبر بوابة سلامة ومنصة بلدي، مما يضمن قبولها فوراً دون أي ملاحظات.',
        icon: 'tabler:list-check',
      },
      {
        title: 'عقد صيانة معتمد',
        description: 'نوفر لك عقد صيانة معتمد لأنظمة السلامة مع شركة أمن وسلامة متخصصة، مطلوب للتقرير غير الفوري.',
        icon: 'tabler:rocket',
      },
      {
        title: 'أسعار تنافسية',
        description: 'نقدم أفضل الأسعار في السوق مع الحفاظ على أعلى مستويات الجودة والاحترافية في إعداد التقارير.',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'تغطية جميع مدن المملكة',
        description:
          'نخدم جميع مدن المملكة العربية السعودية: جدة، الرياض، مكة، الدمام، المدينة، الطائف، الخبر، القصيم.',
        icon: 'tabler:bulb',
      },
    ]}
  />

  <Content
    isReversed
    tagline="ما هو التقرير الفني غير الفوري؟"
    title="التقرير الفني غير الفوري: وثيقة أساسية لتجديد رخصة البلدية"
    items={[
      {
        title: 'تعريف التقرير غير الفوري',
        description:
          'يُعتبر التقرير الفني غير الفوري من أهم الوثائق المطلوبة لضمان التزام المنشآت التجارية والصناعية بمعايير الوقاية والحماية من الحريق. يتم إصداره عبر "بوابة سلامة" بالتعاون مع مكاتب هندسية معتمدة وشركات أمن وسلامة متخصصة.',
      },
      {
        title: 'أهمية التقرير غير الفوري',
        description:
          'يهدف هذا التقرير إلى تقييم شامل لجاهزية المنشأة بعد إجراء الصيانة اللازمة لمعدات الوقاية والحماية من الحريق، ويُعتبر شرطاً أساسياً لتجديد رخص البلديات من خلال التكامل مع منصة بلدي.',
      },
      {
        title: 'متى يُطلب التقرير غير الفوري؟',
        description:
          'يُطلب عند تجديد رخصة البلدية للأنشطة غير الفورية أو الأنشطة ذات المساحة الكبيرة، ويتطلب فحصاً ميدانياً وعقد صيانة مرتبطاً به.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1581094794329-c8112a89af12?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'التقرير الفني غير الفوري',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">ضمان سلامة منشأتك</h3>
      نضمن لك الحصول على تقرير فني غير فوري معتمد من الدفاع المدني يلبي جميع متطلبات البلدية ويضمن سلامة منشأتك بشكل كامل.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isAfterContent
    items={[
      {
        title: 'دقة عالية في التقييم',
        description: `يقوم فريقنا الهندسي بتقييم شامل لجميع أنظمة السلامة في منشأتك بدقة متناهية لضمان استيفاء جميع المتطلبات والاشتراطات.`,
      },
      {
        title: 'ربط آلي مع منصة بلدي',
        description:
          'نضمن الربط الآلي للتقرير الفني غير الفوري مع منصة بلدي وبوابة سلامة، مما يسهل إجراءات التجديد ويضمن القبول الفوري.',
      },
      {
        title: 'أعلى معايير السلامة',
        description:
          'نلتزم بأعلى معايير السلامة المعتمدة من الدفاع المدني، مما يضمن حماية منشأتك وموظفيك وزوارك من مخاطر الحريق.',
      },
      {
        title: 'توثيق شامل للمنشأة',
        description:
          'نوفر توثيقاً كاملاً لحالة المنشأة ومعداتها، مع توصيات فورية لتحسين أنظمة السلامة وضمان الامتثال الكامل.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1581092160607-ee22621dd758?ixlib=rb-4.0.3&auto=format&fit=crop&w=2194&q=80',
      alt: 'مميزات التقرير الفني غير الفوري',
    }}
  >
    <Fragment slot="content">نضمن لك الحصول على تقرير فني غير فوري معتمد بسرعة واحترافية.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'رفع مستوى الأمان',
        description:
          'رفع مستوى الأمان في المنشآت وتعزيز جاهزيتها للطوارئ من خلال تقييم شامل لأنظمة السلامة وتقديم توصيات فورية.',
      },
      {
        title: 'الامتثال للتشريعات',
        description:
          'الامتثال للتشريعات وضمان حصول المنشآت على التراخيص اللازمة من خلال تقديم تقارير فنية معتمدة ومقبولة رسمياً.',
      },
      {
        title: 'التكامل مع المنصات الإلكترونية',
        description: 'التكامل مع منصات إلكترونية معتمدة مثل بوابة سلامة ومنصة بلدي لتسهيل إجراءات التراخيص وتسريعها.',
      },
      {
        title: 'تعزيز ثقافة الصيانة الوقائية',
        description: `تعزيز ثقافة الصيانة الوقائية لمعدات الوقاية من الحريق من خلال توفير عقود صيانة معتمدة ومتابعة دورية.`,
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1581092918056-0c4c3acd3789?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'أهمية التقرير الفني غير الفوري',
    }}
  >
    <Fragment slot="content">نوفر لك جميع أنواع التقارير الفنية بسرعة واحترافية في جميع مدن المملكة.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Steps
    title="احصل على تقريرك الفني غير الفوري المعتمد في أسرع وقت."
    items={[
      {
        title: 'الخطوة 1: <span class="font-medium">إصدار تقرير مبدئي</span>',
        description: 'يتم إصدار تقرير مبدئي من مكتب هندسي معتمد من الدفاع المدني بعد مراجعة بيانات المنشأة الأساسية.',
        icon: 'tabler:package',
      },
      {
        title: 'الخطوة 2: <span class="font-medium">إجراء الصيانة اللازمة</span>',
        description: 'يتم إجراء الصيانة اللازمة لمعدات الوقاية والحماية من الحريق للتأكد من جاهزيتها التامة.',
        icon: 'tabler:letter-case',
      },
      {
        title: 'الخطوة 3: <span class="font-medium">ربط التقرير بعقد الصيانة</span>',
        description: 'يتم ربط التقرير الفني بعقد الصيانة الصادر من شركة الأمن والسلامة المعتمدة.',
        icon: 'tabler:paint',
      },
      {
        title: 'الخطوة 4: <span class="font-medium">إصدار التقرير النهائي</span>',
        description:
          'يتم إصدار التقرير النهائي بعد التأكد من جاهزية المنشأة، وإدخال رقم التقرير في بوابة سلامة ومنصة بلدي.',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1450101499163-c8848c66ca85?ixlib=rb-4.0.3&auto=format&fit=crop&w=987&q=80',
      alt: 'خطوات إصدار التقرير الفني غير الفوري',
    }}
  />

  <Features2
    title="مميزات التقرير الفني غير الفوري"
    subtitle="نقدم لك تقريراً فنياً غير فوري معتمداً يضمن لك تجديد رخصة البلدية بسرعة وسهولة"
    tagline="مميزاتنا"
    items={[
      {
        title: 'دقة عالية في التقييم',
        description:
          'يقوم فريقنا الهندسي بتقييم شامل لجميع أنظمة السلامة في منشأتك بدقة متناهية لضمان استيفاء جميع المتطلبات.',
        icon: 'flat-color-icons:template',
      },
      {
        title: 'ربط آلي مع منصة بلدي',
        description: 'نضمن الربط الآلي للتقرير الفني غير الفوري مع منصة بلدي وبوابة سلامة، مما يسهل إجراءات التجديد.',
        icon: 'flat-color-icons:gallery',
      },
      {
        title: 'أعلى معايير السلامة',
        description: 'نلتزم بأعلى معايير السلامة المعتمدة من الدفاع المدني، مما يضمن حماية منشأتك بشكل كامل.',
        icon: 'flat-color-icons:approval',
      },
      {
        title: 'توثيق شامل للمنشأة',
        description: 'نوفر توثيقاً كاملاً لحالة المنشأة ومعداتها، مع توصيات فورية لتحسين أنظمة السلامة.',
        icon: 'flat-color-icons:document',
      },
      {
        title: 'تسريع إجراءات التجديد',
        description: 'نساعدك في تسريع إجراءات تجديد رخصة البلدية من خلال تقديم تقارير فنية معتمدة ومقبولة رسمياً.',
        icon: 'flat-color-icons:advertising',
      },
      {
        title: 'امتثال كامل للتشريعات',
        description: 'نضمن امتثالك الكامل للتشريعات واللوائح المعتمدة من الدفاع المدني والبلديات.',
        icon: 'flat-color-icons:currency-exchange',
      },
      {
        title: 'عقد صيانة معتمد',
        description: 'نوفر لك عقد صيانة معتمد لأنظمة السلامة مع شركة أمن وسلامة متخصصة، مطلوب للتقرير غير الفوري.',
        icon: 'flat-color-icons:voice-presentation',
      },
      {
        title: 'فريق هندسي متخصص',
        description: 'لدينا فريق من المهندسين والفنيين المعتمدين ذوي خبرة واسعة في متطلبات السلامة.',
        icon: 'flat-color-icons:business-contact',
      },
      {
        title: 'دعم على مدار الساعة',
        description: 'فريقنا متاح على مدار الساعة لخدمتك والإجابة على جميع استفساراتك في أي وقت.',
        icon: 'flat-color-icons:database',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <BlogLatestPosts
    title="تصفح آخر مستجدات اشتراطات السلامة بالمدونة"
    information={`نشاركك دورياً شروحات مفصلة حول كود البناء السعودي واشتراطات منصة بلدي والدفاع المدني وبوابة سلامة.
                  كل مقال جديد نطرحه يمثل خطوة هامة تمكنك من حماية منشأتك وتفادي تأخير التراخيص لتصبح خبيراً في إدارة شؤون منشأتك.
                  الوقاية هي استثمارك الذكي. شكراً لثقتكم.
                `}
  />

  <FAQs
    title="الأسئلة الشائعة"
    subtitle="تعمق في الإجابات التالية للحصول على فهم شامل حول التقرير الفني غير الفوري وكيف يمكن لمنصتنا تسريع أعمالك التجارية."
    tagline="الأسئلة الشائعة"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'ما هو التقرير الفني غير الفوري؟',
        description:
          'التقرير الفني غير الفوري وثيقة مطلوبة لتجديد رخصة البلدية للأنشطة غير الفورية، يتطلب فحصاً ميدانياً وعقد صيانة مرتبطاً به.',
      },
      {
        title: 'ما الفرق بين التقرير الفوري وغير الفوري؟',
        description:
          'التقرير الفوري للأنشطة الصغيرة ويصدر آلياً، أما غير الفوري فيتطلب فحصاً ميدانياً وعقد صيانة وإصداراً من مكتب هندسي معتمد.',
      },
      {
        title: 'متى يُطلب التقرير الفني غير الفوري؟',
        description: 'يُطلب عند تجديد رخصة البلدية للأنشطة غير الفورية أو الأنشطة ذات المساحة الكبيرة.',
      },
      {
        title: 'هل يحتاج التقرير غير الفوري إلى عقد صيانة؟',
        description: 'نعم، يجب ربط التقرير الفني غير الفوري بعقد صيانة صادر من شركة أمن وسلامة معتمدة.',
      },
      {
        title: 'كم يستغرق إصدار التقرير غير الفوري؟',
        description: 'يستغرق عدة أيام بعد الفحص الميداني وإجراء الصيانة اللازمة. تواصل معنا لمعرفة الوقت الدقيق.',
      },
      {
        title: 'من يصدر التقرير الفني غير الفوري؟',
        description:
          'يصدر التقرير الفني غير الفوري مكتب هندسي متخصص بمجال السلامة من الحريق معتمد من قبل إدارة الدفاع المدني. نحن مؤهلون من الدفاع المدني كمكتب هندسي.',
      },
    ]}
  />

  <Stats
    stats={[
      { title: 'تقرير فني غير فوري صادر', amount: '+5K' },
      { title: 'منشأة تم تأمينها', amount: '+4K' },
      { title: 'تقييمات إيجابية', amount: '100%' },
      { title: 'مدن المملكة المخدومة', amount: '13+' },
    ]}
  />

  <CallToAction
    id="contact"
    actions={[
      {
        variant: 'primary',
        text: 'تواصل معنا عبر الواتساب فوراً',
        href: 'https://wa.me/966572140531',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
    ]}
  >
    <Fragment slot="title"> احصل على تقريرك الفني غير الفوري الآن </Fragment>

    <Fragment slot="subtitle">
      نحن مكتب هندسي معتمد من الدفاع المدني، نصدر التقرير الفني غير الفوري بسرعة واحترافية في جميع مدن المملكة. <br
        class="hidden md:inline"
      />تواصل معنا الآن!
    </Fragment>
  </CallToAction>
</Layout>
