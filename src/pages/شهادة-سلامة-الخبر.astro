---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'شهادة تركيب أدوات السلامة في الخبر - 0572140531',
  description: 'إصدار معتمد لشهادة تركيب أدوات السلامة في الخبر، مع الفحص الشامل وتلبية كافة معايير ومتطلبات الدفاع المدني بكل دقة واحترافية.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'طلب شهادة السلامة في الخبر فوراً',
        href: '#contact',
        icon: 'tabler:file-text',
      },
      { text: 'اكتشف خدماتنا', href: '#features' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'توب سيفتي برو لشهادة تركيب أدوات السلامة في الخبر' }}
  >
    <Fragment slot="title">
      شهادة تركيب <span class="hidden xl:inline">أدوات السلامة</span>
      <span class="text-accent dark:text-white">في الخبر</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">منصة توب سيفتي برو</span> تقدم لك خدمة إصدار شهادة تركيب أدوات الوقاية والحماية من الحريق
        في الخبر (المنطقة الشرقية) لجميع المنشآت التجارية والصناعية عبر بوابة سلامة، معتمدة من الدفاع المدني.</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">توب سيفتي برو: شهادة سلامة معتمدة في الخبر.</span>
      نخدم جميع أحياء الخبر: حي الأندلس، حي الخبر الجنوبية، حي الجسر، حي العقربية، وجميع أحياء المنطقة الشرقية.
    </Fragment>
  </Hero>

  <Note
    title="فلسفتنا:"
    description="السرعة الفائقة، الالتزام بمعايير السلامة، وتسهيل إجراءات إصدار شهادة تركيب أدوات السلامة لعملائنا في الخبر"
  />

  <Features
    id="features"
    tagline="المميزات والخدمات في الخبر"
    title="ما ستحصل عليه مع توب سيفتي برو في الخبر"
    subtitle="واحدة من أفضل الخدمات المتكاملة في الخبر لإصدار شهادة تركيب أدوات الوقاية والحماية من الحريق بامتثال كامل لأنظمة الدفاع المدني."
    items={[
      {
        title: 'خبرة واسعة في الخبر',
        description: 'لدينا خبرة واسعة في سوق الخبر والمنطقة الشرقية، ونفهم تماماً متطلبات الدفاع المدني في المنطقة.',
        icon: 'tabler:brand-tailwind',
      },
      {
        title: 'شهادة معتمدة من الدفاع المدني',
        description:
          'نصدر شهادة تركيب أدوات السلامة المعتمدة من الدفاع المدني، المرتبطة مع منصة بلدي لإصدار وتجديد الرخص التجارية.',
        icon: 'tabler:components',
      },
      {
        title: 'فحص شامل لأدوات السلامة',
        description:
          'نقوم بفحص جميع أدوات الوقاية والحماية من الحريق في منشأتك في الخبر للتأكد من جاهزيتها واستيفائها للمعايير.',
        icon: 'tabler:list-check',
      },
      {
        title: 'سرعة في الإنجاز',
        description: 'نضمن لك إنجاز المعاملة وإصدار الشهادة في الخبر في أيام معدودة لتجنب الغرامات.',
        icon: 'tabler:rocket',
      },
      {
        title: 'أسعار تنافسية',
        description: 'نقدم أفضل الأسعار في سوق الخبر مع الحفاظ على أعلى مستويات الجودة والاحترافية.',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'تغطية جميع أحياء الخبر',
        description:
          'نخدم جميع أحياء ومناطق الخبر بدون استثناء، بما فيها حي الأندلس، الخبر الجنوبية، الجسر، العقربية، وغيرها.',
        icon: 'tabler:bulb',
      },
    ]}
  />

  <Content
    isReversed
    tagline="داخل الخدمة في الخبر"
    title="خطوات إصدار شهادة السلامة في الخبر"
    items={[
      {
        title: 'فحص أدوات السلامة',
        description:
          'نقوم بفحص شامل لجميع أدوات الوقاية والحماية من الحريق في منشأتك في الخبر، بما في ذلك طفايات الحريق، أنظمة الإنذار، والإخلاء، للتأكد من جاهزيتها.',
      },
      {
        title: 'تجهيز المستندات',
        description:
          'نقوم بتجهيز جميع الأوراق المطلوبة مثل قائمة الأدوات، تقارير الفحص الفني، وشهادات المطابقة بشكل احترافي.',
      },
      {
        title: 'إصدار الشهادة عبر بوابة سلامة',
        description: 'نقوم بإصدار الشهادة عبر بوابة سلامة الرسمية المرتبطة مع منصة بلدي في الخبر.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'فريق عمل يتابع إجراءات شهادة السلامة في الخبر',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">لماذا تختارنا في الخبر؟</h3>
      خبرة واسعة في الخبر، سرعة في الإنجاز، معتمدون من الدفاع المدني، أسعار تنافسية، تغطية جميع أحياء الخبر، دعم على مدار
      الساعة.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isAfterContent
    items={[
      {
        title: 'شهادة معتمدة لجميع الأنشطة',
        description: `نصدر شهادة تركيب أدوات السلامة لجميع أنواع الأنشطة التجارية والصناعية في الخبر، من المحلات البسيطة إلى المصانع الكبرى.`,
      },
      {
        title: 'تجنب الغرامات المالية',
        description: 'شهادة السلامة شرط أساسي لتجديد رخصة البلدية، وتجنب الغرامات التي تصل إلى 30 ألف ريال في الخبر.',
      },
      {
        title: 'متابعة دقيقة للطلب',
        description: 'نتابع طلبك بدقة متناهية عبر بوابة سلامة حتى صدور الشهادة وإبلاغك فوراً في الخبر.',
      },
      {
        title: 'دعم متكامل للعملاء',
        description:
          'انضم إلى مئات المنشآت في الخبر التي وثقت بـ توب سيفتي برو، واستفد من الدعم المتواصل طوال رحلة استخراج شهادتك.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1450101499163-c8848c66ca85?ixlib=rb-4.0.3&auto=format&fit=crop&w=2194&q=80',
      alt: 'شهادة تركيب أدوات السلامة المعتمدة في الخبر',
    }}
  >
    <Fragment slot="content"
      >نضمن أن شهادة السلامة في الخبر تمثل التزام منشأتك بأنظمة الوقاية والحماية من الحريق بشكل حقيقي.</Fragment
    >

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'تفاعل وتجاوب سريع مع النظام',
        description:
          'نواكب كافة التحديثات في بوابة سلامة ومنصة بلدي في الخبر لتفادي أي تأخير، مما يضمن بقاء شهادتك سارية دائماً.',
      },
      {
        title: 'تطوير وتحديث مستمر',
        description:
          'نتابع التعديلات الدورية في اشتراطات الدفاع المدني في المنطقة الشرقية لنقدم لك استشارات محدثة دائماً ومتوافقة مع أحدث الأنظمة.',
      },
      {
        title: 'كفاءة عالية في الوقت والموارد',
        description:
          'وفر على نفسك عناء البدء من الصفر أو مراجعة المعاملات المرفوضة في الخبر؛ اطلب شهادة السلامة من توب سيفتي برو وانطلق فوراً.',
      },
      {
        title: 'حلول مبتكرة للمشاكل المعقدة',
        description: `إذا كانت منشأتك في الخبر تفتقر لبعض أدوات السلامة، نقدم لك حلولاً ذكية للتوافق مع النظام دون تكاليف باهظة أو تأخير.`,
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1552664730-d307ca884978?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'فريق عمل يتابع مشاريع السلامة في الخبر',
    }}
  >
    <Fragment slot="content">مصمم خصيصاً لدعم نمو واستقرار أعمالك التجارية في الخبر.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Steps
    title="احصل على شهادة تركيب أدوات السلامة المعتمدة في الخبر وافتح منشأتك بأمان."
    items={[
      {
        title: 'الخطوة 1: <span class="font-medium">فحص أدوات السلامة</span>',
        description:
          'نقوم بفحص شامل لجميع أدوات الوقاية والحماية من الحريق في منشأتك في الخبر، بما في ذلك طفايات الحريق، أنظمة الإنذار، والإخلاء، للتأكد من جاهزيتها.',
        icon: 'tabler:package',
      },
      {
        title: 'الخطوة 2: <span class="font-medium">تجهيز المستندات</span>',
        description:
          'نقوم بتجهيز جميع الأوراق المطلوبة مثل قائمة الأدوات، تقارير الفحص الفني، وشهادات المطابقة بشكل احترافي في الخبر.',
        icon: 'tabler:letter-case',
      },
      {
        title: 'الخطوة 3: <span class="font-medium">إصدار الشهادة</span>',
        description: 'نقوم بإصدار الشهادة عبر بوابة سلامة الرسمية المرتبطة مع منصة بلدي في الخبر.',
        icon: 'tabler:paint',
      },
      {
        title: 'الخطوة 4: <span class="font-medium">استلام الشهادة</span>',
        description:
          'نسلمك الشهادة المعتمدة بعد إصدارها رسمياً عبر بوابة سلامة في الخبر لتتمكن من مزاولة نشاطك التجاري بأمان.',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1450101499163-c8848c66ca85?ixlib=rb-4.0.3&auto=format&fit=crop&w=987&q=80',
      alt: 'إصدار شهادة تركيب أدوات السلامة بنجاح تام في الخبر',
    }}
  />

  <Features2
    title="متطلبات شهادة تركيب أدوات السلامة في الخبر"
    subtitle="نضمن لك استيفاء جميع المتطلبات والشروط اللازمة لإصدار شهادة تركيب أدوات السلامة في الخبر بنجاح وبدون أي ملاحظات"
    tagline="المتطلبات الأساسية"
    items={[
      {
        title: 'التزام بمعايير السلامة',
        description:
          'التأكد من التزام المنشأة في الخبر بكافة معايير السلامة العامة وأنظمة الحماية من الحريق حسب اشتراطات الدفاع المدني.',
        icon: 'flat-color-icons:template',
      },
      {
        title: 'توفر أدوات الوقاية',
        description:
          'التأكد من توفر جميع أدوات الوقاية والحماية من الحريق مثل طفايات الحريق، أنظمة الإنذار، والإخلاء في المنشأة.',
        icon: 'flat-color-icons:gallery',
      },
      {
        title: 'جميع المستندات المطلوبة',
        description:
          'تجهيز كافة المستندات المطلوبة مثل قائمة الأدوات، تقارير الفحص الفني، وشهادات المطابقة بشكل كامل في الخبر.',
        icon: 'flat-color-icons:approval',
      },
      {
        title: 'دفع الرسوم المقررة',
        description: 'التأكد من سداد جميع الرسوم المقررة لإصدار الشهادة في الخبر.',
        icon: 'flat-color-icons:document',
      },
      {
        title: 'عقد صيانة لأنظمة السلامة',
        description: 'توفير عقد صيانة ساري المفعول لأنظمة السلامة والحريق مع مكتب هندسي معتمد في الخبر.',
        icon: 'flat-color-icons:advertising',
      },
      {
        title: 'تقرير فني من الدفاع المدني',
        description: 'توفير تقارير الفحص الفني المعتمدة التي تثبت استيفاء المنشأة في الخبر لاشتراطات السلامة المطلوبة.',
        icon: 'flat-color-icons:currency-exchange',
      },
      {
        title: 'شهادة الكاميرات الأمنية',
        description:
          'توفير شهادة استيفاء كاميرات المراقبة حسب متطلبات الدفاع المدني في الخبر للمنشآت التجارية المحددة.',
        icon: 'flat-color-icons:voice-presentation',
      },
      {
        title: 'خطط الإخلاء والطوارئ',
        description: 'توفير خطط إخلاء وطوارئ معتمدة للمنشأة في الخبر تثبت جاهزيتها للتعامل مع حالات الطوارئ.',
        icon: 'flat-color-icons:business-contact',
      },
      {
        title: 'تدريب الموظفين على السلامة',
        description: 'تقديم شهادات تدريب للموظفين على أنظمة السلامة والإخلاء في الخبر حسب متطلبات الدفاع المدني.',
        icon: 'flat-color-icons:database',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <BlogLatestPosts
    title="تصفح آخر مستجدات أنظمة شهادة السلامة في الخبر بالمدونة"
    information={`نشاركك دورياً شروحات مفصلة حول شهادة تركيب أدوات السلامة واشتراطات الدفاع المدني في الخبر والمنطقة الشرقية.
                  كل مقال جديد نطرحه يمثل خطوة هامة تمكنك من حماية منشأتك وتفادي تأخير التراخيص لتصبح خبيراً في إدارة شؤون السلامة.
                  الالتزام بالسلامة هو استثمارك الذكي. شكراً لثقتكم.
                `}
  />

  <FAQs
    title="الأسئلة الشائعة"
    subtitle="تعمق في الإجابات التالية للحصول على فهم شامل حول شهادة تركيب أدوات السلامة في الخبر وكيف يمكن لمنصتنا تسريع أعمالك التجارية."
    tagline="الأسئلة الشائعة في الخبر"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'هل تقدمون الخدمة في جميع أحياء الخبر؟',
        description:
          'نعم، نغطي جميع أحياء ومناطق الخبر بدون استثناء، بما فيها حي الأندلس، حي الخبر الجنوبية، حي الجسر، حي العقربية، وجميع أحياء المنطقة الشرقية.',
      },
      {
        title: 'ما هي شهادة تركيب أدوات السلامة؟',
        description:
          'شهادة صادرة عبر بوابة سلامة من شركة معتمدة تحتوي على بيان بأدوات السلامة المتوفرة في المنشأة في الخبر، وهي شرط أساسي لتجديد رخصة البلدية.',
      },
      {
        title: 'كم يستغرق إنجاز الخدمة في الخبر؟',
        description:
          'نسعى لإنجاز الخدمة في أسرع وقت ممكن، عادةً عدة أيام بعد استكمال جميع متطلبات السلامة وتجهيز المستندات. تواصل معنا للاستفسار عن الوقت المتوقع.',
      },
      {
        title: 'ما مدة صلاحية شهادة السلامة؟',
        description:
          'سنة واحدة من تاريخ الإصدار، ويجب تجديدها قبل انتهاء المدة لتجنب الغرامات التي تصل إلى 30 ألف ريال في الخبر.',
      },
      {
        title: 'هل شهادة السلامة مطلوبة لجميع الأنشطة؟',
        description:
          'نعم، وتشمل المحلات والمصانع والمستودعات والمباني الإدارية في الخبر التي تستخدم أنظمة سلامة مثل طفايات الحريق وأنظمة الإنذار.',
      },
      {
        title: 'كيف أتواصل معكم في الخبر؟',
        description:
          'يمكنك التواصل معنا عبر واتساب أو الاتصال على 0572140531 في أي وقت، وفريقنا جاهز للرد عليك ومتابعة معاملتك في الخبر.',
      },
    ]}
  />

  <Stats
    stats={[
      { title: 'شهادة سلامة تم إصدارها في الخبر', amount: '+1.8K' },
      { title: 'منشأة في الخبر', amount: '+1.5K' },
      { title: 'نسبة القبول في الخبر', amount: '99%' },
      { title: 'أحياء الخبر المخدومة', amount: '25+' },
    ]}
  />

  <CallToAction
    id="contact"
    actions={[
      {
        variant: 'primary',
        text: 'تواصل معنا عبر الواتساب فوراً في الخبر',
        href: 'https://wa.me/966572140531',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
    ]}
  >
    <Fragment slot="title"> احصل على شهادة السلامة في الخبر الآن </Fragment>

    <Fragment slot="subtitle">
      لا تدع انتهاء الشهادة يعطل أعمالك التجارية في الخبر ويعرضك للغرامات. <br class="hidden md:inline" />تواصل معنا
      الآن وسنتولى جميع إجراءات إصدار الشهادة بسرعة واحترافية في الخبر!
    </Fragment>
