---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'تجديد ترخيص الدفاع المدني في نجران - 0572140531',
  description: 'خدمة سريعة ومعتمدة لتجديد ترخيص الدفاع المدني في نجران، مع استيفاء كافة اشتراطات ومتطلبات السلامة وإصدار التقارير اللازمة بكل احترافية.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'طلب تجديد ترخيص الدفاع المدني في نجران فوراً',
        href: '#contact',
        icon: 'tabler:file-text',
      },
      { text: 'اكتشف خدماتنا', href: '#features' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'توب سيفتي برو لتجديد ترخيص الدفاع المدني في نجران' }}
  >
    <Fragment slot="title">
      تجديد ترخيص <span class="hidden xl:inline">الدفاع المدني</span>
      <span class="text-accent dark:text-white">في نجران</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">منصة توب سيفتي برو</span> تقدم لك خدمة تجديد ترخيص الدفاع المدني في نجران (منطقة نجران)
        للمنشآت التجارية والصناعية، مع فحص أنظمة السلامة وتجهيز المستندات ومتابعة الطلب حتى الإصدار.</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">توب سيفتي برو: اعتماد فوري في نجران.</span>
      نخدم جميع أحياء نجران: حي الفهد، حي الورود، حي النهضة، حي العريسة، وجميع أحياء منطقة نجران.
    </Fragment>
  </Hero>

  <Note
    title="فلسفتنا:"
    description="السرعة الفائقة، الالتزام بمعايير السلامة، وتسهيل إجراءات تجديد ترخيص الدفاع المدني لعملائنا في نجران"
  />

  <Features
    id="features"
    tagline="المميزات والخدمات في نجران"
    title="ما ستحصل عليه مع توب سيفتي برو في نجران"
    subtitle="واحدة من أفضل الخدمات المتكاملة في نجران لتجديد تراخيص الدفاع المدني بامتثال كامل لأنظمة السلامة."
    items={[
      {
        title: 'خبرة واسعة في نجران',
        description: 'لدينا خبرة واسعة في سوق نجران، ونفهم تماماً متطلبات الدفاع المدني في المنطقة.',
        icon: 'tabler:brand-tailwind',
      },
      {
        title: 'تجهيز كامل للمستندات',
        description:
          'نقوم بتجهيز جميع الأوراق المطلوبة مثل تقارير السلامة، شهادات المطابقة، وعقود الصيانة بشكل احترافي ومنظم.',
        icon: 'tabler:components',
      },
      {
        title: 'فحص شامل لأنظمة السلامة',
        description:
          'نقوم بفحص جميع أنظمة السلامة في منشأتك في نجران للتأكد من جاهزيتها واستيفائها لمتطلبات الدفاع المدني.',
        icon: 'tabler:list-check',
      },
      {
        title: 'سرعة في الإنجاز',
        description: 'نضمن لك إنجاز المعاملة وإصدار الترخيص في نجران في أيام معدودة لتفادي أي غرامات.',
        icon: 'tabler:rocket',
      },
      {
        title: 'أسعار تنافسية',
        description: 'نقدم أفضل الأسعار في سوق نجران مع الحفاظ على أعلى مستويات الجودة والاحترافية.',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'تغطية جميع أحياء نجران',
        description: 'نخدم جميع أحياء ومناطق نجران بدون استثناء، بما فيها حي الفهد، الورود، النهضة، العريسة، وغيرها.',
        icon: 'tabler:bulb',
      },
    ]}
  />

  <Content
    isReversed
    tagline="داخل الخدمة في نجران"
    title="خطوات تجديد ترخيص الدفاع المدني في نجران"
    items={[
      {
        title: 'فحص أنظمة السلامة',
        description:
          'نقوم بفحص شامل لجميع أنظمة السلامة في منشأتك في نجران، بما في ذلك أنظمة الإنذار، الإطفاء، والإخلاء، للتأكد من جاهزيتها.',
      },
      {
        title: 'تجهيز المستندات',
        description:
          'نقوم بتجهيز جميع الأوراق المطلوبة مثل تقارير الفحص الفني، شهادات المطابقة، وعقود الصيانة بشكل احترافي.',
      },
      {
        title: 'تقديم الطلب عبر بوابة سلامة',
        description:
          'نقوم بتقديم الطلب عبر بوابة سلامة الرسمية ومتابعته بدقة حتى صدور ترخيص الدفاع المدني الجديد في نجران.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'فريق عمل يتابع إجراءات الدفاع المدني في نجران',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">لماذا تختارنا في نجران؟</h3>
      خبرة واسعة في نجران، سرعة في الإنجاز، معتمدون من الدفاع المدني، أسعار تنافسية، تغطية جميع أحياء نجران، دعم على مدار
      الساعة.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isAfterContent
    items={[
      {
        title: 'مرونة وتخصيص لا محدود',
        description: `نقوم بتطويع عملية تجديد الترخيص لتتتناسب تماماً مع متطلبات وهوية نشاطك التجاري في نجران، مما يحميك ويختصر وقتك وجهدك.`,
      },
      {
        title: 'تغطية شاملة لجميع الأنشطة',
        description:
          'نغطي كافة أنواع الأنشطة التجارية والصناعية في نجران من المحلات البسيطة إلى المصانع الكبرى لنجد الحل الأنسب الذي يسهل مراجعة ملفك.',
      },
      {
        title: 'متابعة دقيقة للطلب',
        description: 'نتابع طلبك بدقة متناهية عبر بوابة سلامة حتى صدور الترخيص الجديد وإبلاغك فوراً في نجران.',
      },
      {
        title: 'دعم متكامل للعملاء',
        description:
          'انضم إلى مئات المنشآت في نجران التي وثقت بـ توب سيفتي برو، واستفد من الدعم المتواصل طوال رحلة استخراج ترخيصك.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1450101499163-c8848c66ca85?ixlib=rb-4.0.3&auto=format&fit=crop&w=2194&q=80',
      alt: 'مستندات وإجراءات الدفاع المدني في نجران',
    }}
  >
    <Fragment slot="content"
      >نضمن أن تواجدك النظامي في نجران يمثلك ويمثل التزام منشأتك بأنظمة السلامة بشكل حقيقي.</Fragment
    >

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'تفاعل وتجاوب سريع مع النظام',
        description:
          'نواكب كافة التحديثات في منصات الدفاع المدني في نجران لتفادي أي تأخير، مما يضمن بقاء منشأتك قانونية دائماً.',
      },
      {
        title: 'تطوير وتحديث مستمر',
        description:
          'نتابع التعديلات الدورية في اشتراطات الدفاع المدني في منطقة نجران لنقدم لك استشارات محدثة دائماً ومتوافقة مع أحدث الأنظمة.',
      },
      {
        title: 'كفاءة عالية في الوقت والموارد',
        description:
          'وفر على نفسك عناء البدء من الصفر أو مراجعة المعاملات المرفوضة في نجران؛ اطلب التجديد من توب سيفتي برو وانطلق فوراً.',
      },
      {
        title: 'حلول مبتكرة للمشاكل المعقدة',
        description: `إذا كانت منشأتك في نجران تفتقر لبعض متطلبات السلامة، نقدم لك حلولاً ذكية للتوافق مع النظام دون تكاليف باهظة أو تأخير.`,
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1552664730-d307ca884978?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'فريق عمل يتابع مشاريع السلامة في نجران',
    }}
  >
    <Fragment slot="content">مصمم خصيصاً لدعم نمو واستقرار أعمالك التجارية في نجران.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Steps
    title="احصل على ترخيص الدفاع المدني المعتمد في نجران وافتح منشأتك بأمان."
    items={[
      {
        title: 'الخطوة 1: <span class="font-medium">فحص أنظمة السلامة</span>',
        description:
          'نقوم بفحص شامل لجميع أنظمة السلامة في منشأتك في نجران، بما في ذلك أنظمة الإنذار، الإطفاء، والإخلاء، للتأكد من جاهزيتها.',
        icon: 'tabler:package',
      },
      {
        title: 'الخطوة 2: <span class="font-medium">تجهيز المستندات</span>',
        description:
          'نقوم بتجهيز جميع الأوراق المطلوبة مثل تقارير الفحص الفني، شهادات المطابقة، وعقود الصيانة بشكل احترافي في نجران.',
        icon: 'tabler:letter-case',
      },
      {
        title: 'الخطوة 3: <span class="font-medium">تقديم الطلب</span>',
        description:
          'نقوم بتقديم الطلب عبر بوابة سلامة الرسمية في نجران ومتابعته بدقة حتى صدور ترخيص الدفاع المدني الجديد.',
        icon: 'tabler:paint',
      },
      {
        title: 'الخطوة 4: <span class="font-medium">استلام الترخيص</span>',
        description:
          'نسلمك الترخيص الجديد بعد إصداره رسمياً عبر بوابة سلامة في نجران لتتمكن من مزاولة نشاطك التجاري بأمان.',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1450101499163-c8848c66ca85?ixlib=rb-4.0.3&auto=format&fit=crop&w=987&q=80',
      alt: 'إصدار ترخيص الدفاع المدني بنجاح تام في نجران',
    }}
  />

  <Features2
    title="متطلبات تجديد ترخيص الدفاع المدني في نجران"
    subtitle="نضمن لك استيفاء جميع المتطلبات والشروط اللازمة لتجديد ترخيص الدفاع المدني في نجران بنجاح وبدون أي ملاحظات"
    tagline="المتطلبات الأساسية"
    items={[
      {
        title: 'التزام بمعايير السلامة',
        description:
          'التأكد من التزام المنشأة في نجران بكافة معايير السلامة العامة وأنظمة الحماية من الحريق حسب اشتراطات الدفاع المدني.',
        icon: 'flat-color-icons:template',
      },
      {
        title: 'تراخيص سابقة صالحة',
        description:
          'مراجعة التراخيص السابقة والتأكد من صلاحيتها وعدم وجود مخالفات أو غرامات مستحقة على المنشأة في نجران.',
        icon: 'flat-color-icons:gallery',
      },
      {
        title: 'جميع المستندات المطلوبة',
        description:
          'تجهيز كافة المستندات المطلوبة مثل تقارير السلامة، شهادات المطابقة، والعقود الرسمية بشكل كامل في نجران.',
        icon: 'flat-color-icons:approval',
      },
      {
        title: 'دفع الرسوم المقررة',
        description: 'التأكد من سداد جميع الرسوم المقررة وتجديد الاشتراكات اللازمة قبل تقديم طلب التجديد في نجران.',
        icon: 'flat-color-icons:document',
      },
      {
        title: 'عقد صيانة لأنظمة السلامة',
        description: 'توفير عقد صيانة ساري المفعول لأنظمة السلامة والحريق مع مكتب هندسي معتمد في نجران.',
        icon: 'flat-color-icons:advertising',
      },
      {
        title: 'تقرير فني من الدفاع المدني',
        description: 'توفير تقرير فني معتمد من الدفاع المدني يثبت استيفاء المنشأة في نجران لاشتراطات السلامة المطلوبة.',
        icon: 'flat-color-icons:currency-exchange',
      },
      {
        title: 'شهادة الكاميرات الأمنية',
        description:
          'توفير شهادة استيفاء كاميرات المراقبة حسب متطلبات الدفاع المدني في نجران للمنشآت التجارية المحددة.',
        icon: 'flat-color-icons:voice-presentation',
      },
      {
        title: 'خطط الإخلاء والطوارئ',
        description: 'توفير خطط إخلاء وطوارئ معتمدة للمنشأة في نجران تثبت جاهزيتها للتعامل مع حالات الطوارئ.',
        icon: 'flat-color-icons:business-contact',
      },
      {
        title: 'تدريب الموظفين على السلامة',
        description: 'تقديم شهادات تدريب للموظفين على أنظمة السلامة والإخلاء في نجران حسب متطلبات الدفاع المدني.',
        icon: 'flat-color-icons:database',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <BlogLatestPosts
    title="تصفح آخر مستجدات أنظمة الدفاع المدني في نجران بالمدونة"
    information={`نشاركك دورياً شروحات مفصلة حول أنظمة الدفاع المدني واشتراطات السلامة في نجران ومنطقة نجران.
                  كل مقال جديد نطرحه يمثل خطوة هامة تمكنك من حماية منشأتك وتفادي تأخير التراخيص لتصبح خبيراً في إدارة شؤون السلامة.
                  الالتزام بالسلامة هو استثمارك الذكي. شكراً لثقتكم.
                `}
  />

  <FAQs
    title="الأسئلة الشائعة"
    subtitle="تعمق في الإجابات التالية للحصول على فهم شامل حول تجديد ترخيص الدفاع المدني في نجران وكيف يمكن لمنصتنا تسريع أعمالك التجارية."
    tagline="الأسئلة الشائعة في نجران"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'هل تقدمون الخدمة في جميع أحياء نجران؟',
        description:
          'نعم، نغطي جميع أحياء ومناطق نجران بدون استثناء، بما فيها حي الفهد، حي الورود، حي النهضة، حي العريسة، وجميع أحياء منطقة نجران.',
      },
      {
        title: 'كم يستغرق إنجاز الخدمة في نجران؟',
        description:
          'نسعى لإنجاز الخدمة في أسرع وقت ممكن، عادةً عدة أيام بعد استكمال جميع متطلبات السلامة وتجهيز المستندات. تواصل معنا للاستفسار عن الوقت المتوقع.',
      },
      {
        title: 'كيف أتواصل معكم في نجران؟',
        description:
          'يمكنك التواصل معنا عبر واتساب أو الاتصال على 0572140531 في أي وقت، وفريقنا جاهز للرد عليك ومتابعة معاملتك في نجران.',
      },
      {
        title: 'من يجب عليه تجديد ترخيص الدفاع المدني؟',
        description:
          'جميع المنشآت التجارية والصناعية والمحلات والمكاتب في نجران التي تستخدم أنظمة سلامة مثل طفايات الحريق وأنظمة الإنذار.',
      },
      {
        title: 'هل يشترط فحص معدات السلامة؟',
        description:
          'نعم، يجب التأكد من جاهزية جميع أنظمة السلامة مثل طفايات الحريق، أنظمة الإنذار، والإخلاء قبل إصدار الترخيص في نجران.',
      },
      {
        title: 'ماذا يحدث إذا انتهت صلاحية الترخيص؟',
        description:
          'قد تتعرض المنشأة في نجران للغرامات المالية أو منعها من مزاولة النشاط حتى تجديد الترخيص. لذلك ننصح دائماً بالتجديد قبل انتهاء المدة بوقت كافٍ.',
      },
    ]}
  />

  <Stats
    stats={[
      { title: 'ترخيص دفاع مدني تم تجديده في نجران', amount: '+1.8K' },
      { title: 'منشأة في نجران', amount: '+1.5K' },
      { title: 'نسبة القبول في نجران', amount: '99%' },
      { title: 'أحياء نجران المخدومة', amount: '25+' },
    ]}
  />

  <CallToAction
    id="contact"
    actions={[
      {
        variant: 'primary',
        text: 'تواصل معنا عبر الواتساب فوراً في نجران',
        href: 'https://wa.me/966572140531',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
    ]}
  >
    <Fragment slot="title"> جدد ترخيص الدفاع المدني في نجران الآن </Fragment>

    <Fragment slot="subtitle">
      لا تدع انتهاء الترخيص يعطل أعمالك التجارية في نجران ويعرضك للغرامات. <br class="hidden md:inline" />تواصل معنا
      الآن وسنتولى جميع إجراءات التجديد بسرعة واحترافية في نجران!
    </Fragment>
  </CallToAction>
</Layout>
