---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'تقرير فني بلدي معتمد لإصدار وتجديد رخص الأنشطة التجارية | توب سيفتي برو',
  description:
    'إصدار تقرير فني بلدي معتمد عبر منصة بلدي للمحلات والمنشآت التجارية والمستودعات في السعودية. فحص هندسي معتمد وسرعة في الإنجاز لتفادي الملاحظات.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'طلب تقرير فني بلدي فوراً عبر الواتساب',
        href:
          'https://wa.me/966572140531?text=' +
          encodeURIComponent('السلام عليكم، أرغب في طلب إصدار تقرير فني بلدي معتمد لمنشأتي'),
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
      { text: 'تفاصيل التقرير الهندسي', href: '#features' },
    ]}
    image={{
      src: '~/assets/images/تقرير-فني.webp',
      alt: 'نموذج إصدار تقرير فني بلدي معتمد عبر منصة بلدي للأنشطة والمحلات التجارية',
    }}
  >
    <Fragment slot="title">
      تقرير فني بلدي <span class="hidden xl:inline">معتمد</span>
      <span class="text-accent dark:text-white">للرخص التجارية الفورية وغير الفورية</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">منصة توب سيفتي برو</span> توفر لك إعداد ورفع <strong>التقرير الفني البلدي</strong> عبر مكتب
        هندسي معتمد لدى وزارة البلديات والإسكان عبر منصة بلدي (Balady)، ومنصة مدينتي لأمانة جدة، لفحص الموقع ومطابقته للاشتراطات الفنية والبلدية وكود البناء السعودي.</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">اعتماد مباشر عبر منصة بلدي لجميع الأنشطة.</span>
      خدمات هندسية متكاملة تغطي كافة مناطق وأمانات المملكة:
      <a href="/تقرير-فني-سلامة-الرياض" class="text-primary hover:underline font-semibold">الرياض</a>،
      <a href="/تقرير-فني-سلامة-جدة" class="text-primary hover:underline font-semibold">جدة</a>،
      <a href="/تقرير-فني-سلامة-مكة" class="text-primary hover:underline font-semibold">مكة المكرمة</a>،
      <a href="/تقرير-فني-سلامة-الدمام" class="text-primary hover:underline font-semibold">الدمام</a>،
      <a href="/تقرير-فني-سلامة-المدينة" class="text-primary hover:underline font-semibold">المدينة المنورة</a>،
      <a href="/تقرير-فني-سلامة-الخبر" class="text-primary hover:underline font-semibold">الخبر</a>،
      <a href="/تقرير-فني-سلامة-الطائف" class="text-primary hover:underline font-semibold">الطائف</a>،
      <a href="/تقرير-فني-سلامة-القصيم" class="text-primary hover:underline font-semibold">القصيم</a>،
      <a href="/تقرير-فني-سلامة-تبوك" class="text-primary hover:underline font-semibold">تبوك</a>،
      <a href="/تقرير-فني-سلامة-أبها" class="text-primary hover:underline font-semibold">أبها</a>،
      <a href="/تقرير-فني-سلامة-حائل" class="text-primary hover:underline font-semibold">حائل</a>،
      <a href="/تقرير-فني-سلامة-جازان" class="text-primary hover:underline font-semibold">جازان</a>،
      و<a href="/تقرير-فني-سلامة-نجران" class="text-primary hover:underline font-semibold">نجران</a>.
    </Fragment>
  </Hero>

  <Note
    title="اعتماد رسمي:"
    description="تقارير هندسية معتمدة ومرفوعة مباشرة على منصة بلدي تضمن قبول معاملتك لإصدار أو تجديد الرخصة دون تأخير"
  />

  <Features
    id="features"
    tagline="متطلبات واشتراطات بلدي"
    title="لماذا تحتاج إلى تقرير فني بلدي لمنشأتك؟"
    subtitle="يعد التقرير الفني متطلباً رئيسياً لدى أمانات المناطق ووزارة البلديات والإسكان للتحقق من سلامة الموقع وملاءمته لمزاولة النشاط التجاري."
    items={[
      {
        title: 'مكتب هندسي معتمد في بلدي',
        description:
          'نعمل كمكتب هندسي مصنف ومعتمد لدى منصة بلدي ووزارة البلديات، مما يضمن رفع التقرير بالنظام مباشرة وقبوله رسمياً.',
        icon: 'tabler:certificate',
      },
      {
        title: 'مطابقة كود البناء السعودي (SBC)',
        description:
          'فحص شامل للسلامة الإنشائية والمعمارية والميكانيكية والتأكد من توافق المبنى مع متطلبات كود البناء واشتراطات الأمانة.',
        icon: 'tabler:building',
      },
      {
        title: 'فحص الموقع والارتدادات',
        description:
          'معاينة دقيقة لمساحة المحل، الواجهات، مواقف السيارات، والارتدادات النظامية المطلوبة للنشاط التجاري المحدد.',
        icon: 'tabler:ruler-measure',
      },
      {
        title: 'ربط مباشر مع تراخيص الدفاع المدني',
        description:
          'تجهيز متطلبات السلامة بالتوازي للمساعدة في استخراج <a href="/شهاده-سلامه" class="text-primary hover:underline font-medium">شهادة سلامة معتمدة</a> لإنهاء الترخيص التجاري كاملاً.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'سرعة الإنجاز والرفع الإلكتروني',
        description:
          'زيارة ميدانية سريعة وتوثيق فوري مع رفع التقرير على نظام بلدي في وقت قياسي لتفادي إيقاف الخدمات أو تعطيل النشاط.',
        icon: 'tabler:rocket',
      },
      {
        title: 'تغطية شاملة لجميع الأنشطة',
        description:
          'خدماتنا تشمل المحلات التجارية، المطاعم والمقاهي، المستودعات، الورش، المكاتب، والمراكز الطبية والتعليمية.',
        icon: 'tabler:map-pin',
      },
    ]}
  />

  <Content
    isReversed
    tagline="المطابقة الهندسية"
    title="فحص فني دقيق يضمن صدور رخصتك البلدية فوراً"
    items={[
      {
        title: 'التحقق من النشاط التجاري وتصنيف آيزك (ISIC)',
        description:
          'مطابقة النشاط الممارس فعلياً مع مسميات الأنشطة المعتمدة في منصة بلدي وتحديد الاشتراطات الخاصة بالنشاط.',
      },
      {
        title: 'مراجعة المخططات المعمارية والإنشائية',
        description:
          'مطابقة الواقع بالمخططات الهندسية المعتمدة للمبنى والتأكد من عدم وجود تعديلات إنشائية غير نظامية.',
      },
      {
        title: 'استيفاء اشتراطات اللوحات والواجهات',
        description:
          'التأكد من التزام واجهة المحل واللوحة الإعلانية بالدليل التنظيمي المعتمد من الأمانة البلدية التابع لها الموقع.',
      },
    ]}
    image={{
      src: '~/assets/images/تقرير-فني.webp',
      alt: 'فحص هندسي للمحلات والمنشآت لإصدار تقرير فني بلدي معتمد',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">تجنب ملاحظات الرفض البلدية</h3>
      نحرص في توب سيفتي برو على فحص كافة التفاصيل الفنية مسبقاً، لمساعدتك في <a
        href="/تجديد-رخصة-البلدية"
        class="text-primary hover:underline font-semibold">تجديد رخصة البلدية</a
      > أو إصدار رخصة جديدة بسلاسة تامة.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isAfterContent
    items={[
      {
        title: 'تقارير فنية فورية وغير فورية',
        description: `نوفر إصدار <a href="/تقرير-فني-فوري" class="text-primary hover:underline font-medium">تقرير فني فوري</a> للأنشطة منخفضة الخطورة، وإعداد تقارير فنية موسعة للأنشطة غير الفورية التي تتطلب موافقات خاصة.`,
      },
      {
        title: 'معالجة ملاحظات التفتيش البلدي',
        description: 'في حال وجود إنذار أو ملاحظة من مراقبي البلدية، نقوم بإعادة الكشف وتصحيح الملاحظات وإعداد التقرير الفني لتسوية المخالفة.',
      },
      {
        title: 'توفير عقود الخدمات المكملة',
        description: 'نوفر أيضاً المتطلبات البلدية المصاحبة مثل <a href="/عقد-نظافة-جدة" class="text-primary hover:underline font-medium">عقد نظافة معتمد عبر منصة مدينتي</a> للمنشآت في محافظة جدة ومختلف المدن.',
      },
      {
        title: 'اعتماد رسمي موثق عبر منصة بلدي',
        description: 'يتم تسليم رقم المعاملة والتقرير الفني الهندسي الموثق برقم كودي معتمد للتحقق السريع من صحته على منصة بلدي.',
      },
    ]}
    image={{
      src: '~/assets/images/تقرير-فني-1.webp',
      alt: 'تقرير فني بلدي موثق ومطابق لاشتراطات وزارة البلديات والإسكان',
    }}
  >
    <Fragment slot="content">حلول هندسية متكاملة لجميع معاملات أمانات وبلديات المملكة.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'ملاءمة الموقع وموافقات الجهات المساندة',
        description: 'التأكد من خلو الموقع من أي تعارض مع خطوط التنظيم والمرافق العامة وتوافق الموقع مع اشتراطات الدفاع المدني.',
      },
      {
        title: 'فحص مخرج الطوارئ والتهوية الميكانيكية',
        description:
          'تقييم مسارات الخروج والتهوية والإضاءة الطبيعية والصناعية حسب كود البناء واشتراطات الصحة المهنية.',
      },
      {
        title: 'دعم هندسي حتى صدور الرخصة',
        description: 'مهندسونا يتابعون معاملتك خطوة بخطوة حتى اعتماد التقرير وصدور رخصتك التجارية دون أي عوائق.',
      },
      {
        title: 'خبرة تراكمية بمتطلبات جميع الأمانات',
        description: `دراية تامة باشتراطات أمانة منطقة الرياض، أمانة جدة، أمانة العاصمة المقدسة، أمانة المنطقة الشرقية، وكافة الأمانات الفرعية.`,
      },
    ]}
    image={{
      src: '~/assets/images/رخصه-البلدية.webp',
      alt: 'رخصة تجارية صادرة بعد اعتماد التقرير الفني البلدي',
    }}
  >
    <Fragment slot="content">نرافقك من الفحص الميداني وحتى استلام رخصتك التجارية الجاهزة.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Steps
    title="خطوات إصدار التقرير الفني البلدي عبر توب سيفتي برو"
    items={[
      {
        title: 'الخطوة 1: <span class="font-medium">تقديم الطلب وتزويد البيانات</span>',
        description: 'تواصل معنا وزوّدنا برقم السجل التجاري، موقع المنشأة (العنوان الوطني)، ونوع النشاط التجاري المستهدف.',
        icon: 'tabler:clipboard-text',
      },
      {
        title: 'الخطوة 2: <span class="font-medium">المعاينة الهندسية للموقع</span>',
        description:
          'يقوم المهندس المختص بزيارة المنشأة وتوثيق أبعاد المحل، وسائل السلامة، واشتراطات كود البناء والأمانة.',
        icon: 'tabler:scan',
      },
      {
        title: 'الخطوة 3: <span class="font-medium">إعداد التقرير والمطابقة الفنية</span>',
        description: 'صياغة التقرير الهندسي وتجهيز المرفقات والمخططات اللازمة مع توقيع واعتماد المكتب الهندسي.',
        icon: 'tabler:file-certificate',
      },
      {
        title: 'الخطوة 4: <span class="font-medium">الرفع والاعتماد على منصة بلدي</span>',
        description: 'رفع التقرير مباشرة إلى حساب المنشأة في منصة بلدي وتزويدك برقم الاعتماد لإتمام إصدار رخصتك فوراً.',
        icon: 'tabler:circle-check',
      },
    ]}
    image={{
      src: '~/assets/images/رقم_التقرير_الفني.webp',
      alt: 'خطوات اعتماد رقم التقرير الفني عبر منصة بلدي',
    }}
  />

  <Features2
    title="ما يشتمل عليه التقرير الفني البلدي"
    subtitle="فحص وتوثيق شامل يغطي جميع الجوانب المعمارية والإنشائية والبيئية المطلوبة لاعتماد الرخص"
    tagline="محتويات التقرير"
    items={[
      {
        title: 'السلامة الإنشائية للمبنى',
        description: 'التأكد من متانة الهيكل الإنشائي وعدم وجود تشققات أو تعديلات تؤثر على السلامة العامة.',
        icon: 'tabler:building-warehouse',
      },
      {
        title: 'مساحة المحل والارتفاعات',
        description: 'قياس المساحة الإجمالية والارتفاعات الداخلية والتأكد من مطابقتها للحد الأدنى المسموح به لنشاطك.',
        icon: 'tabler:ruler-measure',
      },
      {
        title: 'مواقف السيارات والارتدادات',
        description: 'مراجعة توفر المواقف المطلوبة والالتزام بالارتدادات النظامية المعتمدة وفق كود البناء.',
        icon: 'tabler:car',
      },
      {
        title: 'اشتراطات اللوحات الإعلانية',
        description: 'فحص أبعاد لوحة المحل وموقعها ومطابقتها للمعايير البصرية المعتمدة من الأمانة البلدية.',
        icon: 'tabler:news',
      },
      {
        title: 'العزل ومخارج الطوارئ',
        description: 'التأكد من عزل التمديدات الكهربائية ووضوح مخارج الطوارئ ومسارات الهروب الآمنة.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'التهوية والتكييف والإضاءة',
        description: 'فحص كفاءة فتحات التهوية وأنظمة التكييف والإنارة الكافية لبيئة العمل.',
        icon: 'tabler:wind',
      },
      {
        title: 'اشتراطات ذوي الإعاقة (الوصول الشامل)',
        description: 'التأكد من توفير المنحدرات والمداخل الملائمة لذوي الاحتياجات الخاصة وفق الاشتراطات البلدية.',
        icon: 'tabler:disabled',
      },
      {
        title: 'تحديد الملاحظات الهندسية',
        description: 'تقديم حلول وتوصيات فورية لأي ملاحظة فنية قبل الرفع النهائي على النظام لتجنب الرفض.',
        icon: 'tabler:tools',
      },
      {
        title: 'الاعتماد والختم الهندسي الرقمي',
        description: 'ختم وتصديق التقرير من مهندس معتمد مع إرفاق ترخيص المكتب الهندسي المعتمد.',
        icon: 'tabler:certificate',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <BlogLatestPosts
    title="مقالات وإرشادات حول رخص بلدي والتقارير الفنية"
    information={`تعرف على أحدث تحديثات منصة بلدي، الفرق بين التقارير الفورية وغير الفورية، وكيفية تجنب مخالفات الرخص التجارية عبر مقالاتنا التخصصية.
                `}
  />

  <FAQs
    title="الأسئلة الشائعة حول التقرير الفني البلدي"
    subtitle="إجابات وافية ومفصلة حول متطلبات منصة بلدي والتقارير الفنية الهندسية للرخص التجارية"
    tagline="الأسئلة الشائعة"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'ما هو التقرير الفني البلدي ولماذا يُطلب؟',
        description:
          'التقرير الفني البلدي هو وثيقة هندسية رسمية تصدر من مكتب استشاري هندسي معتمد عبر منصة بلدي، تؤكد معاينة الموقع ومطابقته لكود البناء السعودي والاشتراطات البلدية الخاصة بالنشاط التجاري المراد ترخيصه.',
      },
      {
        title: 'متى يلزم استخراج تقرير فني بلدي؟',
        description:
          'يلزم عند إصدار رخصة تجارية جديدة للأنشطة غير الفورية، أو عند تعديل النشاط، نقل مقر المحل، توسعة المساحة، أو عند طلب الأمانة تقريراً لمعالجة ملاحظات رقابية على المنشأة.',
      },
      {
        title: 'هل التقرير مقبول لدى كافة أمانات وبلديات المملكة؟',
        description:
          'نعم، مكاتبنا الهندسية معتمدة ومصنفة رسمياً في منصة بلدي وتغطي كافة أمانات المملكة (الرياض، جدة، العاصمة المقدسة، الشرقية، عسير، القصيم، وغيرها) والتقارير ترفع مباشرة عبر النظام.',
      },
      {
        title: 'كم يستغرق إصدار ورفع التقرير الفني على منصة بلدي؟',
        description:
          'يتم إجراء الفحص الميداني ورفع التقرير على منصة بلدي خلال 24 إلى 48 ساعة من تاريخ المعاينة واستلام كافة المستندات المطلوبة، كما نوفر خدمة التقارير الفورية للحالات العاجلة.',
      },
      {
        title: 'ما هي المستندات المطلوبة لإعداد التقرير الفني؟',
        description:
          'المستندات الأساسية تشمل: السجل التجاري الساري، العنوان الوطني للموقع، عقد الإيجار أو صك الملكية، ورخصة البناء أو مخططات المبنى إن وجدت، إضافة إلى صور واضحة للموقع واللوحة الخارجية.',
      },
      {
