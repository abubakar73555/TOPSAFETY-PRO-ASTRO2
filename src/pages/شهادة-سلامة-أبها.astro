    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isAfterContent
    items={[
      {
        title: 'شهادة معتمدة لجميع الأنشطة',
        description: `نصدر شهادة تركيب أدوات السلامة لجميع أنواع الأنشطة التجارية والصناعية في أبها، من المحلات البسيطة إلى المصانع الكبرى.`,
