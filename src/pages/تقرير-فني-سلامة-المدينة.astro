---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'تقرير فني سلامة في المدينة المنورة 0572140531',
  description:
    'خدمة متكاملة لإعداد تقرير فني سلامة في المدينة المنورة بسرعة واحترافية مع تجهيز جميع المستندات المطلوبة.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'طلب تقرير فني في المدينة المنورة فوراً',
        href: '#contact',
        icon: 'tabler:file-text',
      },
      { text: 'إكتشف خدماتنا', href: '#features' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'توب سيفتي برو لإصدار التقارير الفنية في المدينة المنورة' }}
  >
    <Fragment slot="title">
      تقرير فني سلامة في <span class="hidden xl:inline">المدينة المنورة</span>
      <span class="text-accent dark:text-white">المنطقة الغربية</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">منصة توب سيفتي برو</span> تقدم لك إصدار التقارير الفنية الفورية وغير الفورية في المدينة
        المنورة لتجديد رخصة البلدية والدفاع المدني بسرعة واحترافية.</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">توب سيفتي برو: اعتماد فوري في المدينة المنورة.</span>
      نخدم جميع أحياء المدينة المنورة: العوالي، قباء، الحرة الغربية، العزيزية، وجميع أحياء المنطقة الغربية.
