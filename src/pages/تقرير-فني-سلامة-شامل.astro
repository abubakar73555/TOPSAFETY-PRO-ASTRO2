---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'رقم التقرير الفني - توب سيفتي برو',
  description:
    'خدمة متكاملة لإصدار رقم التقرير الفني عبر بوابة سلامة بسرعة واحترافية مع تجهيز جميع المستندات المطلوبة.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'احصل على تقريرك الفني الآن',
        href: '#contact',
        icon: 'tabler:file-text',
      },
      { text: 'إكتشف خدماتنا', href: '#features' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'توب سيفتي برو لإصدار التقارير الفنية الفورية وغير الفورية' }}
  >
    <Fragment slot="title">
      تقرير فني سلامة <span class="hidden xl:inline">فوري وغير فوري</span>
      <span class="text-accent dark:text-white">عبر بوابة سلامة</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">منصة توب سيفتي برو</span> تقدم لك إصدار التقارير الفنية الفورية وغير الفورية لتجديد رخصة
        البلدية والدفاع المدني عبر بوابة سلامة بسرعة واحترافية.</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">توب سيفتي برو: اعتماد فوري.</span>
      مكتب هندسي معتمد من الدفاع المدني، نخدم جميع مدن المملكة العربية السعودية.
    </Fragment>
  </Hero>

  <Note
    title="فلسفتنا:"
    description="السرعة الفائقة، الالتزام بالمعايير، وتسهيل الإجراءات النظامية لعملائنا عبر بوابة سلامة"
  />

  <Features
    id="features"
    tagline="المميزات والخدمات"
    title="ما ستحصل عليه مع توب سيفتي برو"
    subtitle="واحدة من أفضل الخدمات الهندسية المتكاملة في السوق السعودي لإصدار التقارير الفنية بامتثال كامل لكود البناء واشتراطات الدفاع المدني."
    items={[
      {
        title: 'مكتب هندسي معتمد من الدفاع المدني',
        description:
          'نحن مكتب هندسي متخصص بمجال السلامة من الحريق معتمد من قبل إدارة الدفاع المدني، مما يضمن قبول تقاريرك رسمياً.',
        icon: 'tabler:brand-tailwind',
      },
      {
        title: 'تقارير فورية وغير فورية',
        description:
          'نقدم جميع أنواع التقارير الفنية: التقارير الفورية للأنشطة الصغيرة، والتقارير غير الفورية للمنشآت المتوسطة والكبيرة.',
        icon: 'tabler:components',
      },
      {
        title: 'ربط مباشر مع بوابة سلامة',
        description: 'نصدر تقاريرك الفنية مباشرة عبر بوابة سلامة ومنصة بلدي، مما يضمن قبولها فوراً دون أي ملاحظات.',
        icon: 'tabler:list-check',
      },
      {
        title: 'سرعة في الإنجاز',
        description: 'نضمن لك إصدار التقرير الفني في نفس اليوم للتقارير الفورية، وفي أيام معدودة للتقارير غير الفورية.',
        icon: 'tabler:rocket',
      },
      {
        title: 'أسعار تنافسية',
        description: 'نقدم أفضل الأسعار في السوق مع الحفاظ على أعلى مستويات الجودة والاحترافية في إعداد التقارير.',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'تغطية جميع مدن المملكة',
        description:
          'نخدم جميع مدن المملكة العربية السعودية: جدة، الرياض، مكة، الدمام، المدينة، الطائف، الخبر، القصيم، تبوك، أبها، حائل، جازان، نجران.',
        icon: 'tabler:bulb',
      },
    ]}
  />

  <Content
    isReversed
    tagline="داخل الخدمة"
    title="بوابة سلامة: منصة رقمية لتعزيز الكفاءة والشفافية"
    items={[
      {
        title: 'ما هي بوابة سلامة؟',
        description:
          'بوابة سلامة هي منصة رقمية أطلقتها المملكة العربية السعودية لتوفير مجموعة من الخدمات الإلكترونية المتعلقة بالأمان والسلامة العامة، تهدف إلى تسهيل عملية التواصل بين الأفراد والجهات الحكومية.',
      },
      {
        title: 'رقم التقرير الفني',
        description:
          'رقم التقرير الفني هو رقم مرجعي فريد يتم إصداره لكل تقرير فني من قبل مكتب هندسي معتمد من الدفاع المدني، يُستخدم في بوابة سلامة لتجديد رخصة البلدية.',
      },
      {
        title: 'أهمية رقم التقرير الفني',
        description:
          'يسهل عملية تتبع التقارير الفنية ومراجعتها من قبل الجهات المعنية، ويعزز الشفافية في عملية إصدار وتجديد الرخص، ويحسن كفاءة العملية من خلال تسهيل الوصول إلى المعلومات الفنية.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'بوابة سلامة الإلكترونية',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        متطلبات الحصول على رقم التقرير الفني
      </h3>
      الرقم الموحد للمنشأة، رقم السجل التجاري، المنطقة والمدينة والحي، الشارع ورقم المبنى، عدد الأدوار والفتحات، المساحة طبقاً
      لعقد الإيجار، رقم الجوال والإيميل، ورقم نشاط الإيزك.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isAfterContent
    items={[
      {
        title: 'تقرير سلامة الدفاع المدني',
        description: `يعد إعداد تقرير سلامة من قبل جهة معتمدة لدى الدفاع المدني خطوة ضرورية لضمان أن المنشأة تلتزم بأعلى معايير السلامة والأمان. يقدم التقرير تحليلاً شاملاً لأجهزة وأنظمة الوقاية المتوفرة في المنشأة.`,
      },
      {
        title: 'تقرير فني بلدي',
        description:
          'إصدار رخصة البلدية عبر موقع "بلدي" يتطلب تقديم تقرير فني بلدي لضمان مطابقة المنشأة للمعايير واللوائح الفنية. يتضمن التقرير مراجعة المخططات الهندسية والبنية التحتية.',
      },
      {
        title: 'تقرير ملائمة',
        description:
          'يُعد إعداد تقرير ملائمة لأدوات السلامة من الحريق جزءاً أساسياً لضمان التزام المنشآت التجارية بالاشتراطات والمعايير التي يحددها الدفاع المدني.',
      },
      {
        title: 'تقرير فني غير فوري',
        description:
          'يُعتبر التقرير الفني غير الفوري من أهم الوثائق المطلوبة لضمان التزام المنشآت التجارية والصناعية بمعايير الوقاية والحماية من الحريق. يتم إصداره عبر بوابة سلامة بالتعاون مع مكاتب هندسية معتمدة.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1581094794329-c8112a89af12?ixlib=rb-4.0.3&auto=format&fit=crop&w=2194&q=80',
      alt: 'أنواع التقارير الفنية',
    }}
  >
    <Fragment slot="content">نضمن لك الحصول على جميع أنواع التقارير الفنية المعتمدة بسرعة واحترافية.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'تقرير فني فوري',
        description:
          'يُعد إصدار تقرير فني فوري أحد الركائز الأساسية لضمان التزام المنشآت بمتطلبات الوقاية والحماية من الحريق. يتم إعداد التقرير بشكل فوري وآلي عبر بوابة سلامة.',
      },
      {
        title: 'عناصر التقرير الفني الفوري',
        description:
          'يشمل التقرير: طفايات الحريق، أجهزة كشف الدخان، أنظمة الإنذار والطوارئ، أنظمة الإطفاء، والإشارات الإرشادية لمخارج الطوارئ.',
      },
      {
        title: 'مميزات التقرير الفني الفوري',
        description:
          'الدقة والسرعة في الإعداد، الاعتماد على التكنولوجيا، شفافية العملية، ويُعتبر أحد المتطلبات الأساسية لإصدار أو تجديد تراخيص الدفاع المدني.',
      },
      {
        title: 'خطوات إصدار وتجديد الرخص',
        description:
          'تقديم الطلب عبر بوابة سلامة، إعداد التقرير الفني، منح رقم التقرير الفني، المراجعة والموافقة، ثم إصدار الرخصة البلدية.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1581092160607-ee22621dd758?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'التقرير الفني الفوري',
    }}
  >
    <Fragment slot="content">نوفر لك جميع أنواع التقارير الفنية بسرعة واحترافية في جميع مدن المملكة.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Steps
    title="احصل على تقريرك الفني المعتمد وافتح منشأتك في أسرع وقت."
    items={[
      {
        title: 'الخطوة 1: <span class="font-medium">تقديم الطلب</span>',
        description:
          'يدخل المستخدم إلى بوابة سلامة ويقدم طلباً لإصدار أو تجديد الرخصة، أو يتواصل معنا مباشرة عبر الواتساب.',
        icon: 'tabler:package',
      },
      {
        title: 'الخطوة 2: <span class="font-medium">إعداد التقرير الفني</span>',
        description:
          'يتم تكليف الجهة المختصة بإعداد تقرير فني يشمل فحص المنشأة والتأكد من استيفاء جميع اشتراطات السلامة.',
        icon: 'tabler:letter-case',
      },
      {
        title: 'الخطوة 3: <span class="font-medium">منح رقم التقرير الفني</span>',
        description: 'بعد إعداد التقرير يتم منحه رقم مرجعي فريد، ويتم إدخاله في بوابة سلامة ومنصة بلدي.',
        icon: 'tabler:paint',
      },
      {
        title: 'الخطوة 4: <span class="font-medium">إصدار الرخصة</span>',
        description:
          'تقوم الجهات المعنية بمراجعة التقرير واتخاذ القرار، وفي حال الموافقة يتم إصدار الرخصة البلدية عبر بوابة سلامة.',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1450101499163-c8848c66ca85?ixlib=rb-4.0.3&auto=format&fit=crop&w=987&q=80',
      alt: 'خطوات إصدار التقرير الفني',
    }}
  />

  <Features2
    title="أنواع التقارير الفنية التي نقدمها"
    subtitle="نقدم جميع أنواع التقارير الفنية المعتمدة من الدفاع المدني والبلدية لتلبية جميع احتياجاتك"
    tagline="خدماتنا الشاملة"
    items={[
      {
        title: 'تقرير فني فوري',
        description:
          'تقرير فني للأنشطة الفورية ذات المساحة الصغيرة (أقل من 150 متراً في الغالب)، يُصدر بشكل فوري وآلي عبر بوابة سلامة.',
        icon: 'flat-color-icons:template',
      },
      {
        title: 'تقرير فني غير فوري',
        description:
          'تقرير فني يتطلب فحصاً ميدانياً وعقد صيانة مرتبطاً به، يُصدر بعد التأكد من جاهزية المنشأة للمنشآت المتوسطة والكبيرة.',
        icon: 'flat-color-icons:gallery',
      },
      {
        title: 'تقرير فني بلدي',
        description:
          'تقرير فني لإصدار رخصة البلدية عبر موقع "بلدي"، يتضمن مراجعة المخططات الهندسية والبنية التحتية للتأكد من التزام المنشأة بالأنظمة.',
        icon: 'flat-color-icons:approval',
      },
      {
        title: 'تقرير ملائمة',
        description:
          'تقرير يهدف إلى تقييم مدى تطابق الموقع مع متطلبات السلامة اللازمة وفقاً لنوع النشاط، وضمان وجود أنظمة فعالة للحماية من الحريق.',
        icon: 'flat-color-icons:document',
      },
      {
        title: 'تقرير سلامة الدفاع المدني',
        description:
          'تقرير سلامة من قبل جهة معتمدة لدى الدفاع المدني، يقدم تحليلاً شاملاً لأجهزة وأنظمة الوقاية المتوفرة في المنشأة.',
        icon: 'flat-color-icons:advertising',
      },
      {
        title: 'شهادة تركيب أدوات الوقاية',
        description:
          'شهادة تركيب أدوات الوقاية والحماية من الحريق بعد التأكد من جاهزية جميع الأنظمة واستيفاء الاشتراطات.',
        icon: 'flat-color-icons:currency-exchange',
      },
      {
        title: 'عقود صيانة أنظمة السلامة',
        description:
          'عقود صيانة معتمدة لأنظمة السلامة مع مكتب هندسي معتمد من الدفاع المدني، مطلوبة للتقارير غير الفورية.',
        icon: 'flat-color-icons:voice-presentation',
      },
      {
        title: 'شهادة استيفاء كاميرات المراقبة',
        description: 'شهادة استيفاء كاميرات المراقبة حسب متطلبات البلدية للمنشآت التجارية، مطلوبة لبعض أنواع التراخيص.',
        icon: 'flat-color-icons:business-contact',
      },
      {
        title: 'استشارات هندسية وقائية',
        description:
          'استشارات هندسية وقائية للمنشآت لضمان الامتثال الكامل لاشتراطات السلامة وتجنب أي مخالفات أو غرامات.',
        icon: 'flat-color-icons:database',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <BlogLatestPosts
    title="تصفح آخر مستجدات اشتراطات السلامة بالمدونة"
    information={`نشاركك دورياً شروحات مفصلة حول كود البناء السعودي واشتراطات منصة بلدي والدفاع المدني وبوابة سلامة.
                  كل مقال جديد نطرحه يمثل خطوة هامة تمكنك من حماية منشأتك وتفادي تأخير التراخيص لتصبح خبيراً في إدارة شؤون منشأتك.
                  الوقاية هي استثمارك الذكي. شكراً لثقتكم.
                `}
  />

  <FAQs
    title="الأسئلة الشائعة"
    subtitle="تعمق في الإجابات التالية للحصول على فهم شامل حول التقارير الفنية وكيف يمكن لمنصتنا تسريع أعمالك التجارية."
    tagline="الأسئلة الشائعة"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'ما هو رقم التقرير الفني؟',
        description:
          'رقم التقرير الفني هو رقم مرجعي فريد يتم إصداره لكل تقرير فني من قبل مكتب هندسي معتمد من الدفاع المدني، يُستخدم في بوابة سلامة لتجديد رخصة البلدية.',
      },
      {
        title: 'ما الفرق بين التقرير الفوري وغير الفوري؟',
        description:
          'التقرير الفوري للأنشطة الفورية ذات المساحة الصغيرة (أقل من 150 متراً في الغالب)، أما غير الفوري فيتطلب فحصاً ميدانياً وعقد صيانة مرتبطاً به ويُصدر بعد التأكد من جاهزية المنشأة.',
      },
      {
        title: 'من يصدر التقرير الفني؟',
        description:
          'يصدر التقرير الفني مكتب هندسي متخصص بمجال السلامة من الحريق معتمد من قبل إدارة الدفاع المدني. نحن مؤهلون من الدفاع المدني كمكتب هندسي ونوفر لك ما تحتاجه لإصدار رخصتك بكل سهولة.',
      },
      {
        title: 'هل التقرير الفني مطلوب لتجديد رخصة البلدية؟',
        description:
          'نعم، عند تجديد رخصة بلدي لنشاط غير فوري يطلب منك تقرير فني، وعند إصدار رخصة جديدة أو تجديد نشاط فوري يطلب رقم التقرير الفني.',
      },
      {
        title: 'ما هي متطلبات الحصول على رقم التقرير الفني؟',
        description:
          'الرقم الموحد للمنشأة، رقم السجل التجاري، بيانات الموقع (المنطقة، المدينة، الحي، الشارع)، عدد الأدوار والفتحات، المساحة طبقاً لعقد الإيجار الموثق، رقم الجوال، الإيميل، ورقم نشاط الإيزك.',
      },
      {
        title: 'ما هو تقرير الملائمة؟',
        description:
          'تقرير ملائمة هو تقرير يهدف إلى تقييم مدى تطابق الموقع مع متطلبات السلامة اللازمة وفقاً لنوع النشاط، وضمان وجود أنظمة فعالة للحماية من الحريق وفق متطلبات الدفاع المدني.',
      },
    ]}
  />

  <Stats
    stats={[
      { title: 'تقرير فني صادر', amount: '+10K' },
      { title: 'منشأة تم تأمينها', amount: '+8K' },
      { title: 'تقييمات إيجابية', amount: '100%' },
      { title: 'مدن المملكة المخدومة', amount: '13+' },
    ]}
  />

  <CallToAction
    id="contact"
    actions={[
      {
        variant: 'primary',
        text: 'تواصل معنا عبر الواتساب فوراً',
        href: 'https://wa.me/966572140531',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
    ]}
  >
    <Fragment slot="title"> احصل على تقريرك الفني الآن </Fragment>

    <Fragment slot="subtitle">
      نحن مكتب هندسي معتمد من الدفاع المدني، نوفر لك جميع أنواع التقارير الفنية بسرعة واحترافية في جميع مدن المملكة. <br
        class="hidden md:inline"
      />تواصل معنا الآن!
    </Fragment>
  </CallToAction>
</Layout>
