---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'تقرير فني سلامة في الرياض 0572140531',
  description: 'خدمة متكاملة لإعداد تقرير فني سلامة في الرياض بسرعة واحترافية مع تجهيز جميع المستندات المطلوبة.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'طلب تقرير فني في الرياض فوراً',
        href: '#contact',
        icon: 'tabler:file-text',
      },
      { text: 'إكتشف خدماتنا', href: '#features' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'توب سيفتي برو لإصدار التقارير الفنية في الرياض' }}
  >
    <Fragment slot="title">
      تقرير فني سلامة في <span class="hidden xl:inline">الرياض</span>
      <span class="text-accent dark:text-white">المنطقة الوسطى</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">منصة توب سيفتي برو</span> تقدم لك إصدار التقارير الفنية الفورية وغير الفورية في الرياض
        لتجديد رخصة البلدية والدفاع المدني بسرعة واحترافية.</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">توب سيفتي برو: اعتماد فوري في الرياض.</span>
      نخدم جميع أحياء الرياض: حي العليا، حي النخيل، حي الملقا، حي الروضة، حي السليمانية، وجميع أحياء المنطقة الوسطى.
    </Fragment>
  </Hero>

  <Note
    title="فلسفتنا:"
    description="السرعة الفائقة، الالتزام بالمعايير، وتسهيل الإجراءات النظامية لعملائنا في الرياض"
  />

  <Features
    id="features"
    tagline="المميزات والخدمات في الرياض"
    title="ما ستحصل عليه مع توب سيفتي برو في الرياض"
    subtitle="واحدة من أفضل الخدمات الهندسية المتكاملة في الرياض لإصدار شهادات وتراخيص السلامة بامتثال كامل لكود البناء."
    items={[
      {
        title: 'خبرة واسعة في سوق الرياض',
        description:
          'لدينا خبرة واسعة في سوق الرياض والمنطقة الوسطى، ونفهم تماماً متطلبات البلديات والدفاع المدني في المنطقة.',
        icon: 'tabler:brand-tailwind',
      },
      {
        title: 'تقارير جاهزة للاستخدام',
        description:
          'نماذج وتقارير هندسية معتمدة ومختومة تناسب كافة الأنشطة التجارية في الرياض؛ من المحلات البسيطة إلى المجمعات الضخمة.',
        icon: 'tabler:components',
      },
      {
        title: 'معتمدون من الدفاع المدني',
        description: 'نحن مكتب هندسي معتمد من الدفاع المدني، مما يضمن قبول تقاريرك بشكل رسمي وسريع في جميع الجهات.',
        icon: 'tabler:list-check',
      },
      {
        title: 'سرعة في الإنجاز',
        description:
          'نضمن لك إصدار التقرير الفني في الرياض في نفس اليوم للتقارير الفورية، وفي أيام معدودة للتقارير غير الفورية.',
        icon: 'tabler:rocket',
      },
      {
        title: 'أسعار تنافسية',
        description: 'نقدم أفضل الأسعار في سوق الرياض مع الحفاظ على أعلى مستويات الجودة والاحترافية في إعداد التقارير.',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'تغطية جميع أحياء الرياض',
        description:
          'نخدم جميع أحياء ومناطق الرياض بدون استثناء، بما فيها حي العليا، النخيل، الملقا، الروضة، السليمانية، وغيرها.',
        icon: 'tabler:bulb',
      },
    ]}
  />

  <Content
    isReversed
    tagline="داخل الخدمة في الرياض"
    title="مخطط توب سيفتي برو في الرياض: دقة التنفيذ تلتقي مع معايير السلامة!"
    items={[
      {
        title: 'الاعتماد على كود البناء السعودي',
        description:
          'نصيغ تقاريرنا في الرياض استناداً إلى أحدث الأنظمة واللوائح المعتمدة بالمملكة لضمان جودة هندسية لا غبار عليها.',
      },
      {
        title: 'تنسيق متوافق مع كود Tailwind CSS v4',
        description:
          'تم بناء المنصة بأحدث التقنيات البرمجية لضمان تصفح سريع جداً وخفيف لعملائنا في الرياض من الجوال أو الكمبيوتر.',
      },
      {
        title: 'توافق شامل ومتكامل',
        description:
          'نضمن أن تقاريرنا ومخططاتنا في الرياض تكون متوافقة ومفهومة لدى كافة الجهات الميدانية والإلكترونية المعنية بالترخيص.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'فريق هندسي يفحص وسائل سلامة في الرياض',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        التأسيس على قواعد هندسية حديثة في الرياض
      </h3>
      احصل على الأفضلية النظامية في الرياض من خلال تطبيق أفضل ممارسات الوقاية والحماية المعتمدة.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isAfterContent
    items={[
      {
        title: 'مرونة وتخصيص لا محدود',
        description: `نقوم بتطويع التقرير الفني ليتناسب تماماً مع متطلبات وهوية نشاطك التجاري في الرياض، مما يحميك ويختصر وقتك وجهدك.`,
      },
      {
        title: 'خيارات متعددة للهيكلة المعمارية',
        description:
          'نغطي كافة التصاميم الهندسية ومخططات السلامة للمباني في الرياض لنجد البنية الأنسب التي تسهل مراجعة ملفك التجاري.',
      },
      {
        title: 'تصميم متجاوب بالكامل',
        description:
          'استعرض تقاريرك وتابع طلباتك في الرياض من أي جهاز بفضل التصميم المتجاوب السلس الذي يمنح العميل تجربة فريدة.',
      },
      {
        title: 'دمج وتوثيق المرفقات والصور',
        description:
          'نرفق الصور الميدانية والفواتير المعتمدة لشبكات السلامة في الرياض بشكل منظم يمنع رفض المعاملة من المنصات الحكومية.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?ixlib=rb-4.0.3&auto=format&fit=crop&w=2194&q=80',
      alt: 'مخططات هندسية معتمدة للسلامة في الرياض',
    }}
  >
    <Fragment slot="content">نضمن أن تواجدك النظامي في الرياض يمثلك ويمثل أمان منشأتك بشكل حقيقي.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'تفاعل وتجاوب سريع مع النظام',
        description:
          'نواكب كافة التحديثات في منصات التراخيص في الرياض لتفادي أي تأخير، مما يضمن بقاء منشأتك آمنة وقانونية دائماً.',
      },
      {
        title: 'تطوير وتحديث مستمر',
        description:
          'نتابع التعديلات الدورية في اشتراطات المديرية العامة للدفاع المدني في المنطقة الوسطى لنقدم لك استشارات محدثة دائمًا.',
      },
      {
        title: 'كفاءة عالية في الوقت والموارد',
        description:
          'وفر على نفسك عناء البدء من الصفر أو مراجعة المعاملات المرفوضة في الرياض؛ اطلب التقرير من توب سيفتي برو وانطلق فوراً.',
      },
      {
        title: 'دعم هندسي متكامل للعملاء',
        description: `انضم إلى مئات المنشآت في الرياض التي وثقت بـ توب سيفتي برو، واستفد من الدعم الفني المتواصل طوال رحلة استخراج رخصتك.`,
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1611462985358-60d3498e0364?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'مهندسو سلامة يتابعون المشاريع في الرياض',
    }}
  >
    <Fragment slot="content">مصمم خصيصاً لدعم نمو واستقرار أعمالك التجارية في الرياض.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Steps
    title="احصل على تقريرك الفني المعتمد في الرياض وافتح منشأتك في أسرع وقت."
    items={[
      {
        title: 'الخطوة 1: <span class="font-medium">إرسال البيانات</span>',
        description:
          'ابدأ فوراً بتزويدنا بنوع النشاط وصور وسائل السلامة المتوفرة لديك في الرياض عبر الواتساب أو المنصة. فريقنا جاهز لاستلام طلبك في أي وقت.',
        icon: 'tabler:package',
      },
      {
        title: 'الخطوة 2: <span class="font-medium">التدقيق والمعاينة</span>',
        description:
          'يقوم مهندسونا في الرياض بمراجعة البيانات والتأكد من مطابقتها لاشتراطات البلدية والدفاع المدني بدقة متناهية لضمان خلوها من الأخطاء.',
        icon: 'tabler:letter-case',
      },
      {
        title: 'الخطوة 3: <span class="font-medium">اعتماد وإصدار التقرير</span>',
        description:
          'يتم ختم التقرير الهندسي ورفعه بالصيغة الرسمية المعتمدة لتتمكن من إرفاقه بمنصة بلدي في الرياض. دقة التصميم تضمن لك قبولاً فورياً.',
        icon: 'tabler:paint',
      },
      {
        title: 'جاهز! رخصتك بيدك',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616198814651-e71f960c3180?ixlib=rb-4.0.3&auto=format&fit=crop&w=987&q=80',
      alt: 'إصدار الترخيص بنجاح تام في الرياض',
    }}
  />

  <Features2
    title="خدمات السلامة في الرياض"
    subtitle="نقدم كافة المكونات والتقارير الهندسية اللازمة لتأمين المنشآت في الرياض وفق اشتراطات كود الحريق السعودي"
    tagline="خدماتنا في الرياض"
    items={[
      {
        title: 'تقرير فني سلامة فوري',
        description: 'إصدار تقرير فني فوري للأنشطة الصغيرة في الرياض عبر بوابة سلامة في نفس اليوم.',
        icon: 'flat-color-icons:template',
      },
      {
        title: 'تقرير فني سلامة غير فوري',
        description: 'إصدار تقرير فني غير فوري يتطلب فحصاً ميدانياً وعقد صيانة للمنشآت المتوسطة والكبيرة في الرياض.',
        icon: 'flat-color-icons:gallery',
      },
      {
        title: 'شهادة تركيب أدوات الوقاية',
