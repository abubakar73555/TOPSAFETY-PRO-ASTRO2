      },
      {
        title: 'ما الفرق بين التقرير الفوري وغير الفوري؟',
        description:
          'التقرير الفوري للأنشطة الصغيرة ويصدر آلياً في نفس اليوم، أما غير الفوري فيتطلب فحصاً ميدانياً وعقد صيانة ويستغرق عدة أيام.',
      },
    ]}
  />

  <Stats
    stats={[
      { title: 'تقرير فني صادر في الرياض', amount: '+2.5K' },
      { title: 'منشأة في الرياض تم تأمينها', amount: '+2K' },
      { title: 'تقييمات إيجابية في الرياض', amount: '100%' },
      { title: 'أحياء الرياض المخدومة', amount: '30+' },
