---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'تجديد ترخيص الدفاع المدني في الرياض - 0572140531',
  description: 'خدمة سريعة ومعتمدة لتجديد ترخيص الدفاع المدني في الرياض، مع استيفاء كافة اشتراطات ومتطلبات السلامة وإصدار التقارير اللازمة بكل احترافية.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'طلب تجديد ترخيص الدفاع المدني في الرياض فوراً',
        href: '#contact',
        icon: 'tabler:file-text',
      },
      { text: 'اكتشف خدماتنا', href: '#features' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'توب سيفتي برو لتجديد ترخيص الدفاع المدني في الرياض' }}
  >
    <Fragment slot="title">
      تجديد ترخيص <span class="hidden xl:inline">الدفاع المدني</span>
      <span class="text-accent dark:text-white">في الرياض</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">منصة توب سيفتي برو</span> تقدم لك خدمة تجديد ترخيص الدفاع المدني في الرياض (المنطقة الوسطى)
        للمنشآت التجارية والصناعية، مع فحص أنظمة السلامة وتجهيز المستندات ومتابعة الطلب حتى الإصدار.</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">توب سيفتي برو: اعتماد فوري في الرياض.</span>
      نخدم جميع أحياء الرياض: حي النخيل، حي العليا، حي السفارات، حي الملقا، وجميع أحياء العاصمة.
    </Fragment>
  </Hero>

  <Note
    title="فلسفتنا:"
    description="السرعة الفائقة، الالتزام بمعايير السلامة، وتسهيل إجراءات تجديد ترخيص الدفاع المدني لعملائنا في الرياض"
  />

  <Features
    id="features"
    tagline="المميزات والخدمات في الرياض"
    title="ما ستحصل عليه مع توب سيفتي برو في الرياض"
    subtitle="واحدة من أفضل الخدمات المتكاملة في الرياض لتجديد تراخيص الدفاع المدني بامتثال كامل لأنظمة السلامة."
    items={[
      {
        title: 'خبرة واسعة في الرياض',
        description: 'لدينا خبرة واسعة في سوق الرياض والمنطقة الوسطى، ونفهم تماماً متطلبات الدفاع المدني في العاصمة.',
        icon: 'tabler:brand-tailwind',
      },
      {
        title: 'تجهيز كامل للمستندات',
        description:
          'نقوم بتجهيز جميع الأوراق المطلوبة مثل تقارير السلامة، شهادات المطابقة، وعقود الصيانة بشكل احترافي ومنظم.',
        icon: 'tabler:components',
      },
      {
        title: 'فحص شامل لأنظمة السلامة',
        description:
          'نقوم بفحص جميع أنظمة السلامة في منشأتك في الرياض للتأكد من جاهزيتها واستيفائها لمتطلبات الدفاع المدني.',
        icon: 'tabler:list-check',
      },
      {
        title: 'سرعة في الإنجاز',
        description: 'نضمن لك إنجاز المعاملة وإصدار الترخيص في الرياض في أيام معدودة لتفادي أي غرامات.',
        icon: 'tabler:rocket',
      },
      {
        title: 'أسعار تنافسية',
        description: 'نقدم أفضل الأسعار في سوق الرياض مع الحفاظ على أعلى مستويات الجودة والاحترافية.',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'تغطية جميع أحياء الرياض',
        description:
          'نخدم جميع أحياء ومناطق الرياض بدون استثناء، بما فيها حي النخيل، العليا، السفارات، الملقا، وغيرها.',
        icon: 'tabler:bulb',
      },
    ]}
  />

  <Content
    isReversed
    tagline="داخل الخدمة في الرياض"
    title="خطوات تجديد ترخيص الدفاع المدني في الرياض"
    items={[
      {
        title: 'فحص أنظمة السلامة',
        description:
          'نقوم بفحص شامل لجميع أنظمة السلامة في منشأتك في الرياض، بما في ذلك أنظمة الإنذار، الإطفاء، والإخلاء، للتأكد من جاهزيتها.',
      },
      {
        title: 'تجهيز المستندات',
        description:
          'نقوم بتجهيز جميع الأوراق المطلوبة مثل تقارير الفحص الفني، شهادات المطابقة، وعقود الصيانة بشكل احترافي.',
      },
      {
        title: 'تقديم الطلب عبر بوابة سلامة',
        description:
          'نقوم بتقديم الطلب عبر بوابة سلامة الرسمية ومتابعته بدقة حتى صدور ترخيص الدفاع المدني الجديد في الرياض.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'فريق عمل يتابع إجراءات الدفاع المدني في الرياض',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">لماذا تختارنا في الرياض؟</h3>
      خبرة واسعة في الرياض، سرعة في الإنجاز، معتمدون من الدفاع المدني، أسعار تنافسية، تغطية جميع أحياء الرياض، دعم على مدار
      الساعة.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isAfterContent
    items={[
      {
        title: 'مرونة وتخصيص لا محدود',
        description: `نقوم بتطويع عملية تجديد الترخيص لتتتناسب تماماً مع متطلبات وهوية نشاطك التجاري في الرياض، مما يحميك ويختصر وقتك وجهدك.`,
      },
      {
        title: 'تغطية شاملة لجميع الأنشطة',
        description:
          'نغطي كافة أنواع الأنشطة التجارية والصناعية في الرياض من المحلات البسيطة إلى المصانع الكبرى لنجد الحل الأنسب الذي يسهل مراجعة ملفك.',
      },
      {
        title: 'متابعة دقيقة للطلب',
        description: 'نتابع طلبك بدقة متناهية عبر بوابة سلامة حتى صدور الترخيص الجديد وإبلاغك فوراً في الرياض.',
      },
      {
        title: 'دعم متكامل للعملاء',
        description:
          'انضم إلى مئات المنشآت في الرياض التي وثقت بـ توب سيفتي برو، واستفد من الدعم المتواصل طوال رحلة استخراج ترخيصك.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1450101499163-c8848c66ca85?ixlib=rb-4.0.3&auto=format&fit=crop&w=2194&q=80',
      alt: 'مستندات وإجراءات الدفاع المدني في الرياض',
    }}
  >
    <Fragment slot="content"
      >نضمن أن تواجدك النظامي في الرياض يمثلك ويمثل التزام منشأتك بأنظمة السلامة بشكل حقيقي.</Fragment
    >

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'تفاعل وتجاوب سريع مع النظام',
        description:
          'نواكب كافة التحديثات في منصات الدفاع المدني في الرياض لتفادي أي تأخير، مما يضمن بقاء منشأتك قانونية دائماً.',
      },
      {
        title: 'تطوير وتحديث مستمر',
        description:
          'نتابع التعديلات الدورية في اشتراطات الدفاع المدني في المنطقة الوسطى لنقدم لك استشارات محدثة دائماً ومتوافقة مع أحدث الأنظمة.',
      },
      {
        title: 'كفاءة عالية في الوقت والموارد',
        description:
          'وفر على نفسك عناء البدء من الصفر أو مراجعة المعاملات المرفوضة في الرياض؛ اطلب التجديد من توب سيفتي برو وانطلق فوراً.',
      },
      {
        title: 'حلول مبتكرة للمشاكل المعقدة',
        description: `إذا كانت منشأتك في الرياض تفتقر لبعض متطلبات السلامة، نقدم لك حلولاً ذكية للتوافق مع النظام دون تكاليف باهظة أو تأخير.`,
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1552664730-d307ca884978?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'فريق عمل يتابع مشاريع السلامة في الرياض',
    }}
  >
    <Fragment slot="content">مصمم خصيصاً لدعم نمو واستقرار أعمالك التجارية في الرياض.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Steps
    title="احصل على ترخيص الدفاع المدني المعتمد في الرياض وافتح منشأتك بأمان."
    items={[
      {
        title: 'الخطوة 1: <span class="font-medium">فحص أنظمة السلامة</span>',
        description:
          'نقوم بفحص شامل لجميع أنظمة السلامة في منشأتك في الرياض، بما في ذلك أنظمة الإنذار، الإطفاء، والإخلاء، للتأكد من جاهزيتها.',
        icon: 'tabler:package',
      },
      {
        title: 'الخطوة 2: <span class="font-medium">تجهيز المستندات</span>',
        description:
          'نقوم بتجهيز جميع الأوراق المطلوبة مثل تقارير الفحص الفني، شهادات المطابقة، وعقود الصيانة بشكل احترافي في الرياض.',
        icon: 'tabler:letter-case',
      },
      {
        title: 'الخطوة 3: <span class="font-medium">تقديم الطلب</span>',
        description:
          'نقوم بتقديم الطلب عبر بوابة سلامة الرسمية في الرياض ومتابعته بدقة حتى صدور ترخيص الدفاع المدني الجديد.',
        icon: 'tabler:paint',
      },
      {
        title: 'الخطوة 4: <span class="font-medium">استلام الترخيص</span>',
        description:
          'نسلمك الترخيص الجديد بعد إصداره رسمياً عبر بوابة سلامة في الرياض لتتمكن من مزاولة نشاطك التجاري بأمان.',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1450101499163-c8848c66ca85?ixlib=rb-4.0.3&auto=format&fit=crop&w=987&q=80',
      alt: 'إصدار ترخيص الدفاع المدني بنجاح تام في الرياض',
    }}
  />

  <Features2
    title="متطلبات تجديد ترخيص الدفاع المدني في الرياض"
    subtitle="نضمن لك استيفاء جميع المتطلبات والشروط اللازمة لتجديد ترخيص الدفاع المدني في الرياض بنجاح وبدون أي ملاحظات"
    tagline="المتطلبات الأساسية"
    items={[
      {
        title: 'التزام بمعايير السلامة',
        description:
          'التأكد من التزام المنشأة في الرياض بكافة معايير السلامة العامة وأنظمة الحماية من الحريق حسب اشتراطات الدفاع المدني.',
        icon: 'flat-color-icons:template',
      },
      {
        title: 'تراخيص سابقة صالحة',
        description:
          'مراجعة التراخيص السابقة والتأكد من صلاحيتها وعدم وجود مخالفات أو غرامات مستحقة على المنشأة في الرياض.',
        icon: 'flat-color-icons:gallery',
      },
      {
        title: 'جميع المستندات المطلوبة',
        description:
          'تجهيز كافة المستندات المطلوبة مثل تقارير السلامة، شهادات المطابقة، والعقود الرسمية بشكل كامل في الرياض.',
        icon: 'flat-color-icons:approval',
      },
      {
        title: 'دفع الرسوم المقررة',
        description: 'التأكد من سداد جميع الرسوم المقررة وتجديد الاشتراكات اللازمة قبل تقديم طلب التجديد في الرياض.',
        icon: 'flat-color-icons:document',
      },
      {
        title: 'عقد صيانة لأنظمة السلامة',
        description: 'توفير عقد صيانة ساري المفعول لأنظمة السلامة والحريق مع مكتب هندسي معتمد في الرياض.',
        icon: 'flat-color-icons:advertising',
      },
      {
        title: 'تقرير فني من الدفاع المدني',
        description:
          'توفير تقرير فني معتمد من الدفاع المدني يثبت استيفاء المنشأة في الرياض لاشتراطات السلامة المطلوبة.',
        icon: 'flat-color-icons:currency-exchange',
      },
      {
        title: 'شهادة الكاميرات الأمنية',
        description:
          'توفير شهادة استيفاء كاميرات المراقبة حسب متطلبات الدفاع المدني في الرياض للمنشآت التجارية المحددة.',
        icon: 'flat-color-icons:voice-presentation',
      },
      {
        title: 'خطط الإخلاء والطوارئ',
        description: 'توفير خطط إخلاء وطوارئ معتمدة للمنشأة في الرياض تثبت جاهزيتها للتعامل مع حالات الطوارئ.',
        icon: 'flat-color-icons:business-contact',
      },
      {
        title: 'تدريب الموظفين على السلامة',
        description: 'تقديم شهادات تدريب للموظفين على أنظمة السلامة والإخلاء في الرياض حسب متطلبات الدفاع المدني.',
        icon: 'flat-color-icons:database',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <BlogLatestPosts
    title="تصفح آخر مستجدات أنظمة الدفاع المدني في الرياض بالمدونة"
    information={`نشاركك دورياً شروحات مفصلة حول أنظمة الدفاع المدني واشتراطات السلامة في الرياض والمنطقة الوسطى.
                  كل مقال جديد نطرحه يمثل خطوة هامة تمكنك من حماية منشأتك وتفادي تأخير التراخيص لتصبح خبيراً في إدارة شؤون السلامة.
                  الالتزام بالسلامة هو استثمارك الذكي. شكراً لثقتكم.
                `}
  />

  <FAQs
    title="الأسئلة الشائعة"
    subtitle="تعمق في الإجابات التالية للحصول على فهم شامل حول تجديد ترخيص الدفاع المدني في الرياض وكيف يمكن لمنصتنا تسريع أعمالك التجارية."
    tagline="الأسئلة الشائعة في الرياض"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'هل تقدمون الخدمة في جميع أحياء الرياض؟',
        description:
          'نعم، نغطي جميع أحياء ومناطق الرياض بدون استثناء، بما فيها حي النخيل، حي العليا، حي السفارات، حي الملقا، وجميع أحياء العاصمة.',
      },
      {
        title: 'كم يستغرق إنجاز الخدمة في الرياض؟',
        description:
          'نسعى لإنجاز الخدمة في أسرع وقت ممكن، عادةً عدة أيام بعد استكمال جميع متطلبات السلامة وتجهيز المستندات. تواصل معنا للاستفسار عن الوقت المتوقع.',
      },
      {
        title: 'كيف أتواصل معكم في الرياض؟',
        description:
          'يمكنك التواصل معنا عبر واتساب أو الاتصال على 0572140531 في أي وقت، وفريقنا جاهز للرد عليك ومتابعة معاملتك في الرياض.',
      },
      {
        title: 'من يجب عليه تجديد ترخيص الدفاع المدني؟',
        description:
          'جميع المنشآت التجارية والصناعية والمحلات والمكاتب في الرياض التي تستخدم أنظمة سلامة مثل طفايات الحريق وأنظمة الإنذار.',
      },
      {
        title: 'هل يشترط فحص معدات السلامة؟',
        description:
          'نعم، يجب التأكد من جاهزية جميع أنظمة السلامة مثل طفايات الحريق، أنظمة الإنذار، والإخلاء قبل إصدار الترخيص في الرياض.',
      },
      {
        title: 'ماذا يحدث إذا انتهت صلاحية الترخيص؟',
        description:
          'قد تتعرض المنشأة في الرياض للغرامات المالية أو منعها من مزاولة النشاط حتى تجديد الترخيص. لذلك ننصح دائماً بالتجديد قبل انتهاء المدة بوقت كافٍ.',
      },
    ]}
  />

  <Stats
    stats={[
      { title: 'ترخيص دفاع مدني تم تجديده في الرياض', amount: '+1.8K' },
      { title: 'منشأة في الرياض', amount: '+1.5K' },
      { title: 'نسبة القبول في الرياض', amount: '99%' },
      { title: 'أحياء الرياض المخدومة', amount: '25+' },
    ]}
  />

  <CallToAction
    id="contact"
    actions={[
      {
        variant: 'primary',
        text: 'تواصل معنا عبر الواتساب فوراً في الرياض',
        href: 'https://wa.me/966572140531',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
    ]}
  >
    <Fragment slot="title"> جدد ترخيص الدفاع المدني في الرياض الآن </Fragment>

    <Fragment slot="subtitle">
      لا تدع انتهاء الترخيص يعطل أعمالك التجارية في الرياض ويعرضك للغرامات. <br class="hidden md:inline" />تواصل معنا
      الآن وسنتولى جميع إجراءات التجديد بسرعة واحترافية في الرياض!
    </Fragment>
  </CallToAction>
</Layout>
