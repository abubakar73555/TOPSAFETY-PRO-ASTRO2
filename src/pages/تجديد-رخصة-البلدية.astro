---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'تجديد رخصة البلدية بسرعة ',
  description: 'خدمة متكاملة لتجديد وإصدار رخصة البلدية بسرعة واحترافية مع تجهيز جميع المستندات المطلوبة.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'طلب تجديد الرخصة فوراً',
        href: '#contact',
        icon: 'tabler:file-text',
      },
      { text: 'إكتشف خدماتنا', href: '#features' },
    ]}
    image={{ src: '~/assets/images/رخصه-البلدية.webp', alt: 'توب سيفتي برو لتجديد رخصة البلدية' }}
  >
    <Fragment slot="title">
      خدمة متكاملة لـ <span class="hidden xl:inline">تجديد وإصدار</span>
      <span class="text-accent dark:text-white">رخصة البلدية</span> + تجهيز المستندات
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">منصة توب سيفتي برو</span> هي خيارك الأسرع لتجديد رخصة البلدية للمنشآت والشركات بسرعة واحترافية
        مع تجهيز جميع المستندات المطلوبة.</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">توب سيفتي برو: اعتماد فوري.</span>
      مناسب للمحلات التجارية، المطاعم، الأنشطة الصغيرة، الشركات الناشئة، المستودعات الكبرى، المصانع، وجميع الأنشطة التجارية
      بكافة مناطق المملكة.
    </Fragment>
  </Hero>

  <Note
    title="فلسفتنا:"
    description="السرعة الفائقة، الالتزام بالمعايير، وتسهيل إجراءات تجديد الرخصة البلدية لعملائنا"
  />

  <Features
    id="features"
    tagline="المميزات والخدمات"
    title="ما ستحصل عليه مع توب سيفتي برو"
    subtitle="واحدة من أفضل الخدمات المتكاملة في السوق السعودي لتجديد رخص البلدية بامتثال كامل للأنظمة واللوائح البلدية."
    items={[
      {
        title: 'الربط المباشر مع منصة بلدي',
        description:
          'تكامل سلس يضمن تجهيز جميع المستندات بالمعايير الدقيقة المطلوبة لضمان قبول طلبك وإصدار رخصتك فوراً.',
        icon: 'tabler:brand-tailwind',
      },
      {
        title: 'تجهيز كامل للمستندات',
        description:
          'نقوم بتجهيز جميع الأوراق المطلوبة مثل بيانات المنشأة والشهادات الصحية وعقود الإيجار بشكل احترافي ومنظم.',
        icon: 'tabler:components',
      },
      {
        title: 'فحص الموقع والالتزام بالمعايير',
        description:
          'نضمن مراجعة منشأتك للتأكد من التزامها بمعايير النظافة والصحة العامة ومتطلبات البلدية قبل تقديم الطلب.',
        icon: 'tabler:list-check',
      },
      {
        title: 'سرعة استثنائية (توفير الوقت)',
        description:
          'نحن نعلم أن الوقت يعني المال؛ لذا نضمن لك إنجاز المعاملة وإصدار الرخصة في أيام معدودة لتفادي أي غرامات.',
        icon: 'tabler:rocket',
      },
      {
        title: 'متابعة دقيقة للطلب',
        description: 'نتابع طلبك بدقة متناهية عبر المنصات الرسمية للبلدية حتى صدور الرخصة الجديدة وإبلاغك فوراً.',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'حلول مبتكرة للمشاكل المعقدة',
        description:
          'إذا كانت منشأتك تفتقر لبعض المتطلبات، نقدم لك حلولاً ذكية للتوافق مع النظام دون تكاليف باهظة أو تأخير.',
        icon: 'tabler:bulb',
      },
    ]}
  />

  <Content
    isReversed
    tagline="داخل الخدمة"
    title="مخطط توب سيفتي برو: دقة التنفيذ تلتقي مع معايير البلدية!"
    items={[
      {
        title: 'الاعتماد على الأنظمة البلدية المعتمدة',
        description:
          'نصيغ مستنداتنا ونفحص منشأتك استناداً إلى أحدث الأنظمة واللوائح البلدية المعتمدة بالمملكة لضمان قبول فوري.',
      },
      {
        title: 'تنسيق متوافق مع كود Tailwind CSS v4',
        description:
          'تم بناء المنصة بأحدث التقنيات البرمجية لضمان تصفح سريع جداً وخفيف لعملائنا من الجوال أو الكمبيوتر.',
      },
      {
        title: 'توافق شامل ومتكامل',
        description:
          'نضمن أن مستنداتنا وطلباتنا تكون متوافقة ومفهومة لدى كافة الجهات الميدانية والإلكترونية المعنية بالترخيص.',
      },
    ]}
    image={{
      src: '~/assets/images/رخصه-البلدية.webp',
      alt: 'فريق عمل يتابع معاملات البلدية',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">التأسيس على قواعد نظامية حديثة</h3>
      احصل على الأفضلية النظامية من خلال تطبيق أفضل ممارسات الالتزام بالأنظمة البلدية المعتمدة.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isAfterContent
    items={[
      {
        title: 'مرونة وتخصيص لا محدود',
        description: `نقوم بتطويع عملية التجديد لتتتناسب تماماً مع متطلبات وهوية نشاطك التجاري، مما يحميك ويختصر وقتك وجهدك.`,
      },
      {
        title: 'تغطية شاملة لجميع الأنشطة',
        description:
          'نغطي كافة أنواع الأنشطة التجارية من المحلات البسيطة إلى المصانع الكبرى لنجد الحل الأنسب الذي يسهل مراجعة ملفك.',
      },
      {
        title: 'تصميم متجاوب بالكامل',
        description: 'استخدم خدماتنا وتابع طلباتك من أي جهاز بفضل التصميم المتجاوب السلس الذي يمنحك تجربة فريدة.',
      },
      {
        title: 'دمج وتوثيق المرفقات والصور',
        description: 'نرفق الصور الميدانية والمستندات المعتمدة بشكل منظم يمنع رفض المعاملة من المنصات الحكومية.',
      },
    ]}
    image={{
      src: '~/assets/images/رخصه-البلدية.webp',
      alt: 'مستندات ومعاملات بلدية',
    }}
  >
    <Fragment slot="content">نضمن أن تواجدك النظامي يمثلك ويمثل التزام منشأتك بالقوانين بشكل حقيقي.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'تفاعل وتجاوب سريع مع النظام',
        description:
          'نواكب كافة التحديثات في منصات التراخيص البلدية لتفادي أي تأخير، مما يضمن بقاء منشأتك قانونية دائماً.',
      },
      {
        title: 'تطوير وتحديث مستمر',
        description:
          'نتابع التعديلات الدورية في اشتراطات البلديات لنقدم لك استشارات محدثة دائماً ومتوافقة مع أحدث الأنظمة.',
      },
      {
        title: 'كفاءة عالية في الوقت والموارد',
        description:
          'وفر على نفسك عناء البدء من الصفر أو مراجعة المعاملات المرفوضة؛ اطلب التجديد من توب سيفتي برو وانطلق فوراً.',
      },
      {
        title: 'دعم متكامل للعملاء',
        description: `انضم إلى مئات المنشآت التي وثقت بـ توب سيفتي برو، واستفد من الدعم المتواصل طوال رحلة استخراج رخصتك.`,
      },
    ]}
    image={{
      src: '~/assets/images/رخصه-البلدية.webp',
      alt: 'فريق عمل يتابع المشاريع',
    }}
  >
    <Fragment slot="content">مصمم خصيصاً لدعم نمو واستقرار أعمالك التجارية.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Steps
    title="احصل على رخصتك البلدية المعتمدة وافتح منشأتك في أسرع وقت."
    items={[
      {
        title: 'الخطوة 1: <span class="font-medium">فحص الموقع</span>',
        description:
          'يتم فحص المنشأة للتأكد من الالتزام بمعايير النظافة والصحة العامة ومتطلبات البلدية بدقة متناهية لضمان قبول الطلب.',
        icon: 'tabler:package',
      },
      {
        title: 'الخطوة 2: <span class="font-medium">تجهيز المستندات</span>',
        description:
          'نقوم بتجهيز جميع الأوراق المطلوبة مثل بيانات المنشأة والشهادات الصحية وعقود الإيجار بشكل احترافي ومنظم.',
        icon: 'tabler:letter-case',
      },
      {
        title: 'الخطوة 3: <span class="font-medium">تقديم الطلب</span>',
        description: 'نقوم بتقديم الطلب عبر المنصات الرسمية للبلدية ومتابعته بدقة حتى صدور رخصة البلدية الجديدة.',
        icon: 'tabler:paint',
      },
      {
        title: 'الخطوة 4: <span class="font-medium">استلام الرخصة</span>',
        description: 'نسلمك الرخصة الجديدة بعد إصدارها رسمياً عبر منصة بلدي لتتمكن من مزاولة نشاطك التجاري بكل سهولة.',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: '~/assets/images/رخصه-البلدية.webp',
      alt: 'إصدار الرخصة البلدية بنجاح تام',
    }}
  />

  <Features2
    title="متطلبات تجديد رخصة البلدية"
    subtitle="نضمن لك استيفاء جميع المتطلبات والشروط اللازمة لتجديد رخصة البلدية بنجاح وبدون أي ملاحظات"
    tagline="المتطلبات الأساسية"
    items={[
      {
        title: 'التزام بمعايير النظافة',
        description: 'التأكد من التزام المنشأة بكافة معايير النظافة العامة والصحة البيئية حسب اشتراطات البلدية.',
        icon: 'flat-color-icons:template',
      },
      {
        title: 'تراخيص سابقة صالحة',
        description: 'مراجعة التراخيص السابقة والتأكد من صلاحيتها وعدم وجود مخالفات أو غرامات مستحقة على المنشأة.',
        icon: 'flat-color-icons:gallery',
      },
      {
        title: 'جميع المستندات المطلوبة',
        description: 'تجهيز كافة المستندات المطلوبة مثل السجل التجاري، الهوية الوطنية، والعقود الرسمية بشكل كامل.',
        icon: 'flat-color-icons:approval',
      },
      {
        title: 'دفع الرسوم المقررة',
        description: 'التأكد من سداد جميع الرسوم البلدية المقررة وتجديد الاشتراكات اللازمة قبل تقديم طلب التجديد.',
        icon: 'flat-color-icons:document',
      },
      {
        title: 'عقد إيجار ساري المفعول',
        description: 'التحقق من وجود عقد إيجار ساري المفعول ومطابق للشروط البلدية المعتمدة للمنشأة التجارية.',
        icon: 'flat-color-icons:advertising',
      },
      {
        title: 'شهادات صحية (حسب النشاط)',
        description: 'توفير الشهادات الصحية المطلوبة حسب نوع النشاط التجاري مثل المطاعم والمحلات الغذائية.',
        icon: 'flat-color-icons:currency-exchange',
      },
      {
        title: 'تقرير الدفاع المدني',
        description: 'توفير تقرير فني معتمد من الدفاع المدني يثبت استيفاء المنشأة لاشتراطات السلامة المطلوبة.',
        icon: 'flat-color-icons:voice-presentation',
      },
      {
        title: 'شهادة الكاميرات الأمنية',
        description: 'توفير شهادة استيفاء كاميرات المراقبة حسب متطلبات البلدية للمنشآت التجارية المحددة.',
        icon: 'flat-color-icons:business-contact',
      },
      {
        title: 'عقد صيانة لأنظمة السلامة',
        description: 'توفير عقد صيانة ساري المفعول لأنظمة السلامة والحريق مع مكتب هندسي معتمد.',
        icon: 'flat-color-icons:database',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <BlogLatestPosts
    title="تصفح آخر مستجدات الأنظمة البلدية بالمدونة"
    information={`نشاركك دورياً شروحات مفصلة حول الأنظمة البلدية واشتراطات منصة بلدي.
                  كل مقال جديد نطرحه يمثل خطوة هامة تمكنك من حماية منشأتك وتفادي تأخير التراخيص لتصبح خبيراً في إدارة شؤون منشأتك.
                  الالتزام هو استثمارك الذكي. شكراً لثقتكم.
                `}
  />

  <FAQs
    title="الأسئلة الشائعة"
    subtitle="تعمق في الإجابات التالية للحصول على فهم شامل حول تجديد رخصة البلدية وكيف يمكن لمنصتنا تسريع أعمالك التجارية."
    tagline="الأسئلة الشائعة"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'ما هي رخصة البلدية ولماذا هي مهمة؟',
        description:
          'رخصة البلدية تصريح قانوني يضمن التزام المنشآت بالقوانين البلدية المتعلقة بالنظافة والصحة العامة. وهي إلزامية لمزاولة أي نشاط تجاري بشكل قانوني وتجنب المخالفات والغرامات.',
      },
      {
        title: 'كم يستغرق تجديد رخصة البلدية؟',
        description:
          'عادةً يستغرق التجديد عدة أيام بعد استكمال المستندات المطلوبة. نسعى دائماً لتسريع الإجراءات قدر الإمكان لضمان حصولك على الرخصة في أسرع وقت ممكن.',
      },
      {
        title: 'ما هي مدة صلاحية رخصة البلدية؟',
        description:
          'عادة تكون صلاحية رخصة البلدية سنة واحدة، ويجب تجديدها قبل انتهاء المدة لتجنب المخالفات والغرامات المالية التي قد تصل إلى إيقاف النشاط التجاري.',
      },
      {
        title: 'ماذا يحدث إذا انتهت صلاحية الرخصة؟',
        description:
          'قد تتعرض المنشأة للغرامات المالية أو منعها من مزاولة النشاط حتى تجديد الرخصة. لذلك ننصح دائماً بالتجديد قبل انتهاء المدة بوقت كافٍ.',
      },
      {
        title: 'ما هي المستندات المطلوبة للتجديد؟',
        description:
          'تحتاج إلى صورة السجل التجاري ساري المفعول، الرخصة السابقة للبلدية، عقد إيجار ساري، الشهادات الصحية (حسب النشاط)، وتقرير الدفاع المدني.',
      },
      {
        title: 'هل يمكنني تجديد الرخصة بنفسي؟',
        description:
          'نعم، يمكنك التقديم عبر منصة بلدي مباشرة، لكننا ننصح بالاستعانة بخبرائنا لضمان تجهيز جميع المستندات بشكل صحيح وتجنب أي رفض أو تأخير في المعاملة.',
      },
    ]}
  />

  <Stats
    stats={[
      { title: 'رخصة بلدية تم تجديدها', amount: '+4K' },
      { title: 'منشأة تجارية', amount: '+3.5K' },
      { title: 'نسبة القبول', amount: '99%' },
      { title: 'مدن المملكة', amount: '13+' },
    ]}
  />

  <CallToAction
    id="contact"
    actions={[
      {
        variant: 'primary',
        text: 'تواصل معنا عبر الواتساب فوراً',
        href: 'https://wa.me/966572140531',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
    ]}
  >
    <Fragment slot="title"> جدد رخصة البلدية الآن </Fragment>

    <Fragment slot="subtitle">
      لا تدع انتهاء الرخصة يعطل أعمالك التجارية ويعرضك للغرامات. <br class="hidden md:inline" />تواصل معنا الآن وسنتولى
      جميع إجراءات التجديد بسرعة واحترافية!
    </Fragment>
  </CallToAction>
</Layout>
