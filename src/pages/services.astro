---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'خدمات تراخيص بلدي والدفاع المدني وعقود السلامة | توب سيفتي برو',
  description:
    'دليل خدمات توب سيفتي برو المتكاملة: إصدار وتجديد رخص البلدية وترخيص الدفاع المدني، شهادة تركيب أدوات السلامة، تقرير فني بلدي، عقود صيانة السلامة وكاميرات المراقبة.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="خدماتنا"
    title="تسهيل استخراج وتجديد رخص الدفاع المدني والبلدية"
    subtitle="نقوم بمساعدتك في تجهيز وإعداد كافة متطلبات السلامة والبلدية لمنشأتك التجارية، من تقارير فنية هندسية وعقود صيانة وشهادات سلامة معتمدة لتسريع إجراءات التراخيص عبر منصة بلدي وبوابة سلامة ومنصة مدينتي."
    actions={[
      {
        variant: 'primary',
        target: '_blank',
        text: 'طلب استشارة أو خدمة عبر الواتساب',
        href:
          'https://wa.me/966572140531?text=' +
          encodeURIComponent('السلام عليكم، أرغب في الاستفسار وطلب خدمات تراخيص السلامة والبلدية لمنشأتي'),
        icon: 'tabler:brand-whatsapp',
      },
    ]}
    image={{
      src: '~/assets/images/رخصه-الدفاع-المدني.webp',
      alt: 'خدمات استخراج وتجديد رخص الدفاع المدني والبلدية في السعودية',
    }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="الخدمات التي نقدمها"
    subtitle="نسعى لتقديم حلول هندسية وفنية متكاملة تضمن توافق منشأتك مع الاشتراطات الرسمية في كافة مناطق المملكة."
    columns={3}
    items={[
      {
        title: 'إصدار وتجديد رخصة الدفاع المدني',
        description:
          'متابعة وإنهاء إجراءات إصدار أو <a href="/تجديد-ترخيص-الدفاع-المدني" class="text-primary hover:underline font-medium">تجديد ترخيص الدفاع المدني</a> عبر بوابة سلامة لجميع الأنشطة والمحلات.',
        icon: 'tabler:shield',
      },
      {
        title: 'إصدار وتجديد رخصة البلدية',
        description:
          'مساعدة شاملة في استخراج أو <a href="/تجديد-رخصة-البلدية" class="text-primary hover:underline font-medium">تجديد رخصة البلدية</a> عبر منصة بلدي ومطابقتها للاشتراطات الفنية وكود البناء.',
        icon: 'tabler:building',
      },
      {
        title: 'تقرير فني بلدي معتمد',
        description:
          'إعداد ورفع <a href="/تقرير-فني-بلدي" class="text-primary hover:underline font-medium">تقرير فني بلدي معتمد</a> من مكتب استشاري هندسي مؤهل للأنشطة التجارية والمستودعات.',
        icon: 'tabler:file-text',
      },
      {
        title: 'شهادة تركيب أدوات السلامة',
        description:
          'إصدار وتوثيق <a href="/شهاده-سلامه" class="text-primary hover:underline font-medium">شهادة تركيب أدوات السلامة</a> المعتمدة في منصة بلدي وبوابة سلامة لتجديد الرخص فوراً.',
        icon: 'tabler:settings',
      },
      {
        title: 'عقود صيانة سلامة سنوية',
        description:
          'توفير <a href="/عقد-صيانة-سلامة" class="text-primary hover:underline font-medium">عقد صيانة سلامة سنوي معتمد</a> لأنظمة ومعدات الإطفاء والإنذار مطابق لاشتراطات الدفاع المدني.',
        icon: 'tabler:clipboard-list',
      },
      {
        title: 'شهادة استيفاء كاميرات المراقبة',
        description:
          'إصدار وتجهيز <a href="/شهاده-استيفاء-كاميرات" class="text-primary hover:underline font-medium">شهادة استيفاء كاميرات المراقبة</a> للأنشطة التجارية الملزمة بالاشتراطات الأمنية.',
        icon: 'tabler:video',
      },
      {
        title: 'عقد نظافة منصة مدينتي',
        description:
          'إصدار وتوثيق <a href="/عقد-نظافة-جدة" class="text-primary hover:underline font-medium">عقد نظافة منصة مدينتي</a> المعتمد لحاويات ونفايات المنشآت والمحلات بأمانة جدة.',
        icon: 'tabler:trash',
      },
      {
        title: 'تغطية مدن ومناطق المملكة',
        description:
          'خدمات معتمدة وفورية تغطي الرياض، جدة، مكة المكرمة، الدمام، المدينة المنورة، الخبر، وكافة الأمانات والبلديات.',
        icon: 'tabler:map-pin',
      },
      {
        title: 'استشارات فنية وهندسية',
        description:
          'فريق استشاري متخصص لتقديم الدعم الفني وتذليل أي ملاحظات أو اشتراطات لتسهيل معاملات التراخيص.',
        icon: 'tabler:info-circle',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    items={[
      {
        title: 'سرعة في الإنجاز',
        description:
          'نعمل بجد لإنهاء المعاملات والأوراق الفنية في أقصر وقت ممكن لتفادي تأخير أعمالك.',
        icon: 'tabler:clock',
      },
      {
        title: 'توافق كامل مع الأنظمة',
        description:
          'نحرص على أن تكون كافة المستندات والتقارير متوافقة تماماً مع شروط بلدي والدفاع المدني.',
        icon: 'tabler:checks',
      },
      {
        title: 'وثائق معتمدة ورسمية',
        description:
          'جميع عقود الصيانة والتقارير الفنية تصدر من جهات مرخصة ومعتمدة بشكل رسمي.',
        icon: 'tabler:certificate',
      },
      {
        title: 'متابعة مستمرة ودعم مباشر',
        description:
          'نبقى على تواصل دائم معك لإطلاعك على مستجدات طلبك والإجابة عن استفساراتك عبر الواتساب.',
        icon: 'tabler:message-circle',
      },
    ]}
    image={{
      src: '~/assets/images/شهاده-تركيب-ادوات-السلامه.webp',
      alt: 'شهادة تركيب أدوات ومعدات السلامة والوقاية من الحريق معتمدة',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">أبرز مزايانا</h3>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'توفير الوقت والجهد',
        description:
          'نتولى الإجراءات والمعاملات الإلكترونية نيابة عنك لتركز وقتك على تطوير وإدارة منشأتك.',
        icon: 'tabler:clock',
      },
      {
        title: 'تجنب المخالفات والغرامات',
        description:
          'نساعدك في تجديد الرخص والالتزامات في مواعيدها المحددة لتفادي أي عقوبات أو غرامات بلدية.',
        icon: 'tabler:alert-triangle',
      },
      {
        title: 'تكلفة اقتصادية ملائمة',
        description:
          'نقدم خدماتنا وعقود الصيانة بأسعار تنافسية ومدروسة تناسب ميزانية منشأتك التجارية.',
        icon: 'tabler:coin',
      },
      {
        title: 'تواصل فوري وسريع',
        description:
          'تواصل مباشر معنا عبر الواتساب للحصول على الخدمة المطلوبة ومتابعتها في أي وقت.',
        icon: 'tabler:file-download',
      },
    ]}
    image={{
      src: '~/assets/images/hero-image.png',
      alt: 'بوابة سلامة ومنصة بلدي لتراخيص المنشآت والأنشطة التجارية',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">فوائد التعامل معنا</h3>
    </Fragment>
  </Content>

  <!-- Testimonials Widget *********** -->

  <Testimonials
    title="آراء من عملائنا الكرام"
    subtitle="ثقة أصحاب المنشآت والأنشطة التجارية في مختلف مناطق المملكة هي دافعنا الدائم للتميز."
    testimonials={[
      {
        title: '★★★★★',
        testimonial: `تم إصدار رخصة الدفاع المدني وعقد صيانة السلامة لمنشأتنا بسرعة كبيرة وتجاوب ممتاز ومحترف من الفريق المساعد. وفروا علينا جهداً كبيراً.`,
        name: 'أبو فهد',
        job: 'صاحب نشاط تجاري - الرياض',
        image: {
          src: '~/assets/images/client_abu_fahd_1789230940707.jpg',
          alt: 'صورة أبو فهد - صاحب نشاط تجاري',
        },
      },
      {
        title: '★★★★★',
        testimonial: `ساعدوني بشكل فعال في استخراج التقرير الفني المعتمد وشهادة تركيبات أدوات السلامة اللازمة للبلدية في وقت قياسي وبكل سهولة.`,
        name: 'م. خالد العتيبي',
        job: 'مدير عمليات وتشغيل - جدة',
        image: {
          src: '~/assets/images/client_khaled_otaibi_1789230956507.jpg',
          alt: 'صورة م. خالد العتيبي - مدير عمليات وتشغيل',
        },
      },
      {
        title: '★★★★★',
        testimonial: `حصلنا على شهادة استيفاء الكاميرات وعقد الصيانة بسهولة تامة من خلال التواصل معهم على الواتساب. ملتزمون جداً في تعاملهم وخدمتهم.`,
        name: 'سارة الشمري',
        job: 'مؤسسة صالون نسائي - الدمام',
        image: {
          src: '~/assets/images/client_sara_shammari_1789230970016.jpg',
          alt: 'صورة سارة الشمري - مؤسسة صالون نسائي',
        },
      },
    ]}
    callToAction={{
      target: '_blank',
      text: 'تواصل معنا مباشرة عبر الواتساب',
      href:
        'https://wa.me/966572140531?text=' +
        encodeURIComponent('السلام عليكم، اطلعت على آراء العملاء وأرغب في الاستفسار عن خدمات التراخيص لمنشأتي'),
      icon: 'tabler:brand-whatsapp',
    }}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="الأسئلة الشائعة حول خدماتنا"
    subtitle="إجابات وافية لأهم الأسئلة المتكررة حول تراخيص الدفاع المدني وبلدي وعقود السلامة والتقارير الفنية."
    columns={1}
    classes={{ container: 'max-w-4xl' }}
    items={[
      {
        title: 'هل التراخيص والشهادات الصادرة معتمدة رسمياً لدى منصة بلدي والدفاع المدني؟',
        description:
          'نعم، كافة الشهادات والتقارير الهندسية تصدر وتوثق حصرياً عبر منصة بلدي التابعة لوزارة البلديات والإسكان، وبوابة سلامة للدفاع المدني، ومنصة مدينتي لأمانة جدة، وتعتمد من مكاتب وشركات هندسية وفنية مرخصة رسمياً.',
        icon: 'tabler:circle-check',
      },
      {
        title: 'كم يستغرق إصدار شهادة تركيب أدوات السلامة أو التقرير الفني؟',
        description:
          'نحرص على الإنجاز الفوري والسريع؛ حيث يتم تجهيز وتوثيق الشهادات الفورية والتقارير في وقت قياسي (غالباً في نفس اليوم) لتتمكن من إصدار أو تجديد رخصتك دون تعطيل نشاطك التجاري.',
        icon: 'tabler:clock',
      },
      {
        title: 'هل تغطي خدماتكم كافة مدن ومناطق المملكة؟',
        description:
          'نعم، تغطي خدماتنا جميع مناطق وأمانات المملكة: الرياض، جدة، مكة المكرمة، الدمام، المدينة المنورة، الخبر، القصيم، الطائف، تبوك، أبها، حائل، جازان، نجران، وكافة المحافظات.',
        icon: 'tabler:map-pin',
      },
      {
        title: 'ما هي المستندات المطلوبة للبدء في إصدار أو تجديد التراخيص؟',
        description:
          'المستندات الأساسية تشمل: رقم السجل التجاري الساري، العنوان الوطني للمنشأة، عقد الإيجار أو صك الملكية، ورخصة البناء إن وجدت، وصور واضحة للواجهة والموقع الداخلي.',
        icon: 'tabler:file-description',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        target: '_blank',
        text: 'تواصل معنا فوراً عبر الواتساب',
        href:
          'https://wa.me/966572140531?text=' +
          encodeURIComponent('السلام عليكم، أرغب في البدء بإجراءات تراخيص السلامة والبلدية لمنشأتي'),
        icon: 'tabler:brand-whatsapp',
      },
    ]}
    title="هل تحتاج لإصدار أو تجديد تراخيص منشأتك الآن؟"
    subtitle="لا تتردد في مراسلتنا وتزويدنا بمتطلباتك، لنتولى عنك إجراءات عقود السلامة، التقارير الفنية، وتراخيص الدفاع المدني والبلدية بأعلى سرعة واحترافية."
  />

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'BreadcrumbList',
          itemListElement: [
            {
              '@type': 'ListItem',
              position: 1,
              name: 'الرئيسية',
              item: 'https://topsafetypro.com/',
            },
            {
              '@type': 'ListItem',
              position: 2,
              name: 'خدماتنا',
              item: 'https://topsafetypro.com/services/',
            },
          ],
        },
        {
          '@type': 'ProfessionalService',
          '@id': 'https://topsafetypro.com/services/#service',
          name: 'خدمات تراخيص بلدي والدفاع المدني وعقود السلامة - توب سيفتي برو',
          description:
            'خدمات شاملة لإصدار وتجديد رخص البلدية ورخص الدفاع المدني، التقارير الفنية المعتمدة، شهادات تركيب أدوات السلامة، عقود صيانة السلامة السنوية، وعقود نظافة منصة مدينتي.',
          telephone: '+966572140531',
          url: 'https://topsafetypro.com/services/',
          areaServed: {
            '@type': 'Country',
            name: 'Saudi Arabia',
          },
          knowsAbout: [
            'بوابة سلامة للدفاع المدني',
            'منصة بلدي',
            'منصة مدينتي لأمانة جدة',
            'شهادة تركيب أدوات السلامة',
            'تقرير فني بلدي معتمد',
            'عقد صيانة سلامة سنوي',
            'تجديد رخصة البلدية',
            'تجديد ترخيص الدفاع المدني',
            'شهادة استيفاء كاميرات المراقبة',
            'عقد نظافة نفايات تجارية',
          ],
        },
        {
          '@type': 'FAQPage',
          mainEntity: [
            {
              '@type': 'Question',
              name: 'هل التراخيص والشهادات الصادرة معتمدة رسمياً لدى منصة بلدي والدفاع المدني؟',
              acceptedAnswer: {
                '@type': 'Answer',
                text: 'نعم، كافة الشهادات والتقارير الهندسية تصدر وتوثق حصرياً عبر منصة بلدي التابعة لوزارة البلديات والإسكان، وبوابة سلامة للدفاع المدني، ومنصة مدينتي لأمانة جدة، وتعتمد من مكاتب وشركات هندسية وفنية مرخصة رسمياً.',
              },
            },
            {
              '@type': 'Question',
              name: 'كم يستغرق إصدار شهادة تركيب أدوات السلامة أو التقرير الفني؟',
              acceptedAnswer: {
                '@type': 'Answer',
                text: 'نحرص على الإنجاز الفوري والسريع؛ حيث يتم تجهيز وتوثيق الشهادات الفورية والتقارير في وقت قياسي (غالباً في نفس اليوم) لتتمكن من إصدار أو تجديد رخصتك دون تعطيل نشاطك التجاري.',
              },
            },
            {
              '@type': 'Question',
              name: 'هل تغطي خدماتكم كافة مدن ومناطق المملكة؟',
              acceptedAnswer: {
                '@type': 'Answer',
                text: 'نعم، تغطي خدماتنا جميع مناطق وأمانات المملكة: الرياض، جدة، مكة المكرمة، الدمام، المدينة المنورة، الخبر، القصيم، الطائف، تبوك، أبها، حائل، جازان، نجران، وكافة المحافظات.',
              },
            },
            {
              '@type': 'Question',
              name: 'ما هي المستندات المطلوبة للبدء في إصدار أو تجديد التراخيص؟',
              acceptedAnswer: {
                '@type': 'Answer',
                text: 'المستندات الأساسية تشمل: رقم السجل التجاري الساري، العنوان الوطني للمنشأة، عقد الإيجار أو صك الملكية، ورخصة البناء إن وجدت، وصور واضحة للواجهة والموقع الداخلي.',
