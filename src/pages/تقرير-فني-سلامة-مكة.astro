  />

  <CallToAction
    id="contact"
    actions={[
      {
        variant: 'primary',
        text: 'تواصل معنا عبر الواتساب فوراً في مكة المكرمة',
        href: 'https://wa.me/966572140531',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
    ]}
  >
    <Fragment slot="title"> احصل على تقريرك الفني في مكة المكرمة الآن </Fragment>

    <Fragment slot="subtitle">
      لا تؤجل الحصول على تقريرك الفني المعتمد في مكة المكرمة. <br class="hidden md:inline" />تواصل معنا الآن وسنصدر
      تقريرك الفني بسرعة واحترافية في مكة المكرمة!
