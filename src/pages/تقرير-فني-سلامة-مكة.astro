---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'تقرير فني سلامة في مكة المكرمة - 0572140531',
  description: 'احصل على تقرير فني سلامة معتمد في مكة المكرمة بسرعة واحترافية عالية، مع خدمة متكاملة لتجهيز كافة مستندات وأنظمة السلامة لجميع المنشآت.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'طلب تقرير فني في مكة المكرمة فوراً',
        href: '#contact',
        icon: 'tabler:file-text',
      },
      { text: 'إكتشف خدماتنا', href: '#features' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'توب سيفتي برو لإصدار التقارير الفنية في مكة المكرمة' }}
  >
    <Fragment slot="title">
      تقرير فني سلامة في <span class="hidden xl:inline">مكة المكرمة</span>
      <span class="text-accent dark:text-white">المنطقة الغربية</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">منصة توب سيفتي برو</span> تقدم لك إصدار التقارير الفنية الفورية وغير الفورية في مكة المكرمة
        لتجديد رخصة البلدية والدفاع المدني بسرعة واحترافية.</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">توب سيفتي برو: اعتماد فوري في مكة المكرمة.</span>
      نخدم جميع أحياء مكة المكرمة: العزيزية، الشوقية، أجياد، المسفلة، العتيبية، وجميع أحياء مكة المكرمة.
    </Fragment>
  </Hero>

  <Note
    title="فلسفتنا:"
    description="السرعة الفائقة، الالتزام بالمعايير، وتسهيل الإجراءات النظامية لعملائنا في مكة المكرمة"
  />

  <Features
    id="features"
    tagline="المميزات والخدمات في مكة المكرمة"
    title="ما ستحصل عليه مع توب سيفتي برو في مكة المكرمة"
    subtitle="واحدة من أفضل الخدمات الهندسية المتكاملة في مكة المكرمة لإصدار شهادات وتراخيص السلامة بامتثال كامل لكود البناء."
    items={[
      {
        title: 'خبرة واسعة في سوق مكة المكرمة',
        description:
          'لدينا خبرة واسعة في سوق مكة المكرمة والمنطقة الغربية، ونفهم تماماً متطلبات البلديات والدفاع المدني في المنطقة.',
        icon: 'tabler:brand-tailwind',
      },
      {
        title: 'تقارير جاهزة للاستخدام',
        description:
          'نماذج وتقارير هندسية معتمدة ومختومة تناسب كافة الأنشطة التجارية في مكة المكرمة؛ من المحلات البسيطة إلى المجمعات الضخمة.',
        icon: 'tabler:components',
      },
      {
        title: 'معتمدون من الدفاع المدني',
        description: 'نحن مكتب هندسي معتمد من الدفاع المدني، مما يضمن قبول تقاريرك بشكل رسمي وسريع في جميع الجهات.',
        icon: 'tabler:list-check',
      },
      {
        title: 'سرعة في الإنجاز',
        description:
          'نضمن لك إصدار التقرير الفني في مكة المكرمة في نفس اليوم للتقارير الفورية، وفي أيام معدودة للتقارير غير الفورية.',
        icon: 'tabler:rocket',
      },
      {
        title: 'أسعار تنافسية',
        description:
          'نقدم أفضل الأسعار في سوق مكة المكرمة مع الحفاظ على أعلى مستويات الجودة والاحترافية في إعداد التقارير.',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'تغطية جميع أحياء مكة المكرمة',
        description:
          'نخدم جميع أحياء ومناطق مكة المكرمة بدون استثناء، بما فيها العزيزية، الشوقية، أجياد، المسفلة، العتيبية، وغيرها.',
        icon: 'tabler:bulb',
      },
    ]}
  />

  <Content
    isReversed
    tagline="داخل الخدمة في مكة المكرمة"
    title="خدمات السلامة المعتمدة في مكة المكرمة: دقة الفحص تلتقي مع معايير الدفاع المدني!"
    items={[
      {
        title: 'فحص ميداني شامل في مكة المكرمة',
        description:
          'يقوم فريقنا الهندسي بزيارة منشأتك في مكة المكرمة وفحص جميع أنظمة السلامة والتأكد من مطابقتها لاشتراطات الدفاع المدني.',
      },
      {
        title: 'تقارير معتمدة من الدفاع المدني',
        description:
          'نصدر تقارير فنية معتمدة ومختومة من مكتب هندسي معتمد لدى الدفاع المدني، مقبولة رسمياً في منصة بلدي.',
      },
      {
        title: 'متابعة حتى إصدار الترخيص',
        description:
          'نرافقك في جميع مراحل تقديم الطلب ومتابعته عبر منصة بلدي حتى إصدار الترخيص بنجاح وبدون أي ملاحظات.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1581094794329-c8112a89af12?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'فريق هندسي يفحص أنظمة السلامة في مكة المكرمة',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        ضمان سلامة منشأتك في مكة المكرمة
      </h3>
      نضمن لك الحصول على تقرير فني معتمد من الدفاع المدني في مكة المكرمة يلبي جميع متطلبات البلدية ويضمن سلامة منشأتك بشكل
      كامل.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isAfterContent
    items={[
      {
        title: 'فريق هندسي متخصص في مكة المكرمة',
        description: `لدينا فريق من المهندسين والفنيين المعتمدين ذوي خبرة واسعة في متطلبات السلامة في مكة المكرمة والمنطقة الغربية.`,
      },
      {
        title: 'خيارات متعددة للهيكلة المعمارية',
        description:
          'نغطي كافة التصاميم الهندسية ومخططات السلامة للمباني في مكة المكرمة لنجد البنية الأنسب التي تسهل مراجعة ملفك التجاري.',
      },
      {
        title: 'تصميم متجاوب بالكامل',
        description:
          'استعرض تقاريرك وتابع طلباتك في مكة المكرمة من أي جهاز بفضل التصميم المتجاوب السلس الذي يمنح العميل تجربة فريدة.',
      },
      {
        title: 'دمج وتوثيق المرفقات والصور',
        description:
          'نرفق الصور الميدانية والفواتير المعتمدة لشبكات السلامة في مكة المكرمة بشكل منظم يمنع رفض المعاملة من المنصات الحكومية.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?ixlib=rb-4.0.3&auto=format&fit=crop&w=2194&q=80',
      alt: 'مخططات هندسية معتمدة للسلامة في مكة المكرمة',
    }}
  >
    <Fragment slot="content">نضمن أن تواجدك النظامي في مكة المكرمة يمثلك ويمثل أمان منشأتك بشكل حقيقي.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'تفاعل وتجاوب سريع مع النظام',
        description:
          'نواكب كافة التحديثات في منصات التراخيص في مكة المكرمة لتفادي أي تأخير، مما يضمن بقاء منشأتك آمنة وقانونية دائماً.',
      },
      {
        title: 'تطوير وتحديث مستمر',
        description:
          'نتابع التعديلات الدورية في اشتراطات المديرية العامة للدفاع المدني في المنطقة الغربية لنقدم لك استشارات محدثة دائمًا.',
      },
      {
        title: 'كفاءة عالية في الوقت والموارد',
        description:
          'وفر على نفسك عناء البدء من الصفر أو مراجعة المعاملات المرفوضة في مكة المكرمة؛ اطلب التقرير من توب سيفتي برو وانطلق فوراً.',
      },
      {
        title: 'دعم هندسي متكامل للعملاء',
        description: `انضم إلى مئات المنشآت في مكة المكرمة التي وثقت بـ توب سيفتي برو، واستفد من الدعم الفني المتواصل طوال رحلة استخراج رخصتك.`,
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1611462985358-60d3498e0364?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'مهندسو سلامة يتابعون المشاريع في مكة المكرمة',
    }}
  >
    <Fragment slot="content">مصمم خصيصاً لدعم نمو واستقرار أعمالك التجارية في مكة المكرمة.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Steps
    title="احصل على تقريرك الفني المعتمد في مكة المكرمة وافتح منشأتك في أسرع وقت."
    items={[
      {
        title: 'الخطوة 1: <span class="font-medium">إرسال البيانات</span>',
        description:
          'ابدأ فوراً بتزويدنا بنوع النشاط وصور وسائل السلامة المتوفرة لديك في مكة المكرمة عبر الواتساب أو المنصة. فريقنا جاهز لاستلام طلبك في أي وقت.',
        icon: 'tabler:package',
      },
      {
        title: 'الخطوة 2: <span class="font-medium">التدقيق والمعاينة</span>',
        description:
          'يقوم مهندسونا في مكة المكرمة بمراجعة البيانات والتأكد من مطابقتها لاشتراطات البلدية والدفاع المدني بدقة متناهية لضمان خلوها من الأخطاء.',
        icon: 'tabler:letter-case',
      },
      {
        title: 'الخطوة 3: <span class="font-medium">اعتماد وإصدار التقرير</span>',
        description:
          'يتم ختم التقرير الهندسي ورفعه بالصيغة الرسمية المعتمدة لتتمكن من إرفاقه بمنصة بلدي في مكة المكرمة. دقة التصميم تضمن لك قبولاً فورياً.',
        icon: 'tabler:paint',
      },
      {
        title: 'جاهز! رخصتك بيدك',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616198814651-e71f960c3180?ixlib=rb-4.0.3&auto=format&fit=crop&w=987&q=80',
      alt: 'إصدار الترخيص بنجاح تام في مكة المكرمة',
    }}
  />

  <Features2
    title="خدمات السلامة في مكة المكرمة"
    subtitle="نقدم كافة المكونات والتقارير الهندسية اللازمة لتأمين المنشآت في مكة المكرمة وفق اشتراطات كود الحريق السعودي"
    tagline="خدماتنا في مكة المكرمة"
    items={[
      {
        title: 'تقرير فني سلامة فوري',
        description: 'إصدار تقرير فني فوري للأنشطة الصغيرة في مكة المكرمة عبر بوابة سلامة في نفس اليوم.',
        icon: 'flat-color-icons:template',
      },
      {
        title: 'تقرير فني سلامة غير فوري',
        description:
          'إصدار تقرير فني غير فوري يتطلب فحصاً ميدانياً وعقد صيانة للمنشآت المتوسطة والكبيرة في مكة المكرمة.',
        icon: 'flat-color-icons:gallery',
      },
      {
        title: 'شهادة تركيب أدوات الوقاية',
        description:
          'إصدار شهادة تركيب أدوات الوقاية والحماية من الحريق في مكة المكرمة بعد التأكد من جاهزية جميع الأنظمة.',
        icon: 'flat-color-icons:approval',
      },
      {
        title: 'عقود صيانة أنظمة السلامة',
        description: 'توفير عقود صيانة معتمدة لأنظمة السلامة في مكة المكرمة مع مكتب هندسي معتمد من الدفاع المدني.',
        icon: 'flat-color-icons:document',
      },
      {
        title: 'تجديد رخصة البلدية في مكة المكرمة',
        description:
          'خدمة متكاملة لتجديد رخصة البلدية في مكة المكرمة مع تجهيز جميع المستندات ومتابعة الطلب حتى الإصدار.',
        icon: 'flat-color-icons:advertising',
      },
      {
        title: 'تجديد ترخيص الدفاع المدني في مكة المكرمة',
        description: 'تجديد ترخيص الدفاع المدني في مكة المكرمة بسرعة واحترافية مع فحص جميع معدات السلامة.',
        icon: 'flat-color-icons:currency-exchange',
      },
      {
        title: 'شهادة استيفاء كاميرات المراقبة',
        description: 'إصدار شهادة استيفاء كاميرات المراقبة في مكة المكرمة حسب متطلبات البلدية للمنشآت التجارية.',
        icon: 'flat-color-icons:voice-presentation',
      },
      {
        title: 'استشارات هندسية وقائية',
        description: 'تقديم استشارات هندسية وقائية للمنشآت في مكة المكرمة لضمان الامتثال الكامل لاشتراطات السلامة.',
        icon: 'flat-color-icons:business-contact',
      },
      {
        title: 'دعم على مدار الساعة',
        description: 'فريقنا متاح على مدار الساعة لخدمتك في مكة المكرمة والإجابة على جميع استفساراتك.',
        icon: 'flat-color-icons:database',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <BlogLatestPosts
    title="تصفح آخر مستجدات اشتراطات السلامة في مكة المكرمة بالمدونة"
    information={`نشاركك دورياً شروحات مفصلة حول كود البناء السعودي واشتراطات منصة بلدي والدفاع المدني في مكة المكرمة والمنطقة الغربية.
                  كل مقال جديد نطرحه يمثل خطوة هامة تمكنك من حماية منشأتك وتفادي تأخير التراخيص لتصبح خبيراً في إدارة شؤون منشأتك.
                  الوقاية هي استثمارك الذكي. شكراً لثقتكم.
                `}
  />

  <FAQs
    title="الأسئلة الشائعة"
    subtitle="تعمق في الإجابات التالية للحصول على فهم شامل حول التقارير الفنية في مكة المكرمة وكيف يمكن لمنصتنا تسريع أعمالك التجارية."
    tagline="الأسئلة الشائعة في مكة المكرمة"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'هل تقدمون خدمة التقرير الفني في جميع أحياء مكة المكرمة؟',
        description:
          'نعم، نغطي جميع أحياء ومناطق مكة المكرمة بدون استثناء، بما فيها العزيزية، الشوقية، أجياد، المسفلة، العتيبية، وجميع أحياء مكة المكرمة.',
      },
      {
        title: 'كم يستغرق إصدار التقرير الفني في مكة المكرمة؟',
        description:
          'التقرير الفوري يصدر في نفس اليوم، أما غير الفوري فيستغرق عدة أيام بعد الفحص الميداني. نسعى دائماً لتسريع الإجراءات قدر الإمكان.',
      },
      {
        title: 'هل يمكن التواصل معكم عبر واتساب؟',
        description:
          'نعم، يمكنك التواصل معنا عبر واتساب على الرقم 966572140531+ في أي وقت، وفريقنا جاهز للرد عليك ومتابعة معاملتك في مكة المكرمة.',
      },
      {
        title: 'ما هو التقرير الفني؟',
        description:
          'التقرير الفني مستند هندسي يصدر عن مكتب هندسي معتمد من الدفاع المدني يوثق مدى التزام المنشأة باشتراطات السلامة في مكة المكرمة.',
      },
      {
        title: 'من يحتاج التقرير الفني في مكة المكرمة؟',
        description:
          'جميع المنشآت التجارية والصناعية في مكة المكرمة عند إصدار أو تجديد رخصة البلدية أو ترخيص الدفاع المدني تحتاج إلى تقرير فني معتمد.',
      },
      {
        title: 'ما الفرق بين التقرير الفوري وغير الفوري؟',
        description:
          'التقرير الفوري للأنشطة الصغيرة ويصدر آلياً في نفس اليوم، أما غير الفوري فيتطلب فحصاً ميدانياً وعقد صيانة ويستغرق عدة أيام.',
      },
    ]}
  />

  <Stats
    stats={[
      { title: 'تقرير فني صادر في مكة المكرمة', amount: '+2K' },
      { title: 'منشأة في مكة المكرمة تم تأمينها', amount: '+1.6K' },
      { title: 'تقييمات إيجابية في مكة المكرمة', amount: '100%' },
      { title: 'أحياء مكة المكرمة المخدومة', amount: '25+' },
