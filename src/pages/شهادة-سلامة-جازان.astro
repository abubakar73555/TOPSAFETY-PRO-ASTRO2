---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'شهادة تركيب أدوات السلامة في جازان - 0572140531',
  description: 'إصدار معتمد لشهادة تركيب أدوات السلامة في جازان، مع الفحص الشامل وتلبية كافة معايير ومتطلبات الدفاع المدني بكل دقة واحترافية.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'طلب شهادة السلامة في جازان فوراً',
        href: '#contact',
        icon: 'tabler:file-text',
      },
      { text: 'اكتشف خدماتنا', href: '#features' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'توب سيفتي برو لشهادة تركيب أدوات السلامة في جازان' }}
  >
    <Fragment slot="title">
      شهادة تركيب <span class="hidden xl:inline">أدوات السلامة</span>
      <span class="text-accent dark:text-white">في جازان</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">منصة توب سيفتي برو</span> تقدم لك خدمة إصدار شهادة تركيب أدوات الوقاية والحماية من الحريق
        في جازان (منطقة جازان) لجميع المنشآت التجارية والصناعية عبر بوابة سلامة، معتمدة من الدفاع المدني.</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">توب سيفتي برو: شهادة سلامة معتمدة في جازان.</span>
      نخدم جميع أحياء جازان: حي الروضة، حي الشاطئ، حي المروج، حي النهضة، وجميع أحياء منطقة جازان.
    </Fragment>
  </Hero>

  <Note
    title="فلسفتنا:"
    description="السرعة الفائقة، الالتزام بمعايير السلامة، وتسهيل إجراءات إصدار شهادة تركيب أدوات السلامة لعملائنا في جازان"
  />

  <Features
    id="features"
    tagline="المميزات والخدمات في جازان"
    title="ما ستحصل عليه مع توب سيفتي برو في جازان"
    subtitle="واحدة من أفضل الخدمات المتكاملة في جازان لإصدار شهادة تركيب أدوات الوقاية والحماية من الحريق بامتثال كامل لأنظمة الدفاع المدني."
    items={[
      {
        title: 'خبرة واسعة في جازان',
        description: 'لدينا خبرة واسعة في سوق جازان، ونفهم تماماً متطلبات الدفاع المدني في المنطقة.',
        icon: 'tabler:brand-tailwind',
      },
      {
        title: 'شهادة معتمدة من الدفاع المدني',
        description:
          'نصدر شهادة تركيب أدوات السلامة المعتمدة من الدفاع المدني، المرتبطة مع منصة بلدي لإصدار وتجديد الرخص التجارية.',
        icon: 'tabler:components',
      },
      {
        title: 'فحص شامل لأدوات السلامة',
        description:
          'نقوم بفحص جميع أدوات الوقاية والحماية من الحريق في منشأتك في جازان للتأكد من جاهزيتها واستيفائها للمعايير.',
        icon: 'tabler:list-check',
      },
      {
        title: 'سرعة في الإنجاز',
        description: 'نضمن لك إنجاز المعاملة وإصدار الشهادة في جازان في أيام معدودة لتجنب الغرامات.',
        icon: 'tabler:rocket',
      },
      {
        title: 'أسعار تنافسية',
        description: 'نقدم أفضل الأسعار في سوق جازان مع الحفاظ على أعلى مستويات الجودة والاحترافية.',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'تغطية جميع أحياء جازان',
        description: 'نخدم جميع أحياء ومناطق جازان بدون استثناء، بما فيها حي الروضة، الشاطئ، المروج، النهضة، وغيرها.',
        icon: 'tabler:bulb',
      },
    ]}
  />

