    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'تفاعل وتجاوب سريع مع النظام',
        description:
          'نواكب كافة التحديثات في بوابة سلامة ومنصة بلدي في جازان لتفادي أي تأخير، مما يضمن بقاء شهادتك سارية دائماً.',
      },
      {
        title: 'تطوير وتحديث مستمر',
        description:
          'نتابع التعديلات الدورية في اشتراطات الدفاع المدني في منطقة جازان لنقدم لك استشارات محدثة دائماً ومتوافقة مع أحدث الأنظمة.',
      },
      {
        title: 'كفاءة عالية في الوقت والموارد',
        description:
          'وفر على نفسك عناء البدء من الصفر أو مراجعة المعاملات المرفوضة في جازان؛ اطلب شهادة السلامة من توب سيفتي برو وانطلق فوراً.',
      },
      {
        title: 'حلول مبتكرة للمشاكل المعقدة',
        description: `إذا كانت منشأتك في جازان تفتقر لبعض أدوات السلامة، نقدم لك حلولاً ذكية للتوافق مع النظام دون تكاليف باهظة أو تأخير.`,
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1552664730-d307ca884978?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'فريق عمل يتابع مشاريع السلامة في جازان',
    }}
  >
    <Fragment slot="content">مصمم خصيصاً لدعم نمو واستقرار أعمالك التجارية في جازان.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Steps
    title="احصل على شهادة تركيب أدوات السلامة المعتمدة في جازان وافتح منشأتك بأمان."
    items={[
      {
        title: 'الخطوة 1: <span class="font-medium">فحص أدوات السلامة</span>',
        description:
          'نقوم بفحص شامل لجميع أدوات الوقاية والحماية من الحريق في منشأتك في جازان، بما في ذلك طفايات الحريق، أنظمة الإنذار، والإخلاء، للتأكد من جاهزيتها.',
        icon: 'tabler:package',
