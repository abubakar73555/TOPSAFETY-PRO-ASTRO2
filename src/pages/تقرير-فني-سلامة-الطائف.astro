    isReversed
    tagline="داخل الخدمة في الطائف"
    title="مخطط توب سيفتي برو في الطائف: دقة التنفيذ تلتقي مع معايير السلامة!"
    items={[
      {
        title: 'الاعتماد على كود البناء السعودي',
        description:
          'نصيغ تقاريرنا في الطائف استناداً إلى أحدث الأنظمة واللوائح المعتمدة بالمملكة لضمان جودة هندسية لا غبار عليها.',
      },
      {
        title: 'تنسيق متوافق مع كود Tailwind CSS v4',
        description:
          'تم بناء المنصة بأحدث التقنيات البرمجية لضمان تصفح سريع جداً وخفيف لعملائنا في الطائف من الجوال أو الكمبيوتر.',
      },
      {
        title: 'توافق شامل ومتكامل',
        description:
          'نضمن أن تقاريرنا ومخططاتنا في الطائف تكون متوافقة ومفهومة لدى كافة الجهات الميدانية والإلكترونية المعنية بالترخيص.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'فريق هندسي يفحص وسائل سلامة في الطائف',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        التأسيس على قواعد هندسية حديثة في الطائف
      </h3>
      احصل على الأفضلية النظامية في الطائف من خلال تطبيق أفضل ممارسات الوقاية والحماية المعتمدة.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isAfterContent
    items={[
      {
        title: 'مرونة وتخصيص لا محدود',
        description: `نقوم بتطويع التقرير الفني ليتناسب تماماً مع متطلبات وهوية نشاطك التجاري في الطائف، مما يحميك ويختصر وقتك وجهدك.`,
      },
      {
        title: 'خيارات متعددة للهيكلة المعمارية',
        description:
          'نغطي كافة التصاميم الهندسية ومخططات السلامة للمباني في الطائف لنجد البنية الأنسب التي تسهل مراجعة ملفك التجاري.',
      },
      {
        title: 'تصميم متجاوب بالكامل',
        description:
          'استعرض تقاريرك وتابع طلباتك في الطائف من أي جهاز بفضل التصميم المتجاوب السلس الذي يمنح العميل تجربة فريدة.',
      },
      {
        title: 'دمج وتوثيق المرفقات والصور',
        description:
