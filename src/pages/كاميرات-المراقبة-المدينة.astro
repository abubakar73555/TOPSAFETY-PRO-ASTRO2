      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1558618666-fcd25c85f82e?ixlib=rb-4.0.3&auto=format&fit=crop&w=987&q=80',
      alt: 'كاميرا مراقبة أمنية في المدينة المنورة',
    }}
  />

  <Features2
    title="متطلبات شهادة استيفاء كاميرات المراقبة في المدينة المنورة"
