---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'شهادة استيفاء كاميرات المراقبة في المدينة المنورة - 0572140531',
  description: 'إصدار شهادة استيفاء كاميرات المراقبة الأمنية في المدينة المنورة بمعايير معتمدة، مع الفحص والتركيب المتوافق مع اللوائح والاشتراطات الرسمية بكل دقة.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'طلب شهادة الكاميرات في المدينة المنورة فوراً',
        href: '#contact',
        icon: 'tabler:camera',
      },
      { text: 'اكتشف خدماتنا', href: '#features' },
    ]}
    image={{
      src: '~/assets/images/hero-image.png',
      alt: 'توب سيفتي برو لشهادة استيفاء كاميرات المراقبة في المدينة المنورة',
    }}
  >
    <Fragment slot="title">
      شهادة استيفاء <span class="hidden xl:inline">كاميرات المراقبة</span>
      <span class="text-accent dark:text-white">في المدينة المنورة</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">منصة توب سيفتي برو</span> تقدم لك خدمة إصدار شهادة استيفاء تركيب كاميرات المراقبة في المدينة
        المنورة (المنطقة الغربية) لجميع المنشآت التجارية، معتمدة من الشرطة السعودية.</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600"
        >توب سيفتي برو: شهادة كاميرات معتمدة في المدينة المنورة.</span
      >
      نخدم جميع أحياء المدينة المنورة: حي العزيزية، حي قباء، حي أحد، حي الخالدية، وجميع أحياء منطقة المدينة المنورة.
    </Fragment>
  </Hero>

  <Note
    title="فلسفتنا:"
    description="السرعة الفائقة، الالتزام بالمعايير الأمنية، وتسهيل إجراءات إصدار شهادة استيفاء كاميرات المراقبة لعملائنا في المدينة المنورة"
  />

  <Features
    id="features"
    tagline="المميزات والخدمات في المدينة المنورة"
    title="ما نقدمه في شهادة كاميرات المراقبة بالمدينة المنورة"
    subtitle="خدمات متكاملة لتسهيل حصولك على شهادة استيفاء كاميرات المراقبة المعتمدة من الشرطة السعودية في المدينة المنورة."
    items={[
      {
        title: 'خبرة في اشتراطات المدينة المنورة',
        description: 'فهم دقيق لمتطلبات الشرطة السعودية وأمانة منطقة المدينة المنورة لأنظمة المراقبة والأمن.',
        icon: 'tabler:camera',
      },
      {
        title: 'شهادة معتمدة رسمياً',
        description:
          'نصدر شهادة استيفاء تركيب الكاميرات المعتمدة والمطلوبة للرخص البلدية والتجارية في المدينة المنورة.',
        icon: 'tabler:certificate',
      },
      {
        title: 'فحص أنظمة المراقبة',
        description:
          'نتأكد من توافق كاميراتك مع الاشتراطات الأمنية من حيث العدد والزوايا ومدة التسجيل في المدينة المنورة.',
        icon: 'tabler:search',
      },
      {
        title: 'سرعة في الإنجاز',
        description: 'نضمن إصدار الشهادة في أيام معدودة لتجنب أي تأخير في تجديد تراخيصك في المدينة المنورة.',
        icon: 'tabler:rocket',
      },
      {
        title: 'أسعار تنافسية',
        description: 'نقدم أفضل الأسعار في المدينة المنورة مع الحفاظ على أعلى مستويات الجودة والاحترافية.',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'تغطية جميع أحياء المدينة المنورة',
        description: 'نخدم جميع أحياء المدينة المنورة بدون استثناء، بما فيها العزيزية، قباء، أحد، الخالدية، وغيرها.',
        icon: 'tabler:map-pin',
      },
    ]}
  />

