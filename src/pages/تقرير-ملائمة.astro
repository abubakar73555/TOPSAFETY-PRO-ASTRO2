---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'تقرير ملائمة - 0572140531',
  description: 'احصل على تقرير ملائمة معتمد ومستوفي لكافة الشروط والمتطلبات الرسمية للمنشآت، بسرعة واحترافية عالية لضمان إنجاز معاملاتك.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'احصل على تقرير الملائمة الآن',
        href: '#contact',
        icon: 'tabler:file-text',
      },
      { text: 'إكتشف خدماتنا', href: '#features' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'توب سيفتي برو لإعداد تقرير ملائمة أدوات السلامة' }}
  >
    <Fragment slot="title">
      تقرير <span class="hidden xl:inline">ملائمة</span>
      <span class="text-accent dark:text-white">أدوات السلامة</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">منصة توب سيفتي برو</span> تقدم لك إعداد تقرير ملائمة لأدوات السلامة وفق متطلبات الدفاع
        المدني للمواقع التجارية. مكتب هندسي معتمد.</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">توب سيفتي برو: اعتماد فوري.</span>
      مكتب هندسي معتمد من الدفاع المدني، نخدم جميع مدن المملكة العربية السعودية: جدة، الرياض، مكة، الدمام، المدينة، الطائف،
      الخبر، القصيم.
    </Fragment>
  </Hero>

  <Note title="فلسفتنا:" description="السرعة الفائقة، الالتزام بالمعايير، وتسهيل الإجراءات النظامية لعملائنا" />

  <Features
    id="features"
    tagline="المميزات والخدمات"
    title="ما ستحصل عليه مع توب سيفتي برو"
    subtitle="واحدة من أفضل الخدمات الهندسية المتكاملة في السوق السعودي لإعداد تقرير الملائمة بامتثال كامل لكود البناء واشتراطات الدفاع المدني."
    items={[
      {
        title: 'مكتب هندسي معتمد',
        description: 'نحن مكتب هندسي معتمد من الدفاع المدني، مما يضمن قبول تقاريرك رسمياً في جميع الجهات.',
        icon: 'tabler:brand-tailwind',
      },
      {
        title: 'تقييم شامل للموقع',
        description: 'نقوم بتقييم مدى تطابق الموقع مع متطلبات السلامة اللازمة وفقاً لنوع النشاط والمساحة.',
        icon: 'tabler:components',
      },
      {
        title: 'تحديد الأدوات المطلوبة',
        description: 'نحدد الأدوات والمعدات المطلوبة حسب نوع النشاط لضمان الامتثال الكامل لاشتراطات الدفاع المدني.',
        icon: 'tabler:list-check',
      },
      {
        title: 'سرعة في الإنجاز',
        description: 'نضمن لك إعداد التقرير في أسرع وقت ممكن دون التأثير على جودة التقييم ودقة الفحص.',
        icon: 'tabler:rocket',
      },
      {
        title: 'أسعار تنافسية',
        description: 'نقدم أفضل الأسعار في السوق مع الحفاظ على أعلى مستويات الجودة والاحترافية في إعداد التقارير.',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'تغطية جميع المدن',
        description:
          'نخدم جميع مدن المملكة العربية السعودية: جدة، الرياض، مكة، الدمام، المدينة، الطائف، الخبر، القصيم.',
        icon: 'tabler:bulb',
      },
    ]}
  />

  <Content
    isReversed
    tagline="ما هو تقرير الملائمة؟"
    title="تقرير الملائمة: ضمان تطابق موقعك مع متطلبات السلامة"
    items={[
      {
        title: 'تعريف تقرير الملائمة',
        description:
          'يُعد إعداد تقرير ملائمة لأدوات السلامة من الحريق جزءاً أساسياً لضمان التزام المنشآت التجارية بالاشتراطات والمعايير التي يحددها الدفاع المدني. يهدف التقرير إلى تقييم مدى تطابق الموقع مع متطلبات السلامة اللازمة وفقاً لنوع النشاط.',
      },
      {
        title: 'أهمية تقرير الملائمة',
        description:
          'يساعد تقرير الملائمة في ضمان وجود أنظمة فعالة للحماية من الحريق، وتحديد الأدوات والمعدات المطلوبة حسب نوع النشاط، وإعداد تقرير شامل وفق معايير الدفاع المدني.',
      },
      {
        title: 'متابعة تنفيذ التوصيات',
        description:
          'نرافقك في جميع مراحل تنفيذ التوصيات حتى الحصول على الاعتماد النهائي، مما يضمن امتثالك الكامل لاشتراطات السلامة.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1581094794329-c8112a89af12?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'تقرير ملائمة أدوات السلامة',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">ضمان سلامة منشأتك</h3>
      نضمن لك الحصول على تقرير ملائمة معتمد من الدفاع المدني يلبي جميع متطلبات البلدية ويضمن سلامة منشأتك بشكل كامل.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isAfterContent
    items={[
      {
        title: 'تقييم مدى تطابق الموقع',
        description: `نقوم بتقييم شامل لموقعك للتأكد من تطابقه مع متطلبات السلامة اللازمة وفقاً لنوع النشاط والمساحة.`,
      },
      {
        title: 'ضمان وجود أنظمة فعالة',
        description:
          'نتأكد من وجود أنظمة فعالة للحماية من الحريق في موقعك، مثل طفايات الحريق وأنظمة الإنذار وكواشف الدخان.',
      },
      {
        title: 'تحديد الأدوات المطلوبة',
        description: 'نحدد الأدوات والمعدات المطلوبة حسب نوع النشاط لضمان الامتثال الكامل لاشتراطات الدفاع المدني.',
      },
      {
        title: 'إعداد تقرير شامل',
        description:
          'نعد تقريراً شاملاً وفق معايير الدفاع المدني، يتضمن جميع التوصيات اللازمة لتحسين مستوى السلامة في موقعك.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1581092160607-ee22621dd758?ixlib=rb-4.0.3&auto=format&fit=crop&w=2194&q=80',
      alt: 'ما يشمله تقرير الملائمة',
    }}
  >
    <Fragment slot="content">نضمن لك تقرير ملائمة شامل ومفصل يلبي جميع المتطلبات.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'متابعة تنفيذ التوصيات',
        description:
          'نرافقك في جميع مراحل تنفيذ التوصيات حتى الحصول على الاعتماد النهائي، مما يضمن امتثالك الكامل لاشتراطات السلامة.',
      },
      {
        title: 'فريق هندسي متخصص',
        description: 'لدينا فريق من المهندسين والفنيين المعتمدين ذوي خبرة واسعة في تقييم مواقع المنشآت التجارية.',
      },
      {
        title: 'أسعار تنافسية',
        description: 'نقدم أفضل الأسعار في السوق مع الحفاظ على أعلى مستويات الجودة والاحترافية في إعداد التقارير.',
      },
      {
        title: 'دعم على مدار الساعة',
        description: `فريقنا متاح على مدار الساعة لخدمتك والإجابة على جميع استفساراتك في أي وقت.`,
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1581092918056-0c4c3acd3789?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'لماذا تختارنا؟',
    }}
  >
    <Fragment slot="content">نوفر لك تقرير ملائمة معتمد بسرعة واحترافية في جميع مدن المملكة.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Steps
    title="احصل على تقرير الملائمة المعتمد في أسرع وقت."
    items={[
      {
        title: 'الخطوة 1: <span class="font-medium">تقديم الطلب</span>',
        description:
          'تواصل معنا عبر الواتساب أو الهاتف وقدم بيانات منشأتك الأساسية: نوع النشاط، المساحة، الموقع، وعدد الأدوار.',
        icon: 'tabler:package',
      },
      {
        title: 'الخطوة 2: <span class="font-medium">الفحص الميداني</span>',
        description:
          'يقوم فريقنا الهندسي بزيارة موقعك وفحص جميع أنظمة السلامة والتأكد من مطابقتها لاشتراطات الدفاع المدني.',
        icon: 'tabler:letter-case',
      },
      {
        title: 'الخطوة 3: <span class="font-medium">إعداد التقرير</span>',
        description:
          'يتم إعداد تقرير الملائمة بناءً على نتائج الفحص الميداني، مع تحديد الأدوات والمعدات المطلوبة حسب نوع النشاط.',
        icon: 'tabler:paint',
      },
      {
        title: 'الخطوة 4: <span class="font-medium">اعتماد التقرير</span>',
        description: 'يتم اعتماد التقرير من المكتب الهندسي المعتمد وتسليمه لك بشكل رسمي معتمد ومختوم، جاهز لرفع الطلب.',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1450101499163-c8848c66ca85?ixlib=rb-4.0.3&auto=format&fit=crop&w=987&q=80',
      alt: 'خطوات إعداد تقرير الملائمة',
    }}
  />

  <Features2
    title="ما يشمله تقرير الملائمة"
    subtitle="نقدم لك تقرير ملائمة شامل ومفصل يضمن لك الامتثال الكامل لاشتراطات الدفاع المدني"
    tagline="خدماتنا"
    items={[
      {
        title: 'تقييم مدى تطابق الموقع',
        description: 'نقوم بتقييم شامل لموقعك للتأكد من تطابقه مع متطلبات السلامة اللازمة وفقاً لنوع النشاط والمساحة.',
        icon: 'flat-color-icons:template',
      },
      {
        title: 'ضمان وجود أنظمة فعالة',
        description:
          'نتأكد من وجود أنظمة فعالة للحماية من الحريق في موقعك، مثل طفايات الحريق وأنظمة الإنذار وكواشف الدخان.',
        icon: 'flat-color-icons:gallery',
      },
      {
        title: 'تحديد الأدوات المطلوبة',
        description: 'نحدد الأدوات والمعدات المطلوبة حسب نوع النشاط لضمان الامتثال الكامل لاشتراطات الدفاع المدني.',
        icon: 'flat-color-icons:approval',
      },
      {
        title: 'إعداد تقرير شامل',
        description:
          'نعد تقريراً شاملاً وفق معايير الدفاع المدني، يتضمن جميع التوصيات اللازمة لتحسين مستوى السلامة في موقعك.',
        icon: 'flat-color-icons:document',
      },
      {
        title: 'متابعة تنفيذ التوصيات',
        description: 'نرافقك في جميع مراحل تنفيذ التوصيات حتى الحصول على الاعتماد النهائي، مما يضمن امتثالك الكامل.',
        icon: 'flat-color-icons:advertising',
      },
      {
        title: 'فريق هندسي متخصص',
        description: 'لدينا فريق من المهندسين والفنيين المعتمدين ذوي خبرة واسعة في تقييم مواقع المنشآت التجارية.',
        icon: 'flat-color-icons:currency-exchange',
      },
      {
        title: 'أسعار تنافسية',
        description: 'نقدم أفضل الأسعار في السوق مع الحفاظ على أعلى مستويات الجودة والاحترافية في إعداد التقارير.',
        icon: 'flat-color-icons:voice-presentation',
      },
      {
        title: 'سرعة في الإنجاز',
        description: 'نضمن لك إعداد التقرير في أسرع وقت ممكن دون التأثير على جودة التقييم ودقة الفحص.',
        icon: 'flat-color-icons:business-contact',
      },
      {
        title: 'تغطية جميع المدن',
        description:
          'نخدم جميع مدن المملكة العربية السعودية: جدة، الرياض، مكة، الدمام، المدينة، الطائف، الخبر، القصيم.',
        icon: 'flat-color-icons:database',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <BlogLatestPosts
    title="تصفح آخر مستجدات اشتراطات السلامة بالمدونة"
    information={`نشاركك دورياً شروحات مفصلة حول كود البناء السعودي واشتراطات منصة بلدي والدفاع المدني.
                  كل مقال جديد نطرحه يمثل خطوة هامة تمكنك من حماية منشأتك وتفادي تأخير التراخيص لتصبح خبيراً في إدارة شؤون منشأتك.
                  الوقاية هي استثمارك الذكي. شكراً لثقتكم.
                `}
  />

  <FAQs
    title="الأسئلة الشائعة"
    subtitle="تعمق في الإجابات التالية للحصول على فهم شامل حول تقرير الملائمة وكيف يمكن لمنصتنا تسريع أعمالك التجارية."
    tagline="الأسئلة الشائعة"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'ما هو تقرير الملائمة؟',
        description:
          'تقرير يهدف إلى تقييم مدى تطابق الموقع مع متطلبات السلامة وفقاً لنوع النشاط ومتطلبات الدفاع المدني.',
      },
      {
        title: 'هل تقرير الملائمة مطلوب لجميع الأنشطة؟',
        description: 'يختلف حسب نوع النشاط والمساحة، تواصل معنا لمعرفة ما إذا كان نشاطك يحتاجه.',
      },
      {
        title: 'كم يستغرق إعداد تقرير الملائمة؟',
        description: 'يتم إعداد التقرير في أسرع وقت ممكن بعد الفحص الميداني، عادة خلال أيام قليلة حسب حجم المنشأة.',
      },
      {
        title: 'ما هي متطلبات الحصول على تقرير الملائمة؟',
        description:
          'تحتاج إلى تزويدنا ببيانات المنشأة الأساسية: نوع النشاط، المساحة، الموقع، وعدد الأدوار، مع صور لوسائل السلامة المتوفرة.',
      },
      {
        title: 'هل التقرير مقبول لدى جميع الجهات؟',
        description:
          'نعم، جميع تقاريرنا الصادرة من مكتب هندسي معتمد ومختومة رسمياً ومقبولة بشكل مباشر في نظام بلدي والدفاع المدني بكافة مناطق المملكة العربية السعودية.',
      },
      {
        title: 'ماذا لو كانت المنشأة لا تستوفي بعض الاشتراطات؟',
        description:
          'فريقنا الهندسي يقدم لك استشارات فورية لحل أي نواقص في أنظمة السلامة وتجهيزها بالكامل قبل إصدار التقرير النهائي، بأقل تكلفة وأعلى جودة.',
      },
    ]}
  />

  <Stats
    stats={[
      { title: 'تقرير ملائمة صادر', amount: '+1.5K' },
      { title: 'منشأة تم تقييمها', amount: '+1.2K' },
      { title: 'تقييمات إيجابية', amount: '100%' },
      { title: 'مدن المملكة المخدومة', amount: '13+' },
    ]}
  />

  <CallToAction
    id="contact"
    actions={[
      {
        variant: 'primary',
        text: 'تواصل معنا عبر الواتساب فوراً',
        href: 'https://wa.me/966572140531',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
    ]}
  >
    <Fragment slot="title"> احصل على تقرير الملائمة الآن </Fragment>

    <Fragment slot="subtitle">
      نحن مكتب هندسي معتمد من الدفاع المدني، نعد تقرير الملائمة بسرعة واحترافية في جميع مدن المملكة. <br
        class="hidden md:inline"
      />تواصل معنا الآن!
    </Fragment>
  </CallToAction>
</Layout>
