---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'شهادة استيفاء كاميرات المراقبة في الدمام - 0572140531',
  description: 'إصدار شهادة استيفاء كاميرات المراقبة الأمنية في الدمام بمعايير معتمدة، مع الفحص والتركيب المتوافق مع اللوائح والاشتراطات الرسمية بكل دقة.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'طلب شهادة الكاميرات في الدمام فوراً',
        href: '#contact',
        icon: 'tabler:camera',
      },
      { text: 'اكتشف خدماتنا', href: '#features' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'توب سيفتي برو لشهادة استيفاء كاميرات المراقبة في الدمام' }}
  >
    <Fragment slot="title">
      شهادة استيفاء <span class="hidden xl:inline">كاميرات المراقبة</span>
      <span class="text-accent dark:text-white">في الدمام</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">منصة توب سيفتي برو</span> تقدم لك خدمة إصدار شهادة استيفاء تركيب كاميرات المراقبة في الدمام
        (المنطقة الشرقية) لجميع المنشآت التجارية، معتمدة من الشرطة السعودية.</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">توب سيفتي برو: شهادة كاميرات معتمدة في الدمام.</span>
      نخدم جميع أحياء الدمام: حي الشاطئ، حي الفيصلية، حي الأثير، حي السيف، وجميع أحياء المنطقة الشرقية.
    </Fragment>
  </Hero>

  <Note
    title="فلسفتنا:"
    description="السرعة الفائقة، الالتزام بالمعايير الأمنية، وتسهيل إجراءات إصدار شهادة استيفاء كاميرات المراقبة لعملائنا في الدمام"
  />

  <Features
    id="features"
    tagline="المميزات والخدمات في الدمام"
    title="ما نقدمه في شهادة كاميرات المراقبة بالدمام"
    subtitle="خدمات متكاملة لتسهيل حصولك على شهادة استيفاء كاميرات المراقبة المعتمدة من الشرطة السعودية في الدمام."
    items={[
      {
        title: 'خبرة في اشتراطات الدمام',
        description: 'فهم دقيق لمتطلبات الشرطة السعودية وأمانة المنطقة الشرقية لأنظمة المراقبة والأمن.',
        icon: 'tabler:camera',
      },
      {
        title: 'شهادة معتمدة رسمياً',
        description: 'نصدر شهادة استيفاء تركيب الكاميرات المعتمدة والمطلوبة للرخص البلدية والتجارية في الدمام.',
        icon: 'tabler:certificate',
      },
      {
        title: 'فحص أنظمة المراقبة',
        description: 'نتأكد من توافق كاميراتك مع الاشتراطات الأمنية من حيث العدد والزوايا ومدة التسجيل في الدمام.',
        icon: 'tabler:search',
      },
      {
        title: 'سرعة في الإنجاز',
        description: 'نضمن إصدار الشهادة في أيام معدودة لتجنب أي تأخير في تجديد تراخيصك في الدمام.',
        icon: 'tabler:rocket',
      },
      {
        title: 'أسعار تنافسية',
        description: 'نقدم أفضل الأسعار في الدمام مع الحفاظ على أعلى مستويات الجودة والاحترافية.',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'تغطية جميع أحياء الدمام',
        description: 'نخدم جميع أحياء الدمام بدون استثناء، بما فيها الشاطئ، الفيصلية، الأثير، السيف، وغيرها.',
        icon: 'tabler:map-pin',
      },
    ]}
  />

  <Content
    isReversed
    tagline="داخل الخدمة في الدمام"
    title="خطوات إصدار شهادة استيفاء الكاميرات في الدمام"
    items={[
      {
        title: 'فحص أنظمة المراقبة',
        description:
          'نتحقق من تركيب الكاميرات وعددها وزوايا التصوير ومدة التسجيل حسب اشتراطات الشرطة السعودية في الدمام.',
      },
      {
        title: 'تجهيز المستندات المطلوبة',
        description: 'نجهز التقارير الفنية وقوائم الكاميرات وعقود الصيانة اللازمة لتقديم طلب الشهادة.',
      },
      {
        title: 'إصدار الشهادة المعتمدة',
        description: 'نقوم بإصدار شهادة استيفاء تركيب الكاميرات المعتمدة رسمياً من الشرطة السعودية في الدمام.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1558001373-7b93ee48ffaa?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'فني يراجع كاميرات المراقبة في الدمام',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">لماذا تختارنا في الدمام؟</h3>
      خبرة في اشتراطات الكاميرات بالدمام، سرعة في الإنجاز، شهادة معتمدة، أسعار تنافسية، تغطية شاملة، دعم على مدار الساعة.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isAfterContent
    items={[
      {
        title: 'المحلات التجارية والمطاعم',
        description: `إصدار شهادة استيفاء الكاميرات لجميع المحلات والمطاعم في الدمام لاستكمال التراخيص.`,
      },
      {
        title: 'المستودعات والمصانع',
        description: 'نوفر الشهادة للمستودعات والمصانع في الدمام مع مراعاة تغطية جميع الزوايا الأمنية.',
      },
      {
        title: 'المكاتب والشركات',
        description: 'نساعد الشركات والمكاتب في الدمام على استيفاء متطلبات الكاميرات الأمنية.',
      },
      {
        title: 'الصالونات والمشاغل',
        description: 'نغطي الصالونات والمشاغل في الدمام ونضمن إصدار الشهادة دون تأخير.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1581092160562-40aa08e78837?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'تركيب كاميرات مراقبة في منشأة بالدمام',
    }}
  >
    <Fragment slot="content">نضمن شهادة كاميرات شاملة لجميع الأنشطة التجارية في الدمام.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'الالتزام بالأنظمة الأمنية',
        description: 'تثبت شهادة استيفاء الكاميرات التزامك باشتراطات الشرطة السعودية وتجنبك المخالفات في الدمام.',
      },
      {
        title: 'تسهيل إجراءات التراخيص',
        description: 'الشهادة مطلب أساسي لاستخراج وتجديد الرخص البلدية والتجارية في الدمام دون تأخير.',
      },
      {
        title: 'حماية المنشأة والموظفين',
        description: 'نظام المراقبة المعتمد يقلل من مخاطر السرقات والحوادث ويوفر بيئة آمنة للجميع في الدمام.',
      },
      {
        title: 'دعم التحقيقات الأمنية',
        description: 'تسجيلات الكاميرات تساعد الجهات الأمنية عند الحاجة، مما يعزز الأمان العام في الدمام.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1557804506-669a67965ba0?ixlib=rb-4.0.3&auto=format&fit=crop&w=2074&q=80',
      alt: 'غرفة مراقبة كاميرات أمنية في الدمام',
    }}
  >
    <Fragment slot="content">مصمم خصيصاً لدعم أمان واستقرار أعمالك التجارية في الدمام.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Steps
    title="احصل على شهادة استيفاء كاميرات المراقبة المعتمدة في الدمام وافتح منشأتك بأمان."
    items={[
      {
        title: 'الخطوة 1: <span class="font-medium">فحص أنظمة المراقبة</span>',
        description:
          'نتحقق من تركيب الكاميرات وعددها وزوايا التصوير ومدة التسجيل حسب اشتراطات الشرطة السعودية في الدمام.',
        icon: 'tabler:package',
      },
      {
        title: 'الخطوة 2: <span class="font-medium">تجهيز المستندات</span>',
        description: 'نجهز التقارير الفنية وقوائم الكاميرات وعقود الصيانة المطلوبة لتقديم طلب الشهادة.',
        icon: 'tabler:letter-case',
      },
      {
        title: 'الخطوة 3: <span class="font-medium">إصدار الشهادة</span>',
        description: 'نقوم بإصدار شهادة استيفاء تركيب الكاميرات المعتمدة رسمياً من الشرطة السعودية.',
        icon: 'tabler:paint',
      },
      {
        title: 'الخطوة 4: <span class="font-medium">استلام الشهادة</span>',
        description: 'نسلمك الشهادة المعتمدة لتقديمها للجهات المختصة واستكمال إجراءات التراخيص بكل يسر في الدمام.',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1558618666-fcd25c85f82e?ixlib=rb-4.0.3&auto=format&fit=crop&w=987&q=80',
      alt: 'كاميرا مراقبة أمنية في الدمام',
    }}
  />

  <Features2
    title="متطلبات شهادة استيفاء كاميرات المراقبة في الدمام"
    subtitle="نضمن لك استيفاء جميع المتطلبات والشروط اللازمة لإصدار شهادة استيفاء كاميرات المراقبة في الدمام بنجاح وبدون أي ملاحظات"
    tagline="المتطلبات الأساسية"
    items={[
      {
        title: 'الالتزام باشتراطات الشرطة',
        description: 'التأكد من التزام المنشأة بكافة اشتراطات أنظمة المراقبة حسب تعليمات الشرطة السعودية في الدمام.',
        icon: 'flat-color-icons:template',
      },
      {
        title: 'توفر كاميرات مراقبة كافية',
        description: 'تركيب عدد كافٍ من الكاميرات لتغطية المداخل والمخارج والمناطق الحيوية في المنشأة.',
        icon: 'flat-color-icons:gallery',
      },
      {
        title: 'جميع المستندات المطلوبة',
        description: 'تجهيز كافة المستندات مثل قائمة الكاميرات وتقارير الفحص الفني وعقود الصيانة.',
        icon: 'flat-color-icons:approval',
      },
      {
        title: 'دفع الرسوم المقررة',
        description: 'التأكد من سداد جميع الرسوم المقررة لإصدار الشهادة في الدمام.',
        icon: 'flat-color-icons:document',
      },
      {
        title: 'عقد صيانة ساري المفعول',
        description: 'توفير عقد صيانة لأنظمة المراقبة مع شركة معتمدة لضمان استمرارية العمل.',
        icon: 'flat-color-icons:advertising',
      },
      {
        title: 'تقرير فني معتمد',
        description: 'توفير تقارير الفحص الفني المعتمدة التي تثبت استيفاء المنشأة للاشتراطات في الدمام.',
        icon: 'flat-color-icons:currency-exchange',
      },
      {
        title: 'شهادة الكاميرات الأمنية',
        description: 'شهادة تثبت تركيب الكاميرات وفق المواصفات المطلوبة من الجهات المختصة في الدمام.',
        icon: 'flat-color-icons:voice-presentation',
      },
      {
        title: 'تغطية زوايا التصوير',
        description: 'التأكد من زوايا التصوير المناسبة وعدم وجود نقاط عمياء في نطاق المراقبة.',
        icon: 'flat-color-icons:business-contact',
      },
      {
        title: 'مدة تسجيل لا تقل عن 30 يوم',
        description: 'توفر أجهزة تسجيل تحفظ اللقطات لمدة 30 يوماً على الأقل حسب الاشتراطات في الدمام.',
        icon: 'flat-color-icons:database',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <BlogLatestPosts
    title="تصفح آخر مستجدات أنظمة كاميرات المراقبة في الدمام بالمدونة"
    information={`نشاركك دورياً شروحات مفصلة حول اشتراطات كاميرات المراقبة وأحدث تعليمات الشرطة السعودية في الدمام.
                  كل مقال جديد نطرحه يمثل خطوة هامة تمكنك من حماية منشأتك وتفادي تأخير التراخيص لتصبح خبيراً في إدارة أنظمة الأمان.
                  الالتزام بالأنظمة الأمنية هو استثمارك الذكي. شكراً لثقتكم.
                `}
  />

  <FAQs
    title="الأسئلة الشائعة"
    subtitle="تعمق في الإجابات التالية للحصول على فهم شامل حول شهادة استيفاء كاميرات المراقبة في الدمام وكيف يمكن لمنصتنا تسريع أعمالك."
    tagline="الأسئلة الشائعة في الدمام"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'هل تقدمون الخدمة في جميع أحياء الدمام؟',
        description:
          'نعم، نغطي جميع أحياء ومناطق الدمام بدون استثناء، بما فيها الشاطئ، الفيصلية، الأثير، السيف، وجميع أحياء المنطقة الشرقية.',
      },
      {
        title: 'ما هي شهادة استيفاء كاميرات المراقبة؟',
        description: 'وثيقة رسمية تثبت التزام المنشأة بتركيب كاميرات مراقبة مطابقة لاشتراطات الشرطة السعودية.',
      },
      {
        title: 'كم يستغرق إنجاز الخدمة في الدمام؟',
        description:
          'نسعى لإنجاز الخدمة في أسرع وقت ممكن بعد التأكد من تركيب الكاميرات. تواصل معنا للاستفسار عن الوقت المتوقع.',
      },
      {
        title: 'هل شهادة الكاميرات مطلوبة لجميع الأنشطة؟',
        description: 'تختلف حسب نوع النشاط، لكن معظم الأنشطة التجارية في الدمام تتطلبها لاستخراج وتجديد الرخص.',
      },
      {
        title: 'ما الأنشطة التي تحتاج شهادة الكاميرات في الدمام؟',
        description: 'المحلات التجارية، المطاعم، المستودعات، الصالونات، المكاتب، والشقق المفروشة.',
      },
      {
        title: 'كيف أتواصل معكم في الدمام؟',
        description: 'يمكنك التواصل معنا عبر واتساب أو الاتصال على 0572140531 في أي وقت، وفريقنا جاهز للرد عليك.',
      },
    ]}
  />

  <Stats
    stats={[
      { title: 'شهادة كاميرات تم إصدارها في الدمام', amount: '+1.7K' },
      { title: 'منشأة مخدومة في الدمام', amount: '+1.4K' },
      { title: 'نسبة القبول في الدمام', amount: '99%' },
      { title: 'حي مخدوم في الدمام', amount: '25+' },
    ]}
  />

  <CallToAction
    id="contact"
    actions={[
      {
        variant: 'primary',
        text: 'تواصل معنا عبر الواتساب فوراً في الدمام',
        href: 'https://wa.me/966572140531',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
    ]}
  >
    <Fragment slot="title"> احصل على شهادة الكاميرات في الدمام الآن </Fragment>

    <Fragment slot="subtitle">
      لا تدع انتهاء الشهادة يعطل أعمالك التجارية في الدمام ويعرضك للغرامات. <br class="hidden md:inline" />تواصل معنا
      الآن وسنتولى جميع إجراءات إصدار الشهادة بسرعة واحترافية في الدمام!
    </Fragment>
  </CallToAction>
</Layout>
