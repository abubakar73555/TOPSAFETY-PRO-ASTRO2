        icon: 'tabler:letter-case',
      },
      {
        title: 'الخطوة 3: <span class="font-medium">اعتماد وإصدار التقرير</span>',
        description:
          'يتم ختم التقرير الهندسي ورفعه بالصيغة الرسمية المعتمدة لتتمكن من إرفاقه بمنصة بلدي في تبوك. دقة التصميم تضمن لك قبولاً فورياً.',
        icon: 'tabler:paint',
      },
      {
        title: 'جاهز! رخصتك بيدك',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616198814651-e71f960c3180?ixlib=rb-4.0.3&auto=format&fit=crop&w=987&q=80',
      alt: 'إصدار الترخيص بنجاح تام في تبوك',
    }}
  />

  <Features2
    title="خدمات السلامة في تبوك"
    subtitle="نقدم كافة المكونات والتقارير الهندسية اللازمة لتأمين المنشآت في تبوك وفق اشتراطات كود الحريق السعودي"
    tagline="خدماتنا في تبوك"
    items={[
      {
        title: 'تقرير فني سلامة فوري',
        description: 'إصدار تقرير فني فوري للأنشطة الصغيرة في تبوك عبر بوابة سلامة في نفس اليوم.',
        icon: 'flat-color-icons:template',
      },
      {
        title: 'تقرير فني سلامة غير فوري',
        description: 'إصدار تقرير فني غير فوري يتطلب فحصاً ميدانياً وعقد صيانة للمنشآت المتوسطة والكبيرة في تبوك.',
        icon: 'flat-color-icons:gallery',
      },
      {
        title: 'شهادة تركيب أدوات الوقاية',
        description: 'إصدار شهادة تركيب أدوات الوقاية والحماية من الحريق في تبوك بعد التأكد من جاهزية جميع الأنظمة.',
        icon: 'flat-color-icons:approval',
      },
      {
        title: 'عقود صيانة أنظمة السلامة',
        description: 'توفير عقود صيانة معتمدة لأنظمة السلامة في تبوك مع مكتب هندسي معتمد من الدفاع المدني.',
        icon: 'flat-color-icons:document',
      },
      {
        title: 'تجديد رخصة البلدية في تبوك',
        description: 'خدمة متكاملة لتجديد رخصة البلدية في تبوك مع تجهيز جميع المستندات ومتابعة الطلب حتى الإصدار.',
        icon: 'flat-color-icons:advertising',
      },
      {
        title: 'تجديد ترخيص الدفاع المدني في تبوك',
        description: 'تجديد ترخيص الدفاع المدني في تبوك بسرعة واحترافية مع فحص جميع معدات السلامة.',
        icon: 'flat-color-icons:currency-exchange',
      },
      {
        title: 'شهادة استيفاء كاميرات المراقبة',
        description: 'إصدار شهادة استيفاء كاميرات المراقبة في تبوك حسب متطلبات البلدية للمنشآت التجارية.',
        icon: 'flat-color-icons:voice-presentation',
      },
      {
        title: 'استشارات هندسية وقائية',
        description: 'تقديم استشارات هندسية وقائية للمنشآت في تبوك لضمان الامتثال الكامل لاشتراطات السلامة.',
        icon: 'flat-color-icons:business-contact',
      },
      {
        title: 'دعم على مدار الساعة',
        description: 'فريقنا متاح على مدار الساعة لخدمتك في تبوك والإجابة على جميع استفساراتك.',
        icon: 'flat-color-icons:database',
      },
    ]}
