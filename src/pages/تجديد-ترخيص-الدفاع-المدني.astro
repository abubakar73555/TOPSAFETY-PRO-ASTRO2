---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: '0572140531 تجديد ترخيص الدفاع المدني سلامة',
  description: 'خدمة متكاملة لتجديد وإصدار ترخيص الدفاع المدني بسرعة واحترافية مع تجهيز جميع المستندات المطلوبة.',
  ignoreTitleTemplate: true,
};
---


<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'اطلب تجديد ترخيص الدفاع المدني الآن',
        href: '#contact',
        icon: 'tabler:file-text',
      },
      { text: 'تعرف على خدماتنا', href: '#features' },
    ]}
    image={{ src: '~/assets/images/رخصه-الدفاع-المدني.webp', alt: 'تجديد ترخيص الدفاع المدني سلامة' }}
  >
    <Fragment slot="title">
      خدمة متكاملة لـ <span class="hidden xl:inline">تجديد وإصدار</span>
      <span class="text-accent dark:text-white">ترخيص الدفاع المدني</span> وفحص السلامة
    </Fragment>
 
    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        نقدم لك خدمة تجديد ترخيص الدفاع المدني للمنشآت التجارية والصناعية بسرعة واحترافية، مع ضمان
        استيفاء جميع اشتراطات السلامة المطلوبة.</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">تجديد ترخيص الدفاع المدني باحترافية وسرعة.</span>
      خدمتنا تغطي المحلات التجارية، الأنشطة الصغيرة، الشركات الناشئة، المستودعات الكبرى، المصانع، والمكاتب بكافة مناطق المملكة.
    </Fragment>
  </Hero>
 
  <Note title="فلسفتنا:" description="السرعة الفائقة، الالتزام بالمعايير، وتسهيل إجراءات تجديد ترخيص الدفاع المدني لعملائنا" />
 
  <Features
    id="features"
    tagline="المميزات والخدمات"
    title="ما ستحصل عليه عند تجديد ترخيصك معنا"
    subtitle="خدمة هندسية متكاملة لتجديد ترخيص الدفاع المدني بامتثال كامل لأنظمة السلامة المعتمدة في المملكة."
    items={[
      {
        title: 'الربط المباشر مع منصة بلدي',
        description:
          'تكامل سلس يضمن تجهيز جميع المستندات بالمعايير الدقيقة المطلوبة لضمان قبول طلب التجديد وإصدار الترخيص دون تأخير.',
        icon: 'tabler:brand-tailwind',
      },
      {
        title: 'تقارير سلامة جاهزة ومعتمدة',
        description:
          'نماذج وتقارير هندسية معتمدة ومختومة تناسب كافة الأنشطة التجارية؛ من المحلات البسيطة إلى المجمعات الضخمة.',
        icon: 'tabler:components',
      },
      {
        title: 'فحص شامل لمعدات السلامة',
        description: 'نضمن مراجعة وتدقيق جميع معدات السلامة في منشأتك للتأكد من جاهزيتها التامة قبل تقديم طلب التجديد.',
        icon: 'tabler:list-check',
      },
      {
        title: 'سرعة استثنائية في الإنجاز',
        description:
          'نعلم أن الوقت يعني المال؛ لذا نضمن لك فحصاً سريعاً وإصداراً لترخيص الدفاع المدني في أيام معدودة لتفادي أي غرامات.',
        icon: 'tabler:rocket',
      },
      {
        title: 'متابعة دقيقة لطلب التجديد',
        description:
          'نهتم بأدق التفاصيل والمتطلبات الفنية التي يبحث عنها مراقبو البلديات والدفاع المدني لضمان الموافقة دون ملاحظات.',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'حلول هندسية لمعالجة النواقص',
        description:
          'إذا كانت منشأتك تفتقر لبعض اشتراطات السلامة، نقدم لك حلولاً هندسية بديلة وذكية للتوافق مع النظام دون تكاليف باهظة.',
        icon: 'tabler:bulb',
      },
    ]}
  />
 
  <Content
    isReversed
    tagline="داخل الخدمة"
    title="تجديد ترخيص الدفاع المدني: دقة التنفيذ تلتقي مع معايير السلامة"
    items={[
      {
        title: 'الاعتماد على كود البناء السعودي',
        description:
          'نصيغ تقاريرنا ونفحص منشأتك استناداً إلى أحدث الأنظمة واللوائح المعتمدة بالمملكة لضمان جودة هندسية موثوقة.',
      },
      {
        title: 'إجراءات إلكترونية سريعة وميسّرة',
        description:
          'نعتمد أساليب رقمية حديثة في تجهيز الملفات ومتابعة الطلبات لضمان تجربة سلسة وسريعة لعملائنا من الجوال أو الكمبيوتر.',
      },
      {
        title: 'توافق شامل ومتكامل',
        description:
          'نضمن أن تقاريرنا ومخططاتنا تكون متوافقة ومفهومة لدى كافة الجهات الميدانية والإلكترونية المعنية بترخيص الدفاع المدني.',
      },
    ]}
    image={{
      src: '~/assets/images/رخصه-الدفاع-المدني.webp',
      alt: 'تجديد ترخيص الدفاع المدني سلامة',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">التأسيس على قواعد هندسية حديثة</h3>
      احصل على الأفضلية النظامية من خلال تطبيق أفضل ممارسات الوقاية والحماية المعتمدة عند تجديد ترخيصك.
    </Fragment>
 
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>
 
  <Content
    isAfterContent
    items={[
      {
        title: 'مرونة وتخصيص حسب نشاطك',
        description: `نطوّع عملية تجديد الترخيص لتتناسب تماماً مع متطلبات وهوية نشاطك التجاري، مما يحميك ويختصر عليك الوقت والجهد.`,
      },
      {
        title: 'تغطية شاملة لمختلف المنشآت',
        description:
          'نغطي كافة أنواع المنشآت والمخططات الهندسية وأنظمة السلامة للمباني لنجد الحل الأنسب الذي يسهل قبول ملفك التجاري.',
      },
      {
        title: 'متابعة سهلة من أي جهاز',
        description: 'استعرض تقاريرك وتابع حالة طلب التجديد من أي جهاز بفضل التصميم المتجاوب الذي يمنحك تجربة سلسة.',
      },
      {
        title: 'توثيق كامل للمرفقات والصور',
        description:
          'نرفق الصور الميدانية والفواتير المعتمدة لأنظمة السلامة بشكل منظم يمنع رفض المعاملة من المنصات الحكومية.',
      },
    ]}
    image={{
      src: '~/assets/images/رخصه-الدفاع-المدني.webp',
      alt: 'تجديد ترخيص الدفاع المدني سلامة',
    }}
  >
    <Fragment slot="content">نضمن أن ترخيص منشأتك يعكس التزامك الحقيقي بمعايير السلامة.</Fragment>
 
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>
 
  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'تفاعل سريع مع أنظمة التراخيص',
        description:
          'نواكب كافة التحديثات في منصات التراخيص لتفادي أي تأخير، مما يضمن بقاء منشأتك آمنة وقانونية دائماً.',
      },
      {
        title: 'متابعة مستمرة لاشتراطات السلامة',
        description:
          'نتابع التعديلات الدورية في اشتراطات المديرية العامة للدفاع المدني لنقدم لك استشارات محدثة دائماً حول تجديد الترخيص.',
      },
      {
        title: 'توفير الوقت والجهد',
        description:
          'وفر على نفسك عناء البدء من الصفر أو مراجعة المعاملات المرفوضة؛ اطلب تجديد ترخيصك معنا وانطلق فوراً.',
      },
      {
        title: 'دعم فني متكامل طوال الرحلة',
        description: `انضم إلى مئات المنشآت التي وثقت بخدمتنا، واستفد من الدعم الفني المتواصل طوال رحلة تجديد رخصتك.`,
      },
    ]}
    image={{
      src: '~/assets/images/رخصه-الدفاع-المدني.webp',
      alt: 'تجديد ترخيص الدفاع المدني سلامة',
    }}
  >
    <Fragment slot="content">مصمم خصيصاً لدعم نمو واستقرار أعمالك التجارية.</Fragment>
 
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>
 
  <Steps
    title="احصل على ترخيصك المجدد وحافظ على استمرارية عملك في أسرع وقت."
    items={[
      {
        title: 'الخطوة 1: <span class="font-medium">تجهيز المستندات</span>',
        description:
          'ابدأ فوراً بتزويدنا ببيانات المنشأة والسجل التجاري ورخصة الدفاع المدني السابقة. فريقنا جاهز لاستلام طلبك في أي وقت لتأسيس المعاملة.',
        icon: 'tabler:package',
      },
      {
        title: 'الخطوة 2: <span class="font-medium">فحص معدات السلامة</span>',
        description:
          'يقوم مهندسونا بمراجعة وفحص جميع معدات السلامة في منشأتك والتأكد من مطابقتها لاشتراطات البلدية والدفاع المدني بدقة متناهية.',
        icon: 'tabler:letter-case',
      },
      {
        title: 'الخطوة 3: <span class="font-medium">تقديم طلب التجديد والاعتماد</span>',
        description:
          'يتم تقديم طلب التجديد عبر المنصات المعتمدة ومتابعته حتى إصدار الترخيص. دقة التجهيز تضمن لك قبولاً فورياً وسلساً.',
        icon: 'tabler:paint',
      },
      {
        title: 'جاهز! ترخيصك المجدد بيدك',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: '~/assets/images/رخصه-الدفاع-المدني.webp',
      alt: 'تجديد ترخيص الدفاع المدني سلامة',
    }}
  />
 
  <Features2
    title="ما يشمله فحص معدات السلامة عند التجديد"
    subtitle="نقوم بفحص شامل لجميع أنظمة ومعدات السلامة في منشأتك لضمان جاهزيتها التامة واستيفاء متطلبات تجديد ترخيص الدفاع المدني"
    tagline="نطاق الفحص"
    items={[
      {
        title: 'طفايات الحريق',
        description: 'فحص صلاحية وتوزيع طفايات الحريق بأنواعها المختلفة حسب طبيعة النشاط والمخاطر المحتملة.',
        icon: 'flat-color-icons:template',
      },
      {
        title: 'أنظمة الإنذار المبكر',
        description:
          'التحقق من كفاءة لوحات الإنذار الرئيسية وكواشف الدخان والحرارة لضمان الاستجابة السريعة عند الحاجة.',
        icon: 'flat-color-icons:gallery',
      },
      {
        title: 'كواشف الدخان',
        description: 'فحص كواشف الدخان وتوزيعها الصحيح في جميع أرجاء المنشأة حسب الاشتراطات المعتمدة.',
        icon: 'flat-color-icons:approval',
      },
      {
        title: 'مخارج الطوارئ',
        description: 'مراجعة الممرات والأبواب المقاومة للحريق واللوحات الإرشادية المضيئة لضمان خروج آمن.',
        icon: 'flat-color-icons:document',
      },
      {
        title: 'لوحات الإرشاد',
        description: 'التأكد من وجود لوحات إرشادية واضحة ومضيئة تدل على مخارج الطوارئ ومعدات السلامة.',
        icon: 'flat-color-icons:advertising',
      },
      {
        title: 'مضخات الحريق',
        description: 'فحص كفاءة مضخات الحريق وشبكات المياه المخصصة للإطفاء لضمان جاهزيتها التامة.',
        icon: 'flat-color-icons:currency-exchange',
      },
      {
        title: 'أنظمة الرش الآلي',
        description: 'تقييم كفاءة أنظمة الرش الآلي (Sprinklers) وتغطيتها الشاملة لجميع مناطق المنشأة.',
        icon: 'flat-color-icons:voice-presentation',
      },
      {
        title: 'صناديق الحريق',
        description: 'فحص صناديق الحريق (Fire Hose Cabinets) وتجهيزاتها من خراطيم وفوهات الإطفاء.',
        icon: 'flat-color-icons:business-contact',
      },
      {
        title: 'التمديدات الكهربائية الآمنة',
        description: 'فحص لوحات التوزيع والتأكد من جودة العزل الكهربائي لمنع حدوث التماسات أو أحمال زائدة بالموقع.',
        icon: 'flat-color-icons:database',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>
 
  <BlogLatestPosts
    title="تصفح آخر مستجدات اشتراطات السلامة وتجديد التراخيص بالمدونة"
    information={`نشاركك دورياً شروحات مفصلة حول كود البناء السعودي واشتراطات منصة بلدي وتجديد ترخيص الدفاع المدني.
                  كل مقال جديد نطرحه يمثل خطوة هامة تمكنك من حماية منشأتك وتفادي تأخير التراخيص لتصبح خبيراً في إدارة شؤون منشأتك.
                  الوقاية هي استثمارك الذكي. شكراً لثقتكم.
                `}
  />
 
  <FAQs
    title="الأسئلة الشائعة"
    subtitle="تعمق في الإجابات التالية للحصول على فهم شامل حول تجديد ترخيص الدفاع المدني وكيف يمكن لخدمتنا تسريع أعمالك التجارية."
    tagline="الأسئلة الشائعة"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'كم يستغرق تجديد ترخيص الدفاع المدني؟',
        description:
          'غالباً يستغرق تجديد ترخيص الدفاع المدني عدة أيام بعد استكمال جميع متطلبات السلامة وتجهيز المستندات اللازمة. نسعى دائماً لتسريع الإجراءات قدر الإمكان.',
      },
      {
        title: 'هل يشترط فحص معدات السلامة قبل التجديد؟',
        description:
          'نعم، يجب التأكد من جاهزية جميع أنظمة السلامة قبل إصدار ترخيص الدفاع المدني المجدد. يشمل الفحص طفايات الحريق وأنظمة الإنذار وكواشف الدخان ومخارج الطوارئ وغيرها من المعدات.',
      },
      {
        title: 'من يجب عليه تجديد ترخيص الدفاع المدني؟',
        description:
          'جميع المنشآت التجارية والصناعية والمحلات والمكاتب والمستودعات والمصانع يجب عليها تجديد ترخيص الدفاع المدني بشكل دوري حسب المدة المحددة في الرخصة.',
      },
      {
        title: 'هل يمكن تجديد الترخيص عبر الإنترنت؟',
        description:
          'نعم، يمكن تقديم طلب تجديد ترخيص الدفاع المدني عبر المنصات الرسمية المعتمدة مثل منصة بلدي. نحن نتولى جميع الإجراءات الإلكترونية نيابة عنك.',
      },
      {
        title: 'ماذا لو كانت المنشأة لا تستوفي بعض الاشتراطات؟',
        description:
          'فريقنا الهندسي يقدم لك استشارات فورية لحل أي نواقص في أنظمة السلامة وتجهيزها بالكامل قبل التقديم على تجديد الترخيص، بأقل تكلفة وأعلى جودة.',
      },
      {
        title: 'ما هي المستندات المطلوبة لتجديد ترخيص الدفاع المدني؟',
        description:
          'تحتاج إلى صورة السجل التجاري ساري المفعول، ترخيص الدفاع المدني السابق، عقد صيانة ساري لأنظمة السلامة، وصور حديثة للمنشأة ومعدات السلامة.',
      },
    ]}
  />
 
  <Stats
    stats={[
      { title: 'ترخيص تم تجديده', amount: '+3K' },
      { title: 'منشأة تجارية وصناعية', amount: '+2.5K' },
      { title: 'نسبة القبول', amount: '99%' },
      { title: 'مدن المملكة', amount: '13+' },
    ]}
  />
 
  <CallToAction
    id="contact"
    actions={[
      {
        variant: 'primary',
        text: 'تواصل معنا عبر الواتساب فوراً',
        href: 'https://wa.me/966572140531',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
    ]}
  >
    <Fragment slot="title"> جدد ترخيص الدفاع المدني الآن </Fragment>
 
    <Fragment slot="subtitle">
      لا تدع انتهاء ترخيص الدفاع المدني يعطل أعمالك التجارية ويعرضك للغرامات. <br class="hidden md:inline" />تواصل معنا الآن
      وسنتولى جميع إجراءات التجديد بسرعة واحترافية!
    </Fragment>
  </CallToAction>
</Layout>
 
