---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'تقرير فني سلامة في القصيم 0572140531',
  description: 'خدمة متكاملة لإعداد تقرير فني سلامة في القصيم بسرعة واحترافية مع تجهيز جميع المستندات المطلوبة.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'طلب تقرير فني في القصيم فوراً',
        href: '#contact',
        icon: 'tabler:file-text',
      },
      { text: 'إكتشف خدماتنا', href: '#features' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'توب سيفتي برو لإصدار التقارير الفنية في القصيم' }}
  >
    <Fragment slot="title">
      تقرير فني سلامة في <span class="hidden xl:inline">القصيم</span>
      <span class="text-accent dark:text-white">المنطقة الوسطى</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">منصة توب سيفتي برو</span> تقدم لك إصدار التقارير الفنية الفورية وغير الفورية في القصيم
        لتجديد رخصة البلدية والدفاع المدني بسرعة واحترافية.</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">توب سيفتي برو: اعتماد فوري في القصيم.</span>
      نخدم جميع مدن وأحياء القصيم: بريدة، عنيزة، الرس، البكيرية، وجميع مناطق منطقة القصيم.
    </Fragment>
  </Hero>

  <Note
    title="فلسفتنا:"
    description="السرعة الفائقة، الالتزام بالمعايير، وتسهيل الإجراءات النظامية لعملائنا في القصيم"
  />

  <Features
    id="features"
    tagline="المميزات والخدمات في القصيم"
    title="ما ستحصل عليه مع توب سيفتي برو في القصيم"
    subtitle="واحدة من أفضل الخدمات الهندسية المتكاملة في القصيم لإصدار شهادات وتراخيص السلامة بامتثال كامل لكود البناء."
    items={[
      {
        title: 'خبرة واسعة في سوق القصيم',
        description:
          'لدينا خبرة واسعة في سوق القصيم والمنطقة الوسطى، ونفهم تماماً متطلبات البلديات والدفاع المدني في المنطقة.',
        icon: 'tabler:brand-tailwind',
      },
      {
        title: 'تقارير جاهزة للاستخدام',
        description:
          'نماذج وتقارير هندسية معتمدة ومختومة تناسب كافة الأنشطة التجارية في القصيم؛ من المحلات البسيطة إلى المجمعات الضخمة.',
        icon: 'tabler:components',
      },
      {
        title: 'معتمدون من الدفاع المدني',
        description: 'نحن مكتب هندسي معتمد من الدفاع المدني، مما يضمن قبول تقاريرك بشكل رسمي وسريع في جميع الجهات.',
        icon: 'tabler:list-check',
      },
      {
        title: 'سرعة في الإنجاز',
        description:
          'نضمن لك إصدار التقرير الفني في القصيم في نفس اليوم للتقارير الفورية، وفي أيام معدودة للتقارير غير الفورية.',
        icon: 'tabler:rocket',
      },
      {
        title: 'أسعار تنافسية',
        description: 'نقدم أفضل الأسعار في سوق القصيم مع الحفاظ على أعلى مستويات الجودة والاحترافية في إعداد التقارير.',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'تغطية جميع مدن القصيم',
        description: 'نخدم جميع مدن وأحياء القصيم بدون استثناء، بما فيها بريدة، عنيزة، الرس، البكيرية، وغيرها.',
        icon: 'tabler:bulb',
      },
    ]}
  />

  <Content
    isReversed
    tagline="داخل الخدمة في القصيم"
    title="مخطط توب سيفتي برو في القصيم: دقة التنفيذ تلتقي مع معايير السلامة!"
    items={[
      {
        title: 'الاعتماد على كود البناء السعودي',
        description:
          'نصيغ تقاريرنا في القصيم استناداً إلى أحدث الأنظمة واللوائح المعتمدة بالمملكة لضمان جودة هندسية لا غبار عليها.',
      },
      {
        title: 'تنسيق متوافق مع كود Tailwind CSS v4',
        description:
          'تم بناء المنصة بأحدث التقنيات البرمجية لضمان تصفح سريع جداً وخفيف لعملائنا في القصيم من الجوال أو الكمبيوتر.',
      },
      {
        title: 'توافق شامل ومتكامل',
        description:
          'نضمن أن تقاريرنا ومخططاتنا في القصيم تكون متوافقة ومفهومة لدى كافة الجهات الميدانية والإلكترونية المعنية بالترخيص.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'فريق هندسي يفحص وسائل سلامة في القصيم',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        التأسيس على قواعد هندسية حديثة في القصيم
      </h3>
      احصل على الأفضلية النظامية في القصيم من خلال تطبيق أفضل ممارسات الوقاية والحماية المعتمدة.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isAfterContent
    items={[
      {
        title: 'مرونة وتخصيص لا محدود',
        description: `نقوم بتطويع التقرير الفني ليتناسب تماماً مع متطلبات وهوية نشاطك التجاري في القصيم، مما يحميك ويختصر وقتك وجهدك.`,
      },
      {
        title: 'خيارات متعددة للهيكلة المعمارية',
        description:
          'نغطي كافة التصاميم الهندسية ومخططات السلامة للمباني في القصيم لنجد البنية الأنسب التي تسهل مراجعة ملفك التجاري.',
      },
      {
        title: 'تصميم متجاوب بالكامل',
        description:
          'استعرض تقاريرك وتابع طلباتك في القصيم من أي جهاز بفضل التصميم المتجاوب السلس الذي يمنح العميل تجربة فريدة.',
      },
      {
        title: 'دمج وتوثيق المرفقات والصور',
        description:
          'نرفق الصور الميدانية والفواتير المعتمدة لشبكات السلامة في القصيم بشكل منظم يمنع رفض المعاملة من المنصات الحكومية.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?ixlib=rb-4.0.3&auto=format&fit=crop&w=2194&q=80',
      alt: 'مخططات هندسية معتمدة للسلامة في القصيم',
    }}
  >
    <Fragment slot="content">نضمن أن تواجدك النظامي في القصيم يمثلك ويمثل أمان منشأتك بشكل حقيقي.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'تفاعل وتجاوب سريع مع النظام',
        description:
          'نواكب كافة التحديثات في منصات التراخيص في القصيم لتفادي أي تأخير، مما يضمن بقاء منشأتك آمنة وقانونية دائماً.',
      },
      {
        title: 'تطوير وتحديث مستمر',
        description:
          'نتابع التعديلات الدورية في اشتراطات المديرية العامة للدفاع المدني في منطقة القصيم لنقدم لك استشارات محدثة دائمًا.',
      },
      {
        title: 'كفاءة عالية في الوقت والموارد',
        description:
          'وفر على نفسك عناء البدء من الصفر أو مراجعة المعاملات المرفوضة في القصيم؛ اطلب التقرير من توب سيفتي برو وانطلق فوراً.',
      },
      {
        title: 'دعم هندسي متكامل للعملاء',
        description: `انضم إلى مئات المنشآت في القصيم التي وثقت بـ توب سيفتي برو، واستفد من الدعم الفني المتواصل طوال رحلة استخراج رخصتك.`,
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1611462985358-60d3498e0364?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'مهندسو سلامة يتابعون المشاريع في القصيم',
    }}
  >
    <Fragment slot="content">مصمم خصيصاً لدعم نمو واستقرار أعمالك التجارية في القصيم.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Steps
    title="احصل على تقريرك الفني المعتمد في القصيم وافتح منشأتك في أسرع وقت."
    items={[
      {
        title: 'الخطوة 1: <span class="font-medium">إرسال البيانات</span>',
        description:
          'ابدأ فوراً بتزويدنا بنوع النشاط وصور وسائل السلامة المتوفرة لديك في القصيم عبر الواتساب أو المنصة. فريقنا جاهز لاستلام طلبك في أي وقت.',
        icon: 'tabler:package',
      },
      {
        title: 'الخطوة 2: <span class="font-medium">التدقيق والمعاينة</span>',
        description:
          'يقوم مهندسونا في القصيم بمراجعة البيانات والتأكد من مطابقتها لاشتراطات البلدية والدفاع المدني بدقة متناهية لضمان خلوها من الأخطاء.',
        icon: 'tabler:letter-case',
      },
      {
        title: 'الخطوة 3: <span class="font-medium">اعتماد وإصدار التقرير</span>',
        description:
          'يتم ختم التقرير الهندسي ورفعه بالصيغة الرسمية المعتمدة لتتمكن من إرفاقه بمنصة بلدي في القصيم. دقة التصميم تضمن لك قبولاً فورياً.',
        icon: 'tabler:paint',
      },
      {
        title: 'جاهز! رخصتك بيدك',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616198814651-e71f960c3180?ixlib=rb-4.0.3&auto=format&fit=crop&w=987&q=80',
      alt: 'إصدار الترخيص بنجاح تام في القصيم',
    }}
  />

  <Features2
    title="خدمات السلامة في القصيم"
    subtitle="نقدم كافة المكونات والتقارير الهندسية اللازمة لتأمين المنشآت في القصيم وفق اشتراطات كود الحريق السعودي"
    tagline="خدماتنا في القصيم"
    items={[
      {
        title: 'تقرير فني سلامة فوري',
        description: 'إصدار تقرير فني فوري للأنشطة الصغيرة في القصيم عبر بوابة سلامة في نفس اليوم.',
        icon: 'flat-color-icons:template',
      },
      {
        title: 'تقرير فني سلامة غير فوري',
        description: 'إصدار تقرير فني غير فوري يتطلب فحصاً ميدانياً وعقد صيانة للمنشآت المتوسطة والكبيرة في القصيم.',
        icon: 'flat-color-icons:gallery',
      },
      {
        title: 'شهادة تركيب أدوات الوقاية',
        description: 'إصدار شهادة تركيب أدوات الوقاية والحماية من الحريق في القصيم بعد التأكد من جاهزية جميع الأنظمة.',
        icon: 'flat-color-icons:approval',
      },
      {
        title: 'عقود صيانة أنظمة السلامة',
        description: 'توفير عقود صيانة معتمدة لأنظمة السلامة في القصيم مع مكتب هندسي معتمد من الدفاع المدني.',
        icon: 'flat-color-icons:document',
      },
      {
        title: 'تجديد رخصة البلدية في القصيم',
        description: 'خدمة متكاملة لتجديد رخصة البلدية في القصيم مع تجهيز جميع المستندات ومتابعة الطلب حتى الإصدار.',
        icon: 'flat-color-icons:advertising',
      },
      {
        title: 'تجديد ترخيص الدفاع المدني في القصيم',
        description: 'تجديد ترخيص الدفاع المدني في القصيم بسرعة واحترافية مع فحص جميع معدات السلامة.',
        icon: 'flat-color-icons:currency-exchange',
      },
      {
        title: 'شهادة استيفاء كاميرات المراقبة',
        description: 'إصدار شهادة استيفاء كاميرات المراقبة في القصيم حسب متطلبات البلدية للمنشآت التجارية.',
        icon: 'flat-color-icons:voice-presentation',
      },
      {
        title: 'استشارات هندسية وقائية',
        description: 'تقديم استشارات هندسية وقائية للمنشآت في القصيم لضمان الامتثال الكامل لاشتراطات السلامة.',
        icon: 'flat-color-icons:business-contact',
      },
      {
        title: 'دعم على مدار الساعة',
        description: 'فريقنا متاح على مدار الساعة لخدمتك في القصيم والإجابة على جميع استفساراتك.',
        icon: 'flat-color-icons:database',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
