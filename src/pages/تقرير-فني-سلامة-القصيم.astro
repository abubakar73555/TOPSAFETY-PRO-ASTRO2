  <BlogLatestPosts
    title="تصفح آخر مستجدات اشتراطات السلامة في القصيم بالمدونة"
    information={`نشاركك دورياً شروحات مفصلة حول كود البناء السعودي واشتراطات منصة بلدي والدفاع المدني في القصيم والمنطقة الوسطى.
                  كل مقال جديد نطرحه يمثل خطوة هامة تمكنك من حماية منشأتك وتفادي تأخير التراخيص لتصبح خبيراً في إدارة شؤون منشأتك.
                  الوقاية هي استثمارك الذكي. شكراً لثقتكم.
                `}
  />

  <FAQs
    title="الأسئلة الشائعة"
    subtitle="تعمق في الإجابات التالية للحصول على فهم شامل حول التقارير الفنية في القصيم وكيف يمكن لمنصتنا تسريع أعمالك التجارية."
    tagline="الأسئلة الشائعة في القصيم"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'هل تقدمون خدمة التقرير الفني في جميع مدن القصيم؟',
        description:
          'نعم، نغطي جميع مدن وأحياء القصيم بدون استثناء، بما فيها بريدة، عنيزة، الرس، البكيرية، وجميع مناطق منطقة القصيم.',
      },
      {
        title: 'كم يستغرق إصدار التقرير الفني في القصيم؟',
        description:
          'التقرير الفوري يصدر في نفس اليوم، أما غير الفوري فيستغرق عدة أيام بعد الفحص الميداني. نسعى دائماً لتسريع الإجراءات قدر الإمكان.',
      },
      {
        title: 'هل يمكن التواصل معكم عبر واتساب؟',
        description:
          'نعم، يمكنك التواصل معنا عبر واتساب على الرقم 966572140531+ في أي وقت، وفريقنا جاهز للرد عليك ومتابعة معاملتك في القصيم.',
      },
      {
        title: 'ما هو التقرير الفني؟',
        description:
          'التقرير الفني مستند هندسي يصدر عن مكتب هندسي معتمد من الدفاع المدني يوثق مدى التزام المنشأة باشتراطات السلامة في القصيم.',
      },
      {
        title: 'من يحتاج التقرير الفني في القصيم؟',
        description:
          'جميع المنشآت التجارية والصناعية في القصيم عند إصدار أو تجديد رخصة البلدية أو ترخيص الدفاع المدني تحتاج إلى تقرير فني معتمد.',
      },
      {
        title: 'ما الفرق بين التقرير الفوري وغير الفوري؟',
        description:
          'التقرير الفوري للأنشطة الصغيرة ويصدر آلياً في نفس اليوم، أما غير الفوري فيتطلب فحصاً ميدانياً وعقد صيانة ويستغرق عدة أيام.',
      },
    ]}
  />

  <Stats
    stats={[
      { title: 'تقرير فني صادر في القصيم', amount: '+1.1K' },
      { title: 'منشأة في القصيم تم تأمينها', amount: '+900' },
      { title: 'تقييمات إيجابية في القصيم', amount: '100%' },
      { title: 'مدن القصيم المخدومة', amount: '12+' },
    ]}
  />

  <CallToAction
    id="contact"
    actions={[
      {
        variant: 'primary',
        text: 'تواصل معنا عبر الواتساب فوراً في القصيم',
        href: 'https://wa.me/966572140531',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
    ]}
  >
    <Fragment slot="title"> احصل على تقريرك الفني في القصيم الآن </Fragment>

    <Fragment slot="subtitle">
      لا تؤجل الحصول على تقريرك الفني المعتمد في القصيم. <br class="hidden md:inline" />تواصل معنا الآن وسنصدر تقريرك
