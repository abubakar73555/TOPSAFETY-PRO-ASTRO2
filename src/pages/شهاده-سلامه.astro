---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'شهادة تركيب أدوات الوقاية والحماية من الحريق - 0572140531',
  description: 'إصدار معتمد لشهادة تركيب أدوات الوقاية والحماية من الحريق، مع الفحص الشامل وتلبية كافة معايير ومتطلبات الدفاع المدني بكل دقة واحترافية.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'طلب شهادة السلامة فوراً',
        href: '#contact',
        icon: 'tabler:shield-check',
      },
      { text: 'اكتشف خدماتنا', href: '#features' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'توب سيفتي برو لشهادة تركيب أدوات السلامة' }}
  >
    <Fragment slot="title">
      شهادة تركيب <span class="hidden xl:inline">أدوات الوقاية والحماية</span>
      <span class="text-accent dark:text-white">من الحريق</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">منصة توب سيفتي برو</span> تقدم لك خدمة إصدار شهادة تركيب أدوات الوقاية والحماية من الحريق
        (فاتورة السلامة) المعتمدة من الدفاع المدني عبر بوابة سلامة لجميع المنشآت التجارية والصناعية.</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">توب سيفتي برو: شهادة سلامة معتمدة في جميع المدن.</span>
      نخدم جميع مناطق المملكة: جدة، الرياض، مكة، الدمام، المدينة، الطائف، الخبر، القصيم، تبوك، أبها، حائل، نجران، جازان.
    </Fragment>
  </Hero>

  <Note
    title="فلسفتنا:"
    description="السرعة الفائقة، الالتزام بمعايير الدفاع المدني، وتسهيل إجراءات إصدار شهادة تركيب أدوات السلامة لعملائنا في جميع أنحاء المملكة"
  />

  <Features
    id="features"
    tagline="المميزات والخدمات"
    title="ما نقدمه في شهادة السلامة"
    subtitle="خدمات متكاملة لتوفير شهادة تركيب أدوات الوقاية والحماية من الحريق بامتثال كامل لأنظمة الدفاع المدني."
    items={[
      {
        title: 'خبرة في أنظمة الدفاع المدني',
        description: 'فهم دقيق لاشتراطات الدفاع المدني ومتطلبات بوابة سلامة لإصدار الشهادات.',
        icon: 'tabler:building-community',
      },
      {
        title: 'شهادة معتمدة رسمياً',
        description: 'نصدر شهادة تركيب أدوات السلامة المعتمدة والمطلوبة لاستخراج وتجديد الرخص التجارية عبر بلدي.',
        icon: 'tabler:certificate',
      },
      {
        title: 'تجهيز كافة المستندات',
        description: 'نجهز السجل التجاري، العنوان الوطني، رخصة البناء، وغيرها من المستندات اللازمة لإصدار الشهادة.',
        icon: 'tabler:file-check',
      },
      {
        title: 'سرعة في الإنجاز',
        description: 'نضمن إصدار الشهادة في أيام معدودة لتجنب تأخير تجديد الرخص والغرامات.',
        icon: 'tabler:rocket',
      },
      {
        title: 'أسعار تنافسية',
        description: 'نقدم أفضل الأسعار مع الحفاظ على أعلى مستويات الجودة والاحترافية.',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'تغطية جميع مدن المملكة',
        description: 'نخدم جميع المناطق والمدن السعودية لتوفير شهادة السلامة أينما كان نشاطك التجاري.',
        icon: 'tabler:map-pin',
      },
    ]}
  />

  <Content
    isReversed
    tagline="داخل الخدمة"
    title="ما هي شهادة السلامة وكيف تعمل؟"
    items={[
      {
        title: 'تعريف الشهادة',
        description:
          'شهادة تركيب أدوات الوقاية والحماية من الحريق (فاتورة السلامة) تصدر عبر بوابة سلامة من شركة معتمدة، وتحتوي على بيان بأدوات السلامة المتوفرة في المنشأة.',
      },
      {
        title: 'رقم الشهادة وعلاقته ببلدي',
        description:
          'عند تجديد رخصة بلدي، يُطلب إدخال رقم شهادة السلامة. إذا لم يتوفر تصريح دفاع مدني، فإن رقم الشهادة هو المطلوب لإكمال التجديد.',
      },
      {
        title: 'الربط مع المنصات الحكومية',
        description: 'الشهادة مرتبطة مع منصة بلدي وبوابة سلامة، مما يسهل إصدار وتجديد الرخص التجارية دون معوقات.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1582139329536-e7284fece509?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'مستندات وشهادات سلامة',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">لماذا تختارنا؟</h3>
      خبرة في أنظمة الدفاع المدني، سرعة في الإنجاز، شهادة معتمدة، أسعار تنافسية، تغطية شاملة، دعم على مدار الساعة.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isAfterContent
    items={[
      {
        title: 'السجل التجاري',
        description: 'إحضار السجل التجاري ساري المفعول للمنشأة.',
      },
      {
        title: 'رخصة البناء',
        description: 'توفير رخصة البناء للموقع.',
      },
      {
        title: 'مساحة النشاط ونوعه',
        description: 'تحديد مساحة النشاط ونوعه (إيزك) بدقة.',
      },
      {
        title: 'العنوان الوطني ورقم القطعة',
        description: 'تقديم العنوان الوطني ورقم القطعة والمخطط التنظيمي.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1450101499163-c8848c66ca85?ixlib=rb-4.0.3&auto=format&fit=crop&w=2194&q=80',
      alt: 'مستندات السلامة',
    }}
  >
    <Fragment slot="content">نضمن تجهيز جميع المستندات المطلوبة لإصدار شهادة السلامة بسرعة ودقة.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'صلاحية الشهادة سنة كاملة',
        description: 'شهادة السلامة صالحة لمدة عام من تاريخ الإصدار، ويجب تجديدها قبل انتهاء المدة.',
      },
      {
        title: 'تجنب الغرامات المالية',
        description: 'عدم تجديد الشهادة يعرضك لغرامات تصل إلى 30 ألف ريال حسب لوائح الدفاع المدني.',
      },
      {
        title: 'التحقق من صحة الشهادة',
        description: 'يمكن التحقق من صحة الشهادة عبر منصة سلامة أو بلدي باستخدام رقم الشهادة، وستظهر علامة ✅.',
      },
      {
        title: 'تجديد سهل وسريع',
        description: 'نوفر خدمة تجديد شهادة السلامة قبل انتهائها لضمان استمرارية تراخيصك دون انقطاع.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1552664730-d307ca884978?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'فريق سلامة يتابع الإجراءات',
    }}
  >
    <Fragment slot="content">مصمم خصيصاً لدعم نمو واستقرار أعمالك التجارية.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Steps
    title="احصل على شهادة السلامة المعتمدة وافتح منشأتك بأمان."
    items={[
      {
        title: 'الخطوة 1: <span class="font-medium">فحص أدوات السلامة</span>',
        description: 'نتأكد من توفر أدوات الوقاية والحماية من الحريق في منشأتك وفق اشتراطات الدفاع المدني.',
        icon: 'tabler:package',
      },
      {
        title: 'الخطوة 2: <span class="font-medium">تجهيز المستندات</span>',
        description: 'نجهز السجل التجاري، العنوان الوطني، رخصة البناء وغيرها من المتطلبات.',
        icon: 'tabler:letter-case',
      },
      {
        title: 'الخطوة 3: <span class="font-medium">إصدار الشهادة عبر بوابة سلامة</span>',
        description: 'نقوم بإصدار الشهادة رسمياً عبر بوابة سلامة المرتبطة بمنصة بلدي.',
        icon: 'tabler:paint',
      },
      {
        title: 'الخطوة 4: <span class="font-medium">استلام الشهادة</span>',
        description: 'نسلمك الشهادة المعتمدة لتتمكن من استكمال تجديد رخصتك التجارية بكل سهولة.',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1450101499163-c8848c66ca85?ixlib=rb-4.0.3&auto=format&fit=crop&w=987&q=80',
      alt: 'إصدار شهادة السلامة بنجاح',
    }}
  />

  <Features2
    title="المستندات المطلوبة لإصدار شهادة السلامة"
    subtitle="نضمن لك تجهيز كافة المستندات اللازمة لإصدار شهادة تركيب أدوات السلامة بنجاح وبدون أي ملاحظات"
    tagline="المستندات الأساسية"
    items={[
      {
        title: 'السجل التجاري',
        description: 'يجب أن يكون السجل التجاري ساري المفعول ومطابقاً لنشاط المنشأة.',
        icon: 'flat-color-icons:template',
      },
      {
        title: 'رخصة البناء',
        description: 'تقديم رخصة البناء للموقع التجاري.',
        icon: 'flat-color-icons:gallery',
      },
      {
        title: 'مساحة النشاط',
        description: 'تحديد مساحة النشاط بدقة، خاصة إذا كانت أقل من 150 متراً.',
        icon: 'flat-color-icons:approval',
      },
      {
        title: 'نوع النشاط (إيزك)',
        description: 'تحديد رمز النشاط الاقتصادي (إيزك) للمنشأة.',
        icon: 'flat-color-icons:document',
      },
      {
        title: 'العنوان الوطني',
        description: 'توفير العنوان الوطني المسجل للمنشأة.',
        icon: 'flat-color-icons:advertising',
      },
      {
        title: 'رقم القطعة والمخطط',
        description: 'تقديم رقم القطعة ورقم المخطط التنظيمي للموقع.',
        icon: 'flat-color-icons:currency-exchange',
      },
      {
        title: 'رقم الجوال',
        description: 'رقم جوال نشط لاستقبال التحديثات والإشعارات.',
        icon: 'flat-color-icons:voice-presentation',
      },
      {
        title: 'دفع الرسوم المقررة',
        description: 'سداد الرسوم المطلوبة لإصدار الشهادة.',
        icon: 'flat-color-icons:business-contact',
      },
      {
        title: 'عقد صيانة (إن وجد)',
        description: 'توفير عقد صيانة لأنظمة السلامة مع شركة معتمدة.',
        icon: 'flat-color-icons:database',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <BlogLatestPosts
    title="تصفح آخر مستجدات شهادة السلامة في المدونة"
    information={`نشاركك دورياً شروحات مفصلة حول شهادة تركيب أدوات السلامة واشتراطات الدفاع المدني في المملكة.
                  كل مقال جديد نطرحه يمثل خطوة هامة تمكنك من حماية منشأتك وتفادي تأخير التراخيص لتصبح خبيراً في إدارة شؤون السلامة.
                  الالتزام بالسلامة هو استثمارك الذكي. شكراً لثقتكم.
                `}
  />

  <FAQs
    title="الأسئلة الشائعة"
    subtitle="تعمق في الإجابات التالية للحصول على فهم شامل حول شهادة تركيب أدوات السلامة وكيف يمكن لمنصتنا تسريع أعمالك."
    tagline="الأسئلة الشائعة"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'ما هي شهادة تركيب أدوات الوقاية والحماية من الحريق؟',
        description:
          'هي شهادة صادرة عبر بوابة سلامة من شركة معتمدة، تحتوي على بيان بأدوات السلامة من الحريق المتوفرة في المنشأة، وهي شرط أساسي لتجديد الرخص التجارية.',
      },
      {
        title: 'ما مدة صلاحية شهادة السلامة؟',
        description: 'سنة واحدة من تاريخ الإصدار، ويجب تجديدها قبل انتهاء المدة.',
      },
      {
        title: 'ما هي غرامة عدم إصدار أو تجديد الشهادة؟',
        description: 'تصل إلى 30 ألف ريال حسب لوائح الدفاع المدني.',
      },
      {
        title: 'هل شهادة السلامة مطلوبة لكل منشأة؟',
        description: 'نعم، وتشمل المحلات، المصانع، المستودعات، والمباني الإدارية.',
      },
      {
        title: 'كيف أتحقق من صحة الشهادة؟',
        description: 'يتم إدخال الرقم في منصة سلامة أو بلدي والضغط على "تحقق". إذا كان صحيحاً تظهر علامة ✅.',
      },
      {
        title: 'هل تقدمون الخدمة في جميع مدن المملكة؟',
        description: 'نعم، نغطي جميع مدن ومناطق المملكة بدون استثناء.',
      },
    ]}
  />

  <Stats
    stats={[
      { title: 'شهادة سلامة تم إصدارها', amount: '+3K' },
      { title: 'منشأة مخدومة', amount: '+2.5K' },
      { title: 'نسبة القبول', amount: '99%' },
      { title: 'مدينة مخدومة', amount: '25+' },
    ]}
  />

  <CallToAction
    id="contact"
    actions={[
      {
        variant: 'primary',
        text: 'تواصل معنا عبر الواتساب فوراً',
        href: 'https://wa.me/966572140531',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
    ]}
  >
    <Fragment slot="title"> احصل على شهادة السلامة الآن </Fragment>

    <Fragment slot="subtitle">
      لا تدع انتهاء الشهادة يعطل أعمالك التجارية ويعرضك للغرامات. <br class="hidden md:inline" />تواصل معنا الآن وسنتولى
      جميع إجراءات إصدار الشهادة بسرعة واحترافية!
    </Fragment>
  </CallToAction>
</Layout>
