---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'شهادة تركيب أدوات السلامة المعتمدة للدفاع المدني وبلدي | توب سيفتي برو',
  description:
    'إصدار وتوثيق شهادة تركيب أدوات الوقاية والحماية من الحريق المعتمدة عبر بوابة سلامة ومنصة بلدي للمحلات والمنشآت لتجديد الرخص الفورية وتفادي الغرامات.',
  canonical: 'https://topsafetypro.com/شهاده-سلامه/',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'طلب شهادة السلامة فوراً عبر الواتساب',
        href:
          'https://wa.me/966572140531?text=' +
          encodeURIComponent('السلام عليكم، أرغب في طلب إصدار شهادة تركيب أدوات السلامة لمنشأتي'),
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
      { text: 'متطلبات وأدوات السلامة', href: '#features' },
    ]}
    image={{
      src: '~/assets/images/شهاده-تركيب-ادوات-السلامه.webp',
      alt: 'شهادة تركيب أدوات الوقاية والحماية من الحريق المعتمدة عبر بوابة سلامة ومنصة بلدي',
    }}
  >
    <Fragment slot="title">
      شهادة تركيب <span class="hidden xl:inline">أدوات الوقاية والحماية</span>
      <span class="text-accent dark:text-white">معتمدة عبر بوابة سلامة</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">منصة توب سيفتي برو</span> توفر لك إصدار وتوثيق <strong>شهادة تركيب أدوات السلامة</strong> (فاتورة السلامة المعتمدة) الصادرة عبر بوابة سلامة التابعة للمديرية العامة للدفاع المدني، والمربوطة مباشرة مع منصة بلدي لإصدار وتجديد رخصتك التجارية دون تأخير.</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">اعتماد رسمي فوري عبر منصة سلامة وبلدي لجميع المحلات.</span>
      خدمات معتمدة في كافة مدن ومناطق المملكة:
      <a href="/شهادة-سلامة-الرياض" class="text-primary hover:underline font-semibold">الرياض</a>،
      <a href="/شهادة-سلامة-جدة" class="text-primary hover:underline font-semibold">جدة</a>،
      <a href="/شهادة-سلامة-مكة" class="text-primary hover:underline font-semibold">مكة المكرمة</a>،
      <a href="/شهادة-سلامة-الدمام" class="text-primary hover:underline font-semibold">الدمام</a>،
      <a href="/شهادة-سلامة-المدينة" class="text-primary hover:underline font-semibold">المدينة المنورة</a>،
      <a href="/شهادة-سلامة-الخبر" class="text-primary hover:underline font-semibold">الخبر</a>،
      <a href="/شهادة-سلامة-الطائف" class="text-primary hover:underline font-semibold">الطائف</a>،
      <a href="/شهادة-سلامة-القصيم" class="text-primary hover:underline font-semibold">القصيم</a>،
      <a href="/شهادة-سلامة-تبوك" class="text-primary hover:underline font-semibold">تبوك</a>،
      <a href="/شهادة-سلامة-أبها" class="text-primary hover:underline font-semibold">أبها</a>،
      <a href="/شهادة-سلامة-حائل" class="text-primary hover:underline font-semibold">حائل</a>،
      <a href="/شهادة-سلامة-جازان" class="text-primary hover:underline font-semibold">جازان</a>،
      و<a href="/شهادة-سلامة-نجران" class="text-primary hover:underline font-semibold">نجران</a>.
    </Fragment>
  </Hero>

  <Note
    title="اعتماد رسمي وفوري:"
    description="شهادة تركيب أدوات سلامة موثقة برقم كودي رسمي في بوابة سلامة ومقبولة تلقائياً في منصة بلدي لتجديد وإصدار الرخص التجارية"
  />

  <Features
    id="features"
    tagline="اشتراطات الدفاع المدني وبلدي"
    title="ما يميز خدمة شهادة السلامة مع توب سيفتي برو"
    subtitle="نلتزم بأعلى معايير الجودة والسلامة لتجهيز موقعك بأدوات الحماية المعتمدة وإصدار الشهادة الرسمية بأسرع وقت."
    items={[
      {
        title: 'شركات ومكاتب معتمدة في سلامة',
        description:
          'نصدر الشهادة عبر جهات وشركات سلامة مصنفة ومرخصة رسمياً من المديرية العامة للدفاع المدني ومسجلة في بوابة سلامة.',
        icon: 'tabler:certificate',
      },
      {
        title: 'ربط مباشر مع منصة بلدي',
        description:
          'رقم الشهادة يرتبط آلياً بمعاملة <a href="/تجديد-رخصة-البلدية" class="text-primary hover:underline font-medium">تجديد رخصة البلدية</a> عبر منصة بلدي لإتمام التجديد فوراً.',
        icon: 'tabler:link',
      },
      {
        title: 'توريد وتركيب أجهزة معتمدة',
        description:
          'نوفر طفايات الحريق وكواشف الدخان والإنذار المطابقة للمواصفات القياسية السعودية (SASO) وكود البناء السعودي.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'سرعة الإصدار والتوثيق',
        description:
          'إنجاز سريع خلال 24 ساعة لتمكينك من تفادي انتهاء مهلة الرخص أو تسجيل مخالفات بلدية ورقابية.',
        icon: 'tabler:rocket',
      },
      {
        title: 'أسعار مناسبة لجميع الأنشطة',
        description:
          'باقات اقتصادية تناسب المحلات التجارية الصغيرة والأنشطة المتوسطة والمستودعات والمكاتب.',
        icon: 'tabler:tag',
      },
      {
        title: 'تغطية شاملة لمدن المملكة',
        description:
          'نلبي طلبات إصدار وتجديد شهادات السلامة في الرياض، جدة، مكة، المدينة، الشرقية، عسير، والقصيم وكافة المناطق.',
        icon: 'tabler:map-pin',
      },
    ]}
  />

  <Content
    isReversed
    tagline="الربط الحكومي"
    title="ما هي شهادة السلامة وكيف ترتبط بمنصة بلدي؟"
    items={[
      {
        title: 'تعريف شهادة تركيب أدوات السلامة',
        description:
          'هي وثيقة إلكترونية رسمية معتمدة من الدفاع المدني تثبت أن المنشأة تم تزويدها بوسائل وأدوات الوقاية والحماية من الحريق اللازمة لنوع النشاط ومساحته.',
      },
      {
        title: 'شرط أساسي لإصدار وتجديد رخصة بلدي',
        description:
          'تطلب منصة بلدي إدخال رقم شهادة تركيب أدوات السلامة عند تجديد الرخصة أو إصدارها للأنشطة الفورية للمحلات التجارية التي تقل مساحتها عن 150م².',
      },
      {
        title: 'التكامل مع ترخيص الدفاع المدني',
        description:
          'الشهادة تعد خطوة أساسية للحصول على <a href="/تجديد-ترخيص-الدفاع-المدني" class="text-primary hover:underline font-medium">ترخيص الدفاع المدني</a>، وتثبت جاهزية المنشأة للمعاينة والتفتيش الدوري.',
      },
    ]}
    image={{
      src: '~/assets/images/رخصه-الدفاع-المدني.webp',
      alt: 'ترخيص الدفاع المدني وشهادة السلامة المعتمدة للمنشآت التجارية',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">حماية متكاملة وامتثال لكود البناء السعودي (SBC 801)</h3>
      تساعدك شهادة السلامة على حماية الأرواح والممتلكات داخل مقرك التجاري، مع ضمان الامتثال التام لاشتراطات كود البناء السعودي للحماية من الحرائق (SBC 801) واللوائح التنظيمية للمديرية العامة للدفاع المدني عبر بوابة سلامة الرسمية ومنصة بلدي.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isAfterContent
    items={[
      {
        title: 'طفايات الحريق المعتمدة بأنواعها',
        description:
          'توفير طفايات البودرة الجافة (Dry Powder) وثاني أكسيد الكربون (CO2) والرغوة بأوزان مطابقة لمساحة ونشاط المنشأة مع شهادة الفحص والوزن.',
      },
      {
        title: 'كواشف الدخان والحرارة وأجراس الإنذار',
        description:
          'تركيب كواشف الدخان الضوئية المستقلة أو المرتبطة بلوحة إنذار رئيسية لضمان الاستجابة السريعة لأي طارئ.',
      },
      {
        title: 'كشافات طوارئ ولوحات خروج مضيئة',
        description:
          'توفير إضاءة الطوارئ الاحتياطية ولوحات مسار الهروب (Exit) المضيئة التي تعمل ذاتياً عند انقطاع التيار الكهربائي.',
      },
      {
        title: 'صيدلية الإسعافات وبطانية الحريق',
        description:
          'تجهيز حقيبة الإسعافات الأولية الشاملة وبطانيات إخماد الحريق للمطابخ والمطاعم والأنشطة المهنية المتنوعة.',
      },
    ]}
    image={{
      src: '~/assets/images/شهاده-تركيب-ادوات-السلامه.webp',
      alt: 'أدوات الوقاية والحماية من الحريق المعتمدة في شهادة السلامة',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">أدوات السلامة المعتمدة التي تشملها الشهادة</h3>
      نضمن أن جميع الأدوات والمعدات الموردة والمركبة مطابقة للمواصفات ومقبولة رسمياً من مفتشي السلامة بالدفاع المدني.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'صلاحية الشهادة سنة كاملة',
        description:
          'تسري شهادة تركيب أدوات السلامة لمدة سنة هجرية أو ميلادية كاملة، ويتم تجديدها سنوياً للتأكد من استمرار كفاءة المعدات.',
      },
      {
        title: 'تجنب الغرامات والمخالفات الرقابية',
        description:
          'عدم وجود شهادة سلامة سارية يعرّض المنشأة لغرامات مالية وإغلاق فوري من مراقبي الدفاع المدني والبلديات.',
      },
      {
        title: 'التكامل مع عقد صيانة أجهزة السلامة',
        description:
          'للمنشآت المتوسطة والكبيرة، نوفر بالتوازي <a href="/عقد-صيانة-سلامة" class="text-primary hover:underline font-semibold">عقد صيانة سلامة سنوي معتمد</a> لاستيفاء متطلبات التراخيص النظامية.',
      },
      {
        title: 'التحقق الإلكتروني السريع عبر QR Code',
        description:
          'تحتوي الشهادة الصادرة على باركود ورقم كودي للتحقق الفوري من صحتها ومطابقتها من قِبل لجان التفتيش والرقابة.',
      },
    ]}
    image={{
      src: '~/assets/images/عقد-صيانة-سلامة.png',
      alt: 'عقد صيانة دوري لأجهزة ومعدات السلامة من الحريق',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">جاهزية مستمرة لأعمالك</h3>
      نوفر لك منظومة متكاملة تشمل شهادة تركيب الأدوات، عقود الصيانة، والتقارير الهندسية لتبقى منشأتك ملتزمة دائماً.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Steps
    title="خطوات إصدار شهادة تركيب أدوات السلامة عبر توب سيفتي برو"
    items={[
      {
        title: 'الخطوة 1: <span class="font-medium">تزويدنا ببيانات المنشأة</span>',
        description: 'إرسال السجل التجاري، موقع المحل (العنوان الوطني)، ونوع النشاط والمساحة التقريبية عبر الواتساب.',
        icon: 'tabler:clipboard-text',
      },
      {
        title: 'الخطوة 2: <span class="font-medium">تحديد وتجهيز أدوات السلامة</span>',
        description: 'تحديد عدد الطفايات والكواشف المطلوبة لنشاطك، وتوريدها وتركيبها في الموقع وفق الأصول الفنية.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'الخطوة 3: <span class="font-medium">الرفع والتوثيق عبر منصة سلامة</span>',
        description: 'إصدار وتوثيق الشهادة الرسمية عبر بوابة سلامة الإلكترونية برقم معتمد ومختوم إلكترونياً.',
        icon: 'tabler:certificate',
      },
      {
        title: 'الخطوة 4: <span class="font-medium">تسليم رقم الشهادة لتجديد رخصة بلدي</span>',
        description: 'تسليمك ملف الشهادة ورقمها الإلكتروني لإدخاله مباشرة في منصة بلدي وإصدار رخصتك فوراً.',
        icon: 'tabler:circle-check',
      },
    ]}
    image={{
      src: '~/assets/images/شهاده-تركيب-ادوات-السلامه.webp',
      alt: 'خطوات اعتماد وتوثيق شهادة تركيب أدوات السلامة',
    }}
  />

  <Features2
    title="المستندات والمتطلبات لإصدار شهادة السلامة"
    subtitle="متطلبات ميسرة وسريعة نساعدك في تجهيزها بالكامل لضمان إصدار الشهادة دون أي عوائق"
    tagline="المستندات المطلوبة"
    items={[
      {
        title: 'السجل التجاري الساري',
        description: 'صورة من السجل التجاري للمنشأة ساري المفعول مع مطابقة نوع النشاط.',
        icon: 'tabler:file-text',
      },
      {
        title: 'العنوان الوطني للموقع',
        description: 'بيانات العنوان الوطني المختصر أو المسجل للمحل أو المنشأة التجارية.',
        icon: 'tabler:map-pin',
      },
      {
        title: 'مساحة المحل ونوع النشاط (ISIC)',
        description: 'تحديد مساحة الموقع ونوع النشاط التجاري لتحديد عدد أدوات السلامة الإلزامية.',
        icon: 'tabler:ruler-measure',
      },
      {
        title: 'عقد الإيجار أو صك الملكية',
        description: 'عقد إيجار إلكتروني موثق في منصة إيجار أو صك ملكية العقار التجاري.',
        icon: 'tabler:home-check',
      },
      {
        title: 'كاميرات المراقبة الأمنية',
        description: 'للأنشطة الملزمة أمنياً، نوفر أيضاً <a href="/شهاده-استيفاء-كاميرات" class="text-primary hover:underline font-medium">شهادة استيفاء كاميرات المراقبة</a> المعتمدة.',
        icon: 'tabler:video',
      },
      {
        title: 'تقرير فني للمساحات الكبيرة',
        description: 'للأنشطة غير الفورية نوفر إعداد <a href="/تقرير-فني-بلدي" class="text-primary hover:underline font-medium">التقرير الفني البلدي المعتمد</a> لإتمام الترخيص.',
        icon: 'tabler:report-analytics',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <BlogLatestPosts
    title="تصفح آخر مستجدات تراخيص السلامة والبلديات بالمدونة"
    information={`نشاركك دورياً أحدث شروحات واشتراطات منصة بلدي وبوابة سلامة للدفاع المدني بالمملكة، لمساعدتك في إدارة تراخيصك التجارية بسلاسة وتجنب المخالفات الغيابية.
                `}
  />

  <FAQs
    title="الأسئلة الشائعة حول شهادة تركيب أدوات السلامة"
    subtitle="إجابات دقيقة ومفصلة حول إجراءات منصة سلامة ومنصة بلدي لإصدار وتجديد شهادات السلامة"
    tagline="الأسئلة الشائعة"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'ما هي شهادة تركيب أدوات الوقاية والحماية من الحريق؟',
        description:
          'هي شهادة إلكترونية رسمية تصدر عبر بوابة سلامة التابعة للمديرية العامة للدفاع المدني من خلال شركة سلامة معتمدة، تتضمن بياناً تفصيلياً بأجهزة وأدوات السلامة المركبة بالمحل ومدى مطابقتها للاشتراطات الفنية.',
      },
      {
        title: 'متى أحتاج إلى شهادة تركيب أدوات السلامة في منصة بلدي؟',
        description:
          'يُطلب رقم الشهادة كمتطلب إلزامي عند إصدار رخصة جديدة أو تجديد رخصة تجارية عبر منصة بلدي للأنشطة الفورية والمحلات ذات الخطورة المنخفضة أو التي تقل مساحتها عن 150 متراً مربعاً.',
      },
      {
        title: 'ما هي مدة صلاحية شهادة السلامة؟',
        description:
          'تسري الشهادة لمدة عام كامل (سنة واحدة) من تاريخ إصدارها، ويجب تجديدها دورياً بالتزامن مع تجديد رخصة البلدية لتفادي إيقاف الخدمات.',
      },
      {
        title: 'ما الفرق بين شهادة السلامة وترخيص الدفاع المدني؟',
        description:
          'شهادة السلامة تثبت توفير وتجهيز أدوات الإطفاء والإنذار بالمنشأة، وتُعد مسوغاً رئيسياً للحصول على ترخيص سلامة الدفاع المدني أو إتمام رخصة بلدي الفورية.',
      },
      {
        title: 'كم يستغرق إصدار شهادة السلامة من خلال توب سيفتي برو؟',
        description:
          'يتم فحص المتطلبات وإصدار الشهادة المعتمدة ورفعها عبر النظام خلال مدة قياسية تتراوح بين عدة ساعات إلى 24 ساعة من استلام بيانات الموقع.',
      },
      {
