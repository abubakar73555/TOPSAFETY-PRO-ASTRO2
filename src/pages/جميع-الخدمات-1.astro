---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';

const metadata = {
  title: 'جميع خدمات السلامة والتراخيص في جميع المدن | توب سيفتي برو',
  ignoreTitleTemplate: true,
};

// القائمة الكاملة لجميع مسارات الخدمات والمدن
const allSlugs = [
  // كاميرات المراقبة
  'كاميرات-المراقبة-نجران',
  'كاميرات-المراقبة-مكة',
  'كاميرات-المراقبة-حائل',
  'كاميرات-المراقبة-جدة',
  'كاميرات-المراقبة-جازان',
  'كاميرات-المراقبة-تبوك',
  'كاميرات-المراقبة-المدينة',
  'كاميرات-المراقبة-القصيم',
  'كاميرات-المراقبة-الطائف',
  'كاميرات-المراقبة-الرياض',
  'كاميرات-المراقبة-الدمام',
  'كاميرات-المراقبة-الخبر',
  'كاميرات-المراقبة-أبها',

  // عقود صيانة السلامة
  'عقد-صيانة-سلامة',
  'عقد-صيانة-سلامة-نجران',
  'عقد-صيانة-سلامة-مكة',
  'عقد-صيانة-سلامة-حائل',
  'عقد-صيانة-سلامة-جدة',
  'عقد-صيانة-سلامة-جازان',
  'عقد-صيانة-سلامة-تبوك',
  'عقد-صيانة-سلامة-المدينة',
  'عقد-صيانة-سلامة-القصيم',
  'عقد-صيانة-سلامة-الطائف',
  'عقد-صيانة-سلامة-الرياض',
  'عقد-صيانة-سلامة-الدمام',
  'عقد-صيانة-سلامة-الخبر',
  'عقد-صيانة-سلامة-أبها',

  // شهادات السلامة
  'شهاده-سلامه',
  'شهاده-استيفاء-كاميرات',
  'شهادة-سلامة-نجران',
  'شهادة-سلامة-مكة',
  'شهادة-سلامة-حائل',
  'شهادة-سلامة-جدة',
  'شهادة-سلامة-جازان',
  'شهادة-سلامة-تبوك',
  'شهادة-سلامة-المدينة',
  'شهادة-سلامة-القصيم',
  'شهادة-سلامة-الطائف',
  'شهادة-سلامة-الرياض',
  'شهادة-سلامة-الدمام',
  'شهادة-سلامة-الخبر',
  'شهادة-سلامة-أبها',

  // رخص الدفاع المدني
  'رخصة-الدفاع-المدني-نجران',
  'رخصة-الدفاع-المدني-مكة',
  'رخصة-الدفاع-المدني-حائل',
  'رخصة-الدفاع-المدني-جدة',
  'رخصة-الدفاع-المدني-جازان',
  'رخصة-الدفاع-المدني-تبوك',
  'رخصة-الدفاع-المدني-المدينة',
  'رخصة-الدفاع-المدني-القصيم',
  'رخصة-الدفاع-المدني-الطائف',
  'رخصة-الدفاع-المدني-الرياض',
  'رخصة-الدفاع-المدني-الدمام',
  'رخصة-الدفاع-المدني-الخبر',
  'رخصة-الدفاع-المدني-أبها',

  // رخص البلدية
  'رخصة-البلدية-نجران',
  'رخصة-البلدية-مكة',
  'رخصة-البلدية-حائل',
  'رخصة-البلدية-جدة',
  'رخصة-البلدية-جازان',
  'رخصة-البلدية-تبوك',
  'رخصة-البلدية-المدينة',
  'رخصة-البلدية-القصيم',
  'رخصة-البلدية-الطائف',
  'رخصة-البلدية-الرياض',
  'رخصة-البلدية-الدمام',
  'رخصة-البلدية-الخبر',
  'رخصة-البلدية-أبها',

  // تقارير السلامة والبلدية
  'تقرير-ملائمة',
  'تقرير-فني-فوري',
  'تقرير-فني-غير-فوري',
  'تقرير-فني-سلامة',
  'تقرير-فني-سلامة-شامل',
  'تقرير-فني-بلدي',
  'تقرير-سلامة-الدفاع-المدني',
  'تقرير-فني-سلامة-نجران',
  'تقرير-فني-سلامة-مكة',
  'تقرير-فني-سلامة-حائل',
  'تقرير-فني-سلامة-جدة',
  'تقرير-فني-سلامة-جازان',
  'تقرير-فني-سلامة-تبوك',
  'تقرير-فني-سلامة-المدينة',
  'تقرير-فني-سلامة-القصيم',
  'تقرير-فني-سلامة-الطائف',
  'تقرير-فني-سلامة-الرياض',
  'تقرير-فني-سلامة-الدمام',
  'تقرير-فني-سلامة-الخبر',
  'تقرير-فني-سلامة-أبها',
  'عقد-نظافة-جدة',


  // تجديد الرخص
  'تجديد-رخصة-البلدية',
  'تجديد-ترخيص-الدفاع-المدني',
];

// تجميع الخدمات حسب النوع
const cities = [
  'نجران',
  'مكة',
  'حائل',
  'جدة',
  'جازان',
  'تبوك',
  'المدينة',
  'القصيم',
  'الطائف',
  'الرياض',
  'الدمام',
  'الخبر',
  'أبها',
];
const groups: Record<string, string[]> = {};

allSlugs.forEach((slug) => {
  let service = slug;
  for (const city of cities) {
    if (slug.endsWith(`-${city}`)) {
      service = slug.slice(0, slug.lastIndexOf(`-${city}`));
      break;
    }
  }
  // توحيد المسميات المتشابهة
  if (service === 'شهاده-سلامه') service = 'شهادة-سلامة';
  if (service === 'تقرير-فني-سلامة-شامل') service = 'تقرير-فني-سلامة-شامل';
  if (!groups[service]) groups[service] = [];
  groups[service].push(slug);
});

// ترتيب عرض الخدمات
const serviceOrder = [
  'كاميرات-المراقبة',
  'عقد-صيانة-سلامة',
  'شهادة-سلامة',
  'شهاده-استيفاء-كاميرات',
  'رخصة-الدفاع-المدني',
  'رخصة-البلدية',
  'تقرير-فني-فوري',
  'تقرير-فني-غير-فوري',
  'تقرير-فني-سلامة',
  'تقرير-فني-سلامة-شامل',
  'تقرير-فني-بلدي',
  'تقرير-ملائمة',
  'تقرير-سلامة-الدفاع-المدني',
  'تجديد-رخصة-البلدية',
  'تجديد-ترخيص-الدفاع-المدني',
  'عقد-نظافة',
];

// تحويل slug إلى نص مقروء
function humanize(slug: string) {
  return slug.replace(/-/g, ' ');
}
---

<Layout metadata={metadata}>
  <!-- Hero رئيسي للصفحة -->
  <Hero
    tagline="خريطة الموقع"
    actions={[
      {
        variant: 'primary',
        text: 'تواصل معنا',
        href: 'https://wa.me/966572140531',
        icon: 'tabler:phone',
      },
    ]}
  >
    <Fragment slot="title">
      جميع خدمات <span class="text-accent dark:text-white">السلامة والتراخيص</span> في جميع المدن
    </Fragment>
    <Fragment slot="subtitle">
      صفحة تجميعية لجميع خدماتنا في كل مدن المملكة. اختر الخدمة والمدينة للوصول المباشر.
    </Fragment>
  </Hero>

  <!-- عرض الخدمات مجمعة -->
  <div class="max-w-6xl mx-auto px-4 py-12 rtl text-right">
    <div class="space-y-10">
      {
        serviceOrder.map((service) => {
          const links = groups[service];
          if (!links) return null;
          return (
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md p-6">
              <h2 class="text-2xl font-semibold text-primary-600 dark:text-primary-400 mb-4 border-b pb-2">
                {humanize(service)}
              </h2>
              <div class="flex flex-wrap gap-3">
                {links.map((slug) => (
                  <a
                    href={`/${slug}`}
                    class="inline-block bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200 rounded-full px-5 py-2 text-sm hover:bg-primary-500 hover:text-white transition-colors"
                  >
                    {humanize(slug)}
                  </a>
                ))}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</Layout>
